-- One "click" of the catch fight: the same callback the on-screen Click button
-- runs, with a real mouse click on that button as the fallback.
local function clickFight()
    local hud = fishingHUD()
    local fight = hud and hud.Sub and hud.Sub.CatchMinigame
    if not fight then
        return
    end

    local callback = fight.ClickCallback
    if callback and pcall(callback) then
        return
    end

    local button = fight.Button
    if VirtualInputManager and button and button.Visible then
        local position, size = button.AbsolutePosition, button.AbsoluteSize
        local gui = button:FindFirstAncestorOfClass("ScreenGui")
        local inset = (gui and gui.IgnoreGuiInset) and Vector2.new(0, 0) or GuiService:GetGuiInset()
        local x = position.X + size.X / 2 + inset.X
        local y = position.Y + size.Y / 2 + inset.Y
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end
end

-- Built-in auto fishing only starts casting with a rod in hand.
local lastEquipTry = -math.huge
local function ensureRod()
    if os.clock() - lastEquipTry < 2 then
        return
    end
    local character = LocalPlayer.Character
    if not character or character:FindFirstChildOfClass("Tool") then
        return
    end
    lastEquipTry = os.clock()
    pcall(function()
        AutoFishing:EquipRod()
    end)
end

local function statusText()
    if not AutoFishing then
        return "loading..."
    end
    if shopActivity then
        return shopActivity -- purchases only happen between casts
    end
    if trip.status then
        return "trip: " .. trip.status
    end
    if not isAutoOn() then
        local level = playerLevel()
        if level and level < AUTO_UNLOCK_LEVEL then
            return string.format("need Lv%d (you Lv%d)", AUTO_UNLOCK_LEVEL, level)
        end
        return "idle"
    end
    if AutoFishing.FullWarned then
        return "backpack full!"
    end
    if Fishing.Charging then
        return perfectCast and "waiting for green" or "charging cast"
    end
    if Throw.Active then
        if isFightActive() then
            return "catch fight"
        end
        if Throw.ReelRequested then
            local school = Throw.Sub and Throw.Sub.FishSchool
            local hooked = school and school.Fish and bestHookedValue(school.Fish)
            if hooked then
                return string.format("reeling in (%s)", shortMoney(hooked))
            end
            return "reeling in"
        end
        if Throw.Catchable then
            local target = bestFirst and AutoFishing.Target
            local value = target and fishValue(target)
            if value then
                return string.format("catching fish (%s)", shortMoney(value))
            end
            return "catching fish"
        end
        return "casting"
    end
    return "waiting next cast"
end

