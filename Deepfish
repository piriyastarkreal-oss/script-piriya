local function shortMoney(amount)
    for _, unit in ipairs({{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}) do
        if amount >= unit[1] then
            return string.format("$%.1f%s", amount / unit[1], unit[2])
        end
    end
    return "$" .. tostring(math.floor(amount))
end

-- ------------------------------------------
-- Perfect Cast: release inside the green zone
-- ------------------------------------------
local METER_TIMEOUT = 1.5 -- no arrow drawn this long after the charge starts: the meter is hidden, stop waiting
local CAST_TIMEOUT = 6

local arrow = {seq = 0, t = nil, tier = nil} -- last arrow position (0..1) and tier the game drew
local greenZone = {lo = math.huge, hi = -math.huge, samples = 0} -- arrow positions drawn as "Perfect", learned while playing
local castStats = {casts = 0, perfect = 0}
local warnedHiddenMeter = false

-- Sits in front of HookMeter:RenderArrow and only records what the game draws.
-- Each wrapper keeps its own original, so a stale reference can never call nil.
local function makeArrowWatch(render)
    return function(self, t, tier, ...)
        arrow.seq = arrow.seq + 1
        arrow.t = t
        arrow.tier = tier
        return render(self, t, tier, ...)
    end
end

local function removeArrowWatch()
    if hookMeter and originalRenderArrow then
        pcall(rawset, hookMeter, "RenderArrow", originalRenderArrow)
    end
    hookMeter, originalRenderArrow = nil, nil
end

local function installArrowWatch()
    if hookMeter then
        return true
    end
    local meter
    local hud = fishingHUD()
    if hud and type(hud.Sub) == "table" and type(hud.Sub.HookMeter) == "table" then
        meter = hud.Sub.HookMeter
    else
        local ok, found = pcall(function()
            return require(ReplicatedStorage.Shared.UI.HUD.Fishing.HookMeter)
        end)
        meter = ok and type(found) == "table" and found or nil
    end
    local render = meter and rawget(meter, "RenderArrow")
    if type(render) ~= "function" then
        return false
    end
    hookMeter, originalRenderArrow = meter, render
    rawset(meter, "RenderArrow", makeArrowWatch(render))
    return true
end

-- Release in the middle of the green zone. If the arrow is too fast to land in the
-- middle, take any Perfect frame once it has gone through the zone twice.
local function shouldRelease(t, tier, passes)
    if tier ~= "Perfect" then
        return false
    end
    if greenZone.samples >= 3 and greenZone.hi > greenZone.lo then
        local middle = (greenZone.lo + greenZone.hi) / 2
        local half = (greenZone.hi - greenZone.lo) / 2
        if math.abs(t - middle) <= half * 0.7 then
            return true
        end
    end
    return passes >= 2
end

-- HookT = where the arrow was when released; the game's own auto sets it the same way right before StopHook.
local function releaseAt(fishing, t)
    fishing.HookT = t
    fishing:StopHook()
    castStats.casts = castStats.casts + 1
    if fishing.ThrowTier == "Perfect" then
        castStats.perfect = castStats.perfect + 1
    end
end

local function perfectCastBody(self, fishing)
    installArrowWatch()
    self.DrivingThrow = true
    local startSeq = arrow.seq
    fishing:StartHook()
    if not fishing.Charging then
        self.DrivingThrow = false
        return
    end

    local started = os.clock()
    local lastSeq = startSeq
    local inZone, passes = false, 0
    while fishing.Charging and alive do
        RunService.Heartbeat:Wait()
        local elapsed = os.clock() - started
        if arrow.seq ~= lastSeq then
            lastSeq = arrow.seq
            local t, tier = arrow.t, arrow.tier
            if type(t) == "number" then
                if tier == "Perfect" then
                    greenZone.lo = math.min(greenZone.lo, t)
                    greenZone.hi = math.max(greenZone.hi, t)
                    greenZone.samples = greenZone.samples + 1
                    inZone = true
                elseif inZone then
                    inZone = false
                    passes = passes + 1
                end
                if shouldRelease(t, tier, passes) then
                    releaseAt(fishing, t)
                    return
                end
            end
        elseif lastSeq == startSeq and elapsed > METER_TIMEOUT then
            -- Nothing drawn through our watch: maybe the wrong HUD table. Look it up again next cast.
            removeArrowWatch()
            if not warnedHiddenMeter then
                warnedHiddenMeter = true
                warn("[SmartAutoFish] hook meter arrow not seen this cast - released like the game does, will retry")
            end
            break
        end
        if elapsed > CAST_TIMEOUT then
            break
        end
    end

    -- Meter never showed up, the zone was never reached, or the panel was closed: release like the game does.
    if fishing.Charging then
        releaseAt(fishing, math.random())
    end
end

-- Stands in for AutoFishing:DriveCast, which the game's auto loop calls for every cast.
local function perfectDriveCast(self, fishing)
    local ok, err = pcall(perfectCastBody, self, fishing)
    if not ok then
        warn("[SmartAutoFish] Perfect Cast failed, releasing like the game does: " .. tostring(err))
        pcall(function()
            if fishing.Charging then
                fishing.HookT = math.random()
                fishing:StopHook()
            end
        end)
    end
end

local function setPerfectCast(on)
    perfectCast = on
    if not AutoFishing then
        return -- applied once bindGame() finds the controllers
    end
    if originalDriveCast == nil then
        originalDriveCast = rawget(AutoFishing, "DriveCast")
    end
    if originalDriveCast ~= nil then
        rawset(AutoFishing, "DriveCast", on and perfectDriveCast or originalDriveCast)
    end
    if on then
        installArrowWatch()
    end
end

-- ------------------------------------------
-- Best Fish: aim at the most expensive fish
-- ------------------------------------------
local valueCache = setmetatable({}, {__mode = "k"})

-- The price the game prints on the fish's tag (FishTag.PriceFor), cached per fish.
local function fishValue(fish)
    local mutation = fish.pendingMutation or fish.mutation
    local cached = valueCache[fish]
    if cached and cached.mutation == mutation then
        return cached.value
    end
    local ok, value = pcall(function()
        return Throw.Services.Item:GetSellValue(LocalPlayer, {
            Type = "Fish",
            Name = fish.name,
            Data = {Size = fish.size or 1, Mutation = mutation},
        })
    end)
    if not ok or type(value) ~= "number" or value <= 0 then
        value = nil
    end
    valueCache[fish] = {value = value, mutation = mutation}
    return value
end

-- Price of the most expensive fish already on the hook this cast, or nil if none yet.
-- Finds (keys, scrolls, chests) are not fish and have no price.
local function bestHookedValue(fishList)
    local best
    for _, fish in ipairs(fishList) do
        if fish.caught and not fish.special then
            local value = fishValue(fish)
            if value and (best == nil or value > best) then
                best = value
            end
        end
    end
    return best
end

-- Once a fish worth `hooked` is on the hook, only finds (they take no hook slot) and
-- fish worth at least KEEP_RATIO of it are worth the slow pull-up.
local function worthStaying(fish, value, hooked)
    if hooked == nil or fish.special then
        return true
    end
    return value ~= nil and value >= hooked * KEEP_RATIO
end

-- With Quick Reel on, what the hook already holds limits which fish are still targets.
local function quickReelFloor(fishList)
    if quickReel then
        return bestHookedValue(fishList)
    end
    return nil
end

-- The reachable fish worth the most. The game's own rarity/mutation score breaks
-- ties and ranks fish without a price (sell value lookup failed or not for sale).
-- With `hooked` given, fish not worth staying for are left out.
local function mostValuable(autoFishing, fishList, hangY, hooked)
    local best, bestValue, bestScore
    for _, fish in ipairs(fishList) do
        if autoFishing:TargetValid(fish, hangY) then
            local price = fishValue(fish)
            if worthStaying(fish, price, hooked) then
                local value = price or -1
                local score = tonumber(fish.markerScore) or 0
                if not best or value > bestValue or (value == bestValue and score > bestScore) then
                    best, bestValue, bestScore = fish, value, score
                end
            end
        end
    end
    return best, bestValue
end

-- Stands in for AutoFishing:PickTarget, which the game's Steer calls whenever it needs a new target.
local function pickMostValuable(self, fishList, hangY)
    local ok, best = pcall(function()
        return (mostValuable(self, fishList, hangY, quickReelFloor(fishList)))
    end)
    if ok then
        return best
    end
    return originalPickTarget(self, fishList, hangY)
end

local function setBestFirst(on)
    bestFirst = on
    if not AutoFishing then
        return -- applied once bindGame() finds the controllers
    end
    if originalPickTarget == nil then
        originalPickTarget = rawget(AutoFishing, "PickTarget")
    end
    if originalPickTarget ~= nil then
        rawset(AutoFishing, "PickTarget", on and pickMostValuable or originalPickTarget)
    end
end

-- The game only picks a new target once the current one is caught or passed;
-- switch early when a pricier fish is in reach (e.g. one that spawned mid-throw).
local function upgradeTarget()
    if not bestFirst or not isAutoOn() or not AutoFishing.DrivingThrow then
        return
    end
    if not Throw.Active or not Throw.Catchable or Throw.CatchWindowOver or isFightActive() then
        return
    end
    local school = Throw.Sub and Throw.Sub.FishSchool
    local fishList = school and school.Fish
    local hang = Throw.HangPoint
    if not fishList or not hang then
        return
    end
    local hooked = quickReelFloor(fishList)
    local best, bestValue = mostValuable(AutoFishing, fishList, hang.Y, hooked)
    local current = AutoFishing.Target
    if not best or best == current then
        return
    end
    local currentValue = -math.huge
    if current and AutoFishing:TargetValid(current, hang.Y) then
        local price = fishValue(current)
        if worthStaying(current, price, hooked) then
            currentValue = price or -1
        end
    end
    if bestValue > currentValue then
        AutoFishing.Target = best
    end
end

-- ------------------------------------------
-- Quick Reel: reel in once the best fish is on
-- ------------------------------------------
local quickReelLogged = false

-- The game reels in by itself only when the hook is full or nothing is left above
-- it; until then the hook rides the slow pull-up past cheap fish. The server lets a
-- reel happen any time in the catch window (it is the game's own End Run button).
local function quickReelCheck()
    if not quickReel or not isAutoOn() or not AutoFishing.DrivingThrow then
        return
    end
    if not Throw.Active or not Throw.Catchable or type(Throw.PullStart) ~= "number" then
        return
    end
    if Throw.CatchWindowOver or Throw.ReelRequested or Throw.EarlyOutPending or isFightActive() then
        return
    end
    local pullUp = tonumber(Throw.PullUpDuration)
    if pullUp and os.clock() > Throw.PullStart + pullUp - REEL_MARGIN then
        return -- the catch window closes by itself in a moment
    end
    local school = Throw.Sub and Throw.Sub.FishSchool
    local fishList = school and school.Fish
    local hang = Throw.HangPoint
    if not fishList or not hang then
        return
    end
    local hooked = bestHookedValue(fishList)
    if not hooked or mostValuable(AutoFishing, fishList, hang.Y, hooked) then
        return -- nothing on the hook yet, or something worth the pull-up is still in reach
    end
    -- The End Run button when the game shows it (long casts; it reels in faster),
    -- otherwise the reel call the game makes itself when the hook is full.
    local leftHUD = Throw.LeftHUD
    if type(leftHUD) == "table" and leftHUD.EndRunWanted == true then
        Throw:EndRunPressed()
    else
        Throw:RequestReel()
    end
    if not quickReelLogged then
        quickReelLogged = true
        say(string.format("Quick Reel: reeled in early with %s on the hook", shortMoney(hooked)))
    end
end

-- ------------------------------------------
-- The game's own network events
-- ------------------------------------------
-- Events.Client(name) waits forever for a name the game does not have, so check first.
local function gameEvent(name)
    local folder = ReplicatedStorage:FindFirstChild("Events")
    local events = folder and folder:FindFirstChild("RemoteEvents")
    local functions = folder and folder:FindFirstChild("RemoteFunctions")
    local known = (events and events:FindFirstChild(name)) or (functions and functions:FindFirstChild(name))
    if not known then
        error("the game has no event named " .. name, 2)
    end
    return Throw.Events.Client(name)
end

local scriptFiring = false -- true while this script fires an event, so the shop watch can tell its calls from the game's

-- Same call the game's own buttons make: Events.Client(name):Fire(true, ...).
local function fireGame(name, ...)
    local event = gameEvent(name)
    scriptFiring = true
    local ok, err = pcall(event.Fire, event, true, ...)
    scriptFiring = false
    if not ok then
        error(err, 0)
    end
end

-- Same call the game makes for a request that answers back: Events.Client(name):Invoke(5, ...).
local function invokeGame(name, ...)
    local event = gameEvent(name)
    scriptFiring = true
    local ok, result = pcall(event.Invoke, event, 5, ...)
    scriptFiring = false
    if not ok then
        error(result, 0)
    end
    return result
end

-- ------------------------------------------
-- Skip Cutscene: the game's "Rare Catch Cutscene" setting
-- ------------------------------------------
local cutsceneRestore = "All" -- what turning Skip Cutscene off puts back (the game's default)

local function cutsceneSetting()
    local ok, value = pcall(function()
        return AutoFishing.PlayerData:Get().Settings[CUTSCENE_SETTING]
    end)
    if ok and type(value) == "string" then
        return value
    end
    return nil
end

-- Sends the same event the game's Settings menu fires for "Rare Catch Cutscene".
-- The game saves it to your profile; the panel shows it once the game confirms.
local function setCutsceneSkipped(skip)
    local current = cutsceneSetting()
    if current == nil then
        return false
    end
    if current ~= "None" then
        cutsceneRestore = current
    end
    if (current == "None") == skip then
        return true
    end
    fireGame("Settings", CUTSCENE_SETTING, skip and "None" or cutsceneRestore)
    return true
end

-- ------------------------------------------
-- Walking: the character walks like a player does (no teleporting)
-- ------------------------------------------
local walkCancelled = false -- set when Sell Trip is switched off or the panel closes

local function liveWorld()
    local container = workspace:FindFirstChild("World")
    if not container then
        return nil
    end
    for _, world in ipairs(container:GetChildren()) do
        if world:FindFirstChild("Interactable") then
            return world
        end
    end
    return nil
end

-- Workspace.World.<current world>.Interactable.<name>, found the way the game's
-- WorldFolder finds it: the sell NPC, the Upgrades / Rods / Baits shop zones, the Throw area.
local function interactable(name)
    local world = liveWorld()
    local folder = world and world:FindFirstChild("Interactable")
    return folder and folder:FindFirstChild(name)
end

local function characterParts()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if root and humanoid and humanoid.Health > 0 then
        return root, humanoid
    end
    return nil
end

local function positionOf(instance)
    if instance:IsA("BasePart") then
        return instance.Position
    end
    local ok, pivot = pcall(function()
        return instance:GetPivot()
    end)
    if ok and pivot then
        return pivot.Position
    end
    return nil
end

-- Distance along the ground: NPC pivots and zone centres sit at other heights than your feet.
local function flatDistance(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Standing in a zone part (the shop zones open their shop screen when you walk in).
local function insidePart(part, point)
    local offset = part.CFrame:PointToObjectSpace(point)
    local half = part.Size / 2
    return math.abs(offset.X) <= half.X and math.abs(offset.Z) <= half.Z and math.abs(offset.Y) <= half.Y + 5
end

local function stopWalking()
    local root, humanoid = characterParts()
    if root then
        pcall(function()
            humanoid:MoveTo(root.Position)
        end)
    end
end

-- One straight stretch with Humanoid:MoveTo. MoveTo gives up by itself after 8 s,
-- so it is renewed until the point is reached; a jump when bumping into something.
local function walkStraight(root, humanoid, point, deadline, arrived)
    local lastPosition, lastMoved = root.Position, os.clock()
    humanoid:MoveTo(point)
    while alive and not walkCancelled and os.clock() < deadline do
        task.wait(0.1)
        if walkCancelled or not alive or not root.Parent or humanoid.Health <= 0 then
            return false
        end
        if flatDistance(root.Position, point) <= 2.5 or arrived(root.Position) then
            return true
        end
        if (root.Position - lastPosition).Magnitude > 0.4 then
            lastPosition, lastMoved = root.Position, os.clock()
        elseif os.clock() - lastMoved > 1 then
            humanoid.Jump = true
        end
        if os.clock() - lastMoved > 4 then
            return false -- stuck
        end
        humanoid:MoveTo(point)
    end
    return false
end

-- Walks until arrived(position) is true, around obstacles with PathfindingService,
-- straight at the target when no path is found. Gives up after WALK_TIMEOUT.
local function walkTo(target, arrived)
    local deadline = os.clock() + WALK_TIMEOUT
    for _ = 1, 3 do
        local root, humanoid = characterParts()
        if not root or walkCancelled or not alive then
            return false
        end
        if arrived(root.Position) then
            return true
        end
        local waypoints = {{Position = target}}
        local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
        local computed = pcall(function()
            path:ComputeAsync(root.Position, target)
        end)
        if computed and path.Status == Enum.PathStatus.Success then
            waypoints = path:GetWaypoints()
        end
        for _, waypoint in ipairs(waypoints) do
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end
            local reached = walkStraight(root, humanoid, waypoint.Position, deadline, arrived)
            if arrived(root.Position) then
                stopWalking()
                return true
            end
            if not reached then
                break
            end
        end
        if os.clock() >= deadline then
            break
        end
    end
    stopWalking()
    local root = characterParts()
    return root ~= nil and arrived(root.Position)
end

local function within(target, radius)
    return function(position)
        return flatDistance(position, target) <= radius
    end
end

-- ------------------------------------------
-- Auto Upgrade / Auto Bait: spend cash at the shops like their buttons do
-- ------------------------------------------
-- Cash only: the Robux buttons next to them are never touched. Shop purchases are
-- made only while you stand in that shop, through the same events as its buttons,
-- and checked against your data afterwards. The Sell Trip walks you there after
-- selling; walking in yourself works too.
local SHOP_ORDER = {"Rods", "Upgrades", "Baits"} -- names of the shop zones (and of the screens they open)
local SHOP_LABEL = {Rods = "rod shop", Upgrades = "upgrade shop", Baits = "bait shop"}

local shopActivity -- what is being bought right now, for the status line
local pendingEquip -- a rod this script just bought, to equip between casts
local retryAt, retryDelay = {}, {}
local shopWarned = {}
local castValue = {throwId = nil, value = 0, average = nil, samples = 0}

local function playerData()
    local ok, data = pcall(function()
        return AutoFishing.PlayerData:Get()
    end)
    if ok and type(data) == "table" then
        return data
    end
    return nil
end

-- name -> info ({Price, Luck, ...}) for "Rod" or "Bait", as the game's shops list them.
local function itemCollection(category)
    local ok, items = pcall(function()
        local list = Throw.Content.Item[category]
        if type(list.GetCollection) == "function" then
            return list:GetCollection()
        end
        return list.Items
    end)
    if ok and type(items) == "table" then
        return items
    end
    return {}
end

local function canTry(key)
    return os.clock() >= (retryAt[key] or 0)
end

local function markDone(key)
    retryAt[key], retryDelay[key] = nil, nil
end

-- Waits 30 s after the first refusal, doubling up to 5 minutes, and says why once per kind.
local function markRefused(kind, key, text)
    local delay = math.min((retryDelay[key] or 15) * 2, 300)
    retryDelay[key] = delay
    retryAt[key] = os.clock() + delay
    if not shopWarned[kind] then
        shopWarned[kind] = true
        warn("[SmartAutoFish] " .. text)
    end
end

local function waitUntil(check, timeout)
    local deadline = os.clock() + timeout
    while alive do
        local ok, done = pcall(check)
        if ok and done then
            return true
        end
        if os.clock() >= deadline then
            return false
        end
        task.wait(0.2)
    end
    return false
end

-- Fires one purchase-like event and waits for the game to confirm it in your data.
-- action: {doing, done, key, kind, failText, check, event, args}
local function shopAction(action)
    if not canTry(action.key) then
        return false
    end
    shopActivity = action.doing
    local ok, err = pcall(fireGame, action.event, table.unpack(action.args))
    local confirmed = ok and waitUntil(action.check, CONFIRM_TIMEOUT)
    shopActivity = nil
    if confirmed then
        markDone(action.key)
        say(action.done)
    else
        markRefused(action.kind, action.key, action.failText .. (ok and "" or (" (" .. tostring(err) .. ")")))
    end
    return true
end

-- Upgrades: the cheapest next level of Capacity / Strength / Weight / Bounce you can
-- pay for, priced with the same UpgradesConfig calls as the game's upgrade screen.
local function upgradePick(data, cash)
    local config = Throw.Config.UpgradesConfig
    local world = config.KeyForData(data)
    local pick
    for _, name in ipairs(config.Order or {"Capacity", "Strength", "Weight", "Bounce"}) do
        local level = config.LevelOf(data, name, world)
        if level < config.MaxLevelFor(name, world) then
            local price = config.GetPrice(name, level, world)
            if type(price) == "number" and price <= cash and canTry("upgrade:" .. name)
                and (pick == nil or price < pick.price) then
                pick = {name = name, level = level, price = price, world = world}
            end
        end
    end
    return pick
end

local function buyUpgrade(data, cash)
    local pick = upgradePick(data, cash)
    if not pick then
        return false
    end
    local config = Throw.Config.UpgradesConfig
    return shopAction({
        doing = string.format("buying %s (%s)", pick.name, shortMoney(pick.price)),
        done = string.format("Auto Upgrade: bought %s for %s", pick.name, shortMoney(pick.price)),
        key = "upgrade:" .. pick.name,
        kind = "upgrade",
        failText = string.format("Auto Upgrade: the upgrade shop did not sell %s (%s); it tries again later.", pick.name, shortMoney(pick.price)),
        check = function()
            return config.LevelOf(playerData(), pick.name, pick.world) > pick.level
        end,
        event = "Upgrades",
        args = {"Buy", pick.name},
    })
end

-- Rods for one place only (the maze / cave rods) are never bought.
local function usableRod(info)
    return type(info) == "table" and not info.MazeOnly and not info.CaveOnly
end

-- Rods: the luckiest rod you can pay for that beats every rod you own and is not
-- locked behind a world (the game's own Rod:LockedBehind check).
local function rodPick(data, cash)
    local rods = itemCollection("Rod")
    local owned = data.Rods or {}
    local ownedLuck = -1
    for name in pairs(owned) do
        if usableRod(rods[name]) then
            ownedLuck = math.max(ownedLuck, tonumber(rods[name].Luck) or 0)
        end
    end
    local pick
    for name, info in pairs(rods) do
        local price, luck = tonumber(info.Price) or 0, tonumber(info.Luck) or 0
        if usableRod(info) and not owned[name] and price > 0 and price <= cash and luck > ownedLuck
            and canTry("rod:" .. name) and (pick == nil or luck > pick.luck) then
            local ok, lockedBehind = pcall(function()
                return Throw.Content.Item.Rod:LockedBehind(info, data)
            end)
            if ok and lockedBehind == nil then
                pick = {name = name, price = price, luck = luck}
            end
        end
    end
    return pick
end

-- Puts a rod this script bought in your hand: the inventory's Equip call.
local function equipBoughtRod(data)
    local name = pendingEquip
    if not name then
        return false
    end
    if data.RodEquipped == name or not (data.Rods or {})[name] then
        pendingEquip = nil
        return false
    end
    return shopAction({
        doing = "equipping the " .. name,
        done = "Auto Upgrade: equipped the " .. name,
        key = "equip",
        kind = "equip",
        failText = "Auto Upgrade: the game did not equip the " .. name .. " - equip it from your inventory.",
        check = function()
            return playerData().RodEquipped == name
        end,
        event = "RodShop",
        args = {"Equip", name},
    })
end

local function buyRod(data, cash)
    local pick = rodPick(data, cash)
    if not pick then
        return false
    end
    local bought = false
    shopAction({
        doing = string.format("buying the %s (%s)", pick.name, shortMoney(pick.price)),
        done = string.format("Auto Upgrade: bought the %s for %s", pick.name, shortMoney(pick.price)),
        key = "rod:" .. pick.name,
        kind = "rod",
        failText = string.format("Auto Upgrade: the rod shop did not sell the %s (%s). Buy any rod there by hand once and send the console line that starts with \"rod shop sent:\".", pick.name, shortMoney(pick.price)),
        check = function()
            bought = (playerData().Rods or {})[pick.name] ~= nil
            return bought
        end,
        event = "RodShop",
        args = {"Buy", pick.name},
    })
    if bought then
        pendingEquip = pick.name
        equipBoughtRod(playerData() or data)
    end
    return true
end

local function activeBaitCharges(data)
    local total = 0
    for _, charges in pairs(data.ActiveBaits or {}) do
        if type(charges) == "number" and charges > 0 then
            total = total + charges
        end
    end
    return total
end

local function baitAmount(item)
    return (type(item.Data) == "table" and tonumber(item.Data.Amount)) or 1
end

-- Baits in your bag, all kinds (name = nil) or one kind.
local function ownedBaits(data, name)
    local total = 0
    for _, item in pairs(data.Inventory or {}) do
        if type(item) == "table" and item.Type == "Bait" and (name == nil or item.Name == name) then
            total = total + baitAmount(item)
        end
    end
    return total
end

-- Baits: when none is active, use the luckiest one you own (the inventory's Use button).
local function useBait(data, baits)
    local pick
    for guid, item in pairs(data.Inventory or {}) do
        if type(item) == "table" and item.Type == "Bait" and baitAmount(item) > 0 then
            local luck = tonumber((baits[item.Name] or {}).Luck) or 0
            if pick == nil or luck > pick.luck then
                pick = {guid = guid, name = item.Name, luck = luck}
            end
        end
    end
    if not pick then
        return false
    end
    return shopAction({
        doing = "using a " .. pick.name,
        done = "Auto Bait: using a " .. pick.name,
        key = "use bait",
        kind = "use bait",
        failText = "Auto Bait: the game did not use the " .. pick.name .. ".",
        check = function()
            return activeBaitCharges(playerData()) > 0
        end,
        event = "ConsumeBait",
        args = {pick.guid, 1},
    })
end

-- On a Sell Trip, bait gets at most BAIT_SHARE of what the trip just sold, so the
-- rest can pile up across trips for the next rod or upgrade.
local baitAllowance

-- What one bait may cost: BAIT_SHARE of what its BAIT_CHARGES casts are expected to
-- catch, from the fish values of your recent casts. Unknown before 3 casts: no buying.
local function baitPick(cash)
    if castValue.samples < 3 or not castValue.average then
        return nil
    end
    local budget = math.min(cash, castValue.average * BAIT_CHARGES * BAIT_SHARE, baitAllowance or math.huge)
    local pick
    for name, info in pairs(itemCollection("Bait")) do
        local price, luck = tonumber(info.Price) or 0, tonumber(info.Luck) or 0
        if price > 0 and price <= budget and canTry("bait:" .. name) and (pick == nil or luck > pick.luck) then
            pick = {name = name, price = price, luck = luck}
        end
    end
    return pick
end

local function buyBait(data, cash)
    local pick = baitPick(cash)
    if not pick then
        return false
    end
    local before = ownedBaits(data, pick.name)
    local bought = false
    shopAction({
        doing = string.format("buying a %s (%s)", pick.name, shortMoney(pick.price)),
        done = string.format("Auto Bait: bought a %s for %s", pick.name, shortMoney(pick.price)),
        key = "bait:" .. pick.name,
        kind = "bait",
        failText = string.format("Auto Bait: the bait shop did not sell the %s (%s). Buy any bait there by hand once and send the console line that starts with \"bait shop sent:\".", pick.name, shortMoney(pick.price)),
        check = function()
            bought = ownedBaits(playerData(), pick.name) > before
            return bought
        end,
        event = "BaitShop",
        args = {"Buy", pick.name, 1},
    })
    if bought and baitAllowance then
        baitAllowance = baitAllowance - pick.price
    end
    return true
end

-- Is there something to buy in this shop right now?
local function shopWanted(shop, data)
    local cash = tonumber(data.Cash) or 0
    if shop == "Rods" then
        return autoUpgrade and rodPick(data, cash) ~= nil
    elseif shop == "Upgrades" then
        return autoUpgrade and upgradePick(data, cash) ~= nil
    elseif shop == "Baits" then
        return autoBait and ownedBaits(data) < BAITS_PER_TRIP and baitPick(cash) ~= nil
    end
    return false
end

-- Buys up to `limit` things in the shop you stand in, best first, until nothing fits.
local function shopHere(shop, limit)
    for _ = 1, limit do
        local data = playerData()
        if not data or not alive or not shopWanted(shop, data) then
            return
        end
        local cash = tonumber(data.Cash) or 0
        if shop == "Rods" then
            buyRod(data, cash)
        elseif shop == "Upgrades" then
            buyUpgrade(data, cash)
        else
            buyBait(data, cash)
        end
    end
end

-- The shop zone you are standing in, if any.
local function currentShop()
    local root = characterParts()
    if not root then
        return nil
    end
    for _, shop in ipairs(SHOP_ORDER) do
        local zone = interactable(shop)
        if zone and zone:IsA("BasePart") and insidePart(zone, root.Position) then
            return shop
        end
    end
    return nil
end

-- Value of the fish on the hook, kept per cast so Auto Bait knows what a cast is worth.
local function hookedTotal(fishList)
    local total = 0
    for _, fish in ipairs(fishList) do
        if fish.caught and not fish.special then
            total = total + (fishValue(fish) or 0)
        end
    end
    return total
end

local function commitCastValue()
    if castValue.throwId == nil then
        return
    end
    castValue.samples = castValue.samples + 1
    castValue.average = castValue.average and (castValue.average * 0.8 + castValue.value * 0.2) or castValue.value
    castValue.throwId = nil
end

local function trackCastValue()
    if Throw.Active and Throw.ThrowId ~= nil then
        if castValue.throwId ~= Throw.ThrowId then
            commitCastValue()
            castValue.throwId, castValue.value = Throw.ThrowId, 0
        end
        local school = Throw.Sub and Throw.Sub.FishSchool
        if school and school.Fish then
            castValue.value = math.max(castValue.value, hookedTotal(school.Fish))
        end
    elseif castValue.throwId ~= nil then
        commitCastValue()
    end
end

-- Prints what the game's own rod / bait shop buttons send, so a shop that wants a
-- different call than the one above can be fixed from one console line.
local shopWatches = {}

local function describeArgs(...)
    local parts = {}
    for i = 1, select("#", ...) do
        local value = select(i, ...)
        parts[i] = type(value) == "string" and string.format("%q", value) or tostring(value)
    end
    return table.concat(parts, ", ")
end

local function watchShopEvent(name, label)
    local ok, event = pcall(gameEvent, name)
    if not ok or type(event) ~= "table" or type(event.Fire) ~= "function" then
        return
    end
    local fire, own = event.Fire, rawget(event, "Fire")
    local watched = pcall(rawset, event, "Fire", function(self, reliable, ...)
        if not scriptFiring and (...) ~= "Equip" then
            pcall(say, label .. " sent: " .. describeArgs(...))
        end
        return fire(self, reliable, ...)
    end)
    if watched then
        shopWatches[#shopWatches + 1] = {event = event, own = own}
    end
end

local function unwatchShopEvents()
    for _, watch in ipairs(shopWatches) do
        pcall(rawset, watch.event, "Fire", watch.own)
    end
    shopWatches = {}
end

-- ------------------------------------------
-- Sell Trip: sell at the NPC, shop, walk back, fish on
-- ------------------------------------------
-- The game sells automatic selling as its "Auto Sell" gamepass; this does what you
-- would do by hand instead: walk to the sell NPC and use its "Sell All Fish" (the
-- same SellAll call its dialog makes, from where its Talk prompt reaches). Fishing
-- stops for the walk, which is what the gamepass saves you.
local trip = {active = false, status = nil, retryAt = 0}

-- Fish the NPC's "Sell All Fish" counts: unlocked fish that have a sell price.
-- nil when the game's Lock / Fish lookups are not available.
local function sellableFish(data)
    local ok, count = pcall(function()
        local lock, fishInfo = Throw.Modules.Lock, Throw.Content.Item.Fish
        local total = 0
        for _, item in pairs(data.Inventory or {}) do
            if type(item) == "table" and item.Type == "Fish" and not lock.IsLocked(item) then
                local info = fishInfo:Get(item.Name, true)
                if info and info.SellPrice then
                    total = total + 1
                end
            end
        end
        return total
    end)
    return ok and count or nil
end

local function inThrowArea()
    local ok, inside = pcall(function()
        return Fishing:InArea()
    end)
    return ok and inside == true
end

-- A spot in the current world's Throw area: the saved one if it is in it, else the nearest part.
local function throwSpot(saved)
    local area = interactable("Throw")
    if not area then
        return nil
    end
    local parts = area:IsA("BasePart") and {area} or area:GetChildren()
    if saved then
        for _, part in ipairs(parts) do
            if part:IsA("BasePart") and insidePart(part, saved) then
                return saved
            end
        end
    end
    local root = characterParts()
    local best, bestDistance
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            local distance = root and flatDistance(root.Position, part.Position) or 0
            if best == nil or distance < bestDistance then
                best, bestDistance = part.Position, distance
            end
        end
    end
    return best
end

-- Screens the walk may have opened (shop zones, the Teleport zone). An open screen
-- keeps the game's auto fishing from casting (Fishing:UIOwnsScreen).
local function closeShopScreens()
    for _, name in ipairs({"Rods", "Upgrades", "Baits", "Teleport"}) do
        pcall(function()
            local screen = Throw.UI:Get(name)
            if screen and screen:IsOpened() then
                screen:Close()
            end
        end)
    end
end

local function setAutoFishing(on)
    if isAutoOn() ~= on then
        pcall(function()
            AutoFishing:Toggle()
        end)
    end
end

-- Walks back into the Throw area and turns the game's auto fishing on again.
local function backToWater(spot)
    trip.status = "walking back to the water"
    local target = throwSpot(spot)
    if not target then
        warn("[SmartAutoFish] Sell Trip: no fishing spot found in this world - auto fishing stays off")
        return false
    end
    walkTo(target, within(target, 3))
    if not inThrowArea() then
        warn("[SmartAutoFish] Sell Trip: could not walk back to the water - auto fishing stays off")
        return false
    end
    setAutoFishing(true)
    say("Sell Trip: back at the water, auto fishing on")
    return true
end

local function tripDue(data)
    if not sellTrip or trip.active or os.clock() < trip.retryAt or not isAutoOn() then
        return nil
    end
    if Throw.Active or Fishing.Charging or not inThrowArea() then
        return nil
    end
    local sellable = sellableFish(data)
    if sellable and sellable > 0 and (sellable >= SELL_AT or AutoFishing.FullWarned) then
        return sellable
    end
    return nil
end

local function runTrip(sellable)
    trip.active = true
    walkCancelled = false
    local root = characterParts()
    local spot = root and root.Position
    say(string.format("Sell Trip: %d fish to sell - walking to the sell NPC", sellable))
    setAutoFishing(false) -- the game would turn it off anyway once you leave the water
    trip.status = "finishing the cast"
    waitUntil(function()
        return not Fishing.Charging and not Throw.Active
    end, 40)

    local ok, err = pcall(function()
        local npc = interactable("NPC_Sell")
        local npcPosition = npc and positionOf(npc)
        if not npcPosition then
            error("no sell NPC in this world", 0)
        end
        trip.status = "walking to the sell NPC"
        if not walkTo(npcPosition, within(npcPosition, SELL_RANGE)) then
            error("could not walk to the sell NPC", 0)
        end
        trip.status = "selling"
        local result = invokeGame("SellAll", "Fish", nil)
        local amount = type(result) == "table" and tonumber(result.Amount) or 0
        if amount <= 0 then
            error("the sell NPC sold nothing", 0)
        end
        local value = tonumber(result.Value) or 0
        say(string.format("Sell Trip: sold %d fish for %s", amount, shortMoney(value)))
        baitAllowance = value * BAIT_SHARE

        for _, shop in ipairs(SHOP_ORDER) do
            local data = playerData()
            if walkCancelled or not alive or not data then
                break
            end
            local zone = interactable(shop)
            if zone and zone:IsA("BasePart") and shopWanted(shop, data) then
                trip.status = "walking to the " .. SHOP_LABEL[shop]
                if walkTo(zone.Position, function(position)
                    return insidePart(zone, position)
                end) then
                    shopHere(shop, 30)
                else
                    warn("[SmartAutoFish] Sell Trip: could not walk into the " .. SHOP_LABEL[shop])
                end
            end
        end
        closeShopScreens()
    end)
    baitAllowance = nil
    if walkCancelled then
        say("Sell Trip: stopped where you are - auto fishing stays off, you have control")
    elseif not ok then
        warn("[SmartAutoFish] Sell Trip: " .. tostring(err) .. " - trying again in 10 minutes")
        trip.retryAt = os.clock() + 600
    end

    if alive and not walkCancelled then
        closeShopScreens()
        backToWater(spot)
    end
    trip.active, trip.status = false, nil
end

-- The game moves you to a server after 15 minutes without input and passes where you
-- were (IdleRejoin). With this script in Volt's autoexec it runs again there: walk
-- back to the water and fish on.
local function resumeAfterRejoin()
    local ok, teleportData = pcall(function()
        return TeleportService:GetLocalPlayerTeleportData()
    end)
    if not ok or type(teleportData) ~= "table" or not teleportData.IdleRejoin or not sellTrip then
        return
    end
    say("back after the game's idle reconnect - returning to the water")
    waitUntil(function()
        return characterParts() ~= nil
    end, 30)
    task.wait(6) -- the game turns auto fishing back on 5 s after joining
    if inThrowArea() then
        setAutoFishing(true)
        return
    end
    local resume = type(teleportData.Resume) == "table" and teleportData.Resume or {}
    local saved = type(resume.Position) == "table" and #resume.Position == 3
        and Vector3.new(resume.Position[1], resume.Position[2], resume.Position[3]) or nil
    trip.active = true
    walkCancelled = false
    backToWater(saved)
    trip.active, trip.status = false, nil
end

-- Between casts: equip a rod just bought, keep a bait active, and buy in a shop you walked into.
local function shopTick()
    if trip.active or Throw.Active or Fishing.Charging then
        return
    end
    local data = playerData()
    if not data then
        return
    end
    if autoUpgrade and equipBoughtRod(data) then
        return
    end
    if autoBait and activeBaitCharges(data) <= 0 and useBait(data, itemCollection("Bait")) then
        return
    end
    local shop = currentShop()
    if shop then
        shopHere(shop, 1)
    end
end

