                local life = math.random(12, 22) / 10
                tween(spark, life, {
                    Position = spark.Position + UDim2.fromOffset(math.random(-14, 14), -math.random(25, 55)),
                    BackgroundTransparency = 1,
                }, Enum.EasingStyle.Sine)
                task.delay(life, function()
                    spark:Destroy()
                end)
            end
        end

        -- Every few seconds the title ghosts jitter for a few frames.
        if glitchLeft > 0 then
            if now >= glitchAt then
                glitchLeft = glitchLeft - 1
                glitchAt = now + 0.05
                if glitchLeft > 0 then
                    TitleGhostA.Position = GHOST_A_POS + UDim2.fromOffset(math.random(-4, 4), math.random(-2, 2))
                    TitleGhostB.Position = GHOST_B_POS + UDim2.fromOffset(math.random(-4, 4), math.random(-2, 2))
                else
                    TitleGhostA.Position = GHOST_A_POS
                    TitleGhostB.Position = GHOST_B_POS
                    glitchNext = now + math.random(25, 50) / 10
                end
            end
        elseif now >= glitchNext then
            glitchLeft, glitchAt = 5, now
        end
    end))

    -- ---------- loops ----------
    spawnGuarded("startup", function()
        local ok, err = bindGame()
        if not ok then
            warn("[SmartAutoFish] " .. tostring(err))
            notify(tostring(err))
            setStatus(tostring(err), Theme.Crimson)
            fishCard.set("โหลดระบบเกมไม่สำเร็จ", tostring(err), "ERROR", Theme.Crimson)
            return
        end
        pcall(setPerfectCast, perfectCast)
        pcall(setBestFirst, bestFirst)
        local cutsceneBefore = cutsceneSetting()
        say(string.format("hooked into the game's fishing controllers | level=%s | auto fishing=%s | hook meter=%s | rare cutscene=%s",
            tostring(playerLevel()), isAutoOn() and "ON" or "OFF", hookMeter and "found" or "not yet", tostring(cutsceneBefore)))
        local okCutscene, cutsceneErr = pcall(setCutsceneSkipped, true)
        if not okCutscene then
            warn("[SmartAutoFish] could not turn off the Rare Catch Cutscene: " .. tostring(cutsceneErr))
        elseif cutsceneBefore and cutsceneBefore ~= "None" then
            say("Skip Cutscene: changed the game's Rare Catch Cutscene setting from " .. cutsceneBefore .. " to None")
        end
        watchShopEvent("RodShop", "rod shop")
        watchShopEvent("BaitShop", "bait shop")
        local data = playerData()
        say(string.format("Auto Upgrade=%s | Auto Bait=%s | Sell Trip=%s | cash=%s | rod=%s | fish to sell=%s",
            autoUpgrade and "ON" or "OFF", autoBait and "ON" or "OFF", sellTrip and "ON" or "OFF",
            shortMoney(tonumber(data and data.Cash) or 0), tostring(data and data.RodEquipped),
            tostring(data and sellableFish(data))))
        if not interactable("NPC_Sell") then
            warn("[SmartAutoFish] Sell Trip: no sell NPC found in this world - trips cannot run here")
        end
        local ticks = 0
        while alive do
            pcall(function()
                if isAutoOn() then
                    ensureRod()
                end
                refreshUI()
                -- The money card counts the whole bag, so once a second is plenty.
                if ticks % 4 == 0 then
                    refreshShopCard()
                end
            end)
            ticks = ticks + 1
            task.wait(0.25)
        end
    end)

    spawnGuarded("target loop", function()
        local quickReelWarned = false
        while alive do
            if AutoFishing then
                pcall(upgradeTarget)
                pcall(trackCastValue)
                local ok, err = pcall(quickReelCheck)
                if not ok and not quickReelWarned then
                    quickReelWarned = true
                    warn("[SmartAutoFish] Quick Reel failed, the game reels in by itself instead: " .. tostring(err))
                end
            end
            task.wait(0.1)
        end
    end)

    spawnGuarded("shop loop", function()
        local shopErrorWarned = false
        while alive do
            if AutoFishing then
                local ok, err = pcall(shopTick)
                if not ok then
                    shopActivity = nil
                    if not shopErrorWarned then
                        shopErrorWarned = true
                        warn("[SmartAutoFish] Auto Upgrade / Auto Bait failed: " .. tostring(err))
                    end
                end
            end
            task.wait(SHOP_INTERVAL)
        end
    end)

    spawnGuarded("trip loop", function()
        while alive and not AutoFishing do
            task.wait(0.5)
        end
        if alive then
            resumeAfterRejoin()
        end
        while alive do
            local data = playerData()
            local sellable = data and tripDue(data)
            if sellable then
                runTrip(sellable)
            end
            task.wait(2)
        end
    end)

    spawnGuarded("fight loop", function()
        while alive do
            if fightEnabled and isAutoOn() and isFightActive() then
                clickFight()
                task.wait((1 / clicksPerSecond) * (0.85 + math.random() * 0.3))
            else
                task.wait(0.1)
            end
        end
    end)

    -- Intro: the window springs open and the title types itself in.
    task.spawn(function()
        local layers = {TitleMain, TitleGhostA, TitleGhostB}
        for _, label in ipairs(layers) do
            label.MaxVisibleGraphemes = 0
        end
        MainFrame.Visible = true
        WindowScale.Scale = baseScale * 0.5
        tween(WindowScale, 0.7, {Scale = baseScale}, Enum.EasingStyle.Back)
        task.wait(0.3)
        for i = 1, #HUB_TITLE do
            for _, label in ipairs(layers) do
                label.MaxVisibleGraphemes = i
            end
            task.wait(0.05)
        end
        for _, label in ipairs(layers) do
            label.MaxVisibleGraphemes = -1
        end
        if alive then
            toast(HUB_TITLE .. " พร้อมลุย!", "ยินดีต้อนรับ " .. LocalPlayer.DisplayName, Theme.Crimson, HUB_TITLE:sub(1, 1), 3.5)
        end
    end)

    say("panel ready")
end

local ok, err = xpcall(main, function(e)
    return traceback(tostring(e), 2)
end)
if not ok then
    reportError("startup", err)
end
