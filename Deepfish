-- ------------------------------------------
-- Hooking into the game's controllers
-- ------------------------------------------
local function bindGame()
    local scripts = LocalPlayer:WaitForChild("PlayerScripts", 15)
    local client = scripts and scripts:WaitForChild("Client", 15)
    local controllers = client and client:WaitForChild("Controllers", 15)
    if not controllers then
        return false, "PlayerScripts.Client.Controllers not found"
    end

    local fishingModule = controllers:WaitForChild("Fishing", 15)
    local throwModule = controllers:WaitForChild("ThrowCinematic", 15)
    if not (fishingModule and throwModule) then
        return false, "Fishing / ThrowCinematic controller not found"
    end

    local okF, fishing = pcall(require, fishingModule)
    if not okF then
        return false, "require(Fishing) failed: " .. tostring(fishing)
    end
    local okT, throw = pcall(require, throwModule)
    if not okT then
        return false, "require(ThrowCinematic) failed: " .. tostring(throw)
    end
    if type(fishing) ~= "table" or type(throw) ~= "table" then
        return false, "controllers did not return tables"
    end

    -- The game attaches AutoFishing / Sub once its controllers finish booting
    -- (slower right after a rejoin). AutoFishing.Controllers only resolves on the
    -- live module, so it also tells us require() gave us the game's table and not a fresh copy.
    local deadline = os.clock() + 60
    local auto
    while alive and os.clock() < deadline do
        local ok, found = pcall(function()
            local candidate = rawget(fishing, "AutoFishing")
            if candidate and rawget(throw, "Sub") and candidate.Controllers ~= nil then
                return candidate
            end
            return nil
        end)
        if ok and found then
            auto = found
            break
        end
        task.wait(0.25)
    end
    if not auto then
        return false, "AutoFishing controller never became ready"
    end

    Fishing, AutoFishing, Throw = fishing, auto, throw
    return true
end

local function isAutoOn()
    return AutoFishing ~= nil and AutoFishing.On == true
end

