-- รายได้ต่อนาที เฉลี่ยจาก 5 นาทีล่าสุด
local function ratePerMinute(): number
	local samples = session.samples
	if #samples < 2 then
		local elapsed = os.clock() - session.start
		return if elapsed > 5 then session.earned / elapsed * 60 else 0
	end
	local first = samples[1]
	local elapsed = os.clock() - first[1]
	return if elapsed > 0 then (session.earned - first[2]) / elapsed * 60 else 0
end

-- รายได้ช่วงละ 10 วิ ล่าสุด count ช่วง (0..1 เทียบช่วงที่ได้มากสุด) ไว้วาดกราฟแท่ง
local function sparkValues(count: number): { number }
	local samples = session.samples
	local deltas = {}
	for index = 2, #samples do
		deltas[index - 1] = math.max(0, samples[index][2] - samples[index - 1][2])
	end
	local peak = 0
	for _, delta in deltas do
		peak = math.max(peak, delta)
	end
	local values = {}
	for slot = 1, count do
		local delta = deltas[#deltas - count + slot] or 0
		values[slot] = if peak > 0 then delta / peak else 0
	end
	return values
end

