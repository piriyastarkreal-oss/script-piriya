			for _, entry in {
				{ "FARM", config.autoStock },
				{ "UPGRADE", config.autoUpgrade },
				{ "ROLL", config.autoRoll or config.autoIndex },
				{ "GRADE", config.autoGrade },
				{ "PETS", config.autoHatch },
				{ "REWARDS", config.daily or config.quests },
				{ "WATCHDOG", config.watchdog },
				{ "DISCORD", httpRequest ~= nil and validWebhook(config.webhookUrl) },
			} do
				local on = entry[2] and not paused
				table.insert(chips, string.format("<font color=\"%s\">●</font> <font color=\"%s\">%s</font>", colorHex(if on then Theme.good else Theme.off), colorHex(if on then Theme.text else Theme.dim), entry[1]))
			end
			afkSystems.Text = table.concat(chips, "    ")
			afkActivity.Text = activityLabel.Text
			local lines = {}
			for _, item in recentEvents do
				table.insert(
					lines,
					string.format(
						"<font face=\"RobotoMono\" color=\"%s\">%s</font>   <font color=\"%s\">%s</font>   %s",
