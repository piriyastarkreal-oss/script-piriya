	-- Spectate: แถบควบคุมด้านล่างจอ
	section(miscPage, "Spectate", "ดูผู้เล่นคนอื่น: < > หรือ Q / E สลับคน · TP หรือ T วาปไปหา · X กลับมาที่ตัวเอง")
	local specPanel = new("Frame", {
		Name = "SpectatePanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(476, 64),
		Position = UDim2.new(0.5, 0, 1, -20),
		BackgroundColor3 = Theme.bg,
		Visible = false,
		Parent = gui,
	}, { corner(14), stroke(Theme.accent, 2) })
	local prevButton = button({ Text = "<", TextSize = 20, Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = Theme.accent, TextColor3 = Theme.bg, Parent = specPanel })
	local tpButton = button({ Text = "TP", TextSize = 18, Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -168, 0, 8), BackgroundColor3 = Theme.info, Parent = specPanel })
	local nextButton = button({ Text = ">", TextSize = 20, Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -112, 0, 8), BackgroundColor3 = Theme.accent, TextColor3 = Theme.bg, Parent = specPanel })
	local specClose = button({ Text = "X", TextSize = 18, Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -56, 0, 8), BackgroundColor3 = Theme.bad, Parent = specPanel })
	local avatar = new("ImageLabel", { Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(64, 8), BackgroundColor3 = Theme.panel2, Parent = specPanel }, { corner(24) })
	local specName = text({ Font = FONT_BOLD, TextSize = 17, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -296, 0, 26), Position = UDim2.fromOffset(120, 8), Parent = specPanel })
	local specSub = text({ TextSize = 13, TextColor3 = Theme.sub, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -296, 0, 20), Position = UDim2.fromOffset(120, 34), Parent = specPanel })

	local spectating = false
	local specTarget: Player? = nil
	local specCharConn: RBXScriptConnection? = nil

	local function specTargets(): { Player }
		local list = {}
		for _, player in Players:GetPlayers() do
			if player ~= localPlayer then
				table.insert(list, player)
			end
		end
		table.sort(list, function(a, b)
			return a.Name:lower() < b.Name:lower()
		end)
		return list
	end

	local function applySpecCamera()
		local camera = workspace.CurrentCamera
		local humanoid = getHumanoid(if spectating and specTarget then specTarget else localPlayer)
		if camera and humanoid then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
	end

	local function updateSpecLabels()
		if not specTarget then
			specName.Text = "ไม่มีผู้เล่นอื่น"
			specSub.Text = ""
			avatar.Image = ""
			return
		end
		local list = specTargets()
		specName.Text = specTarget.DisplayName
		specSub.Text = string.format("@%s  •  %d/%d", specTarget.Name, table.find(list, specTarget) or 0, #list)
		local watched = specTarget
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(watched.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if ok and specTarget == watched then
				avatar.Image = image
			end
		end)
	end

	local function setSpecTarget(player: Player?)
		if specCharConn then
			specCharConn:Disconnect()
			specCharConn = nil
		end
		specTarget = player
		if player then
			specCharConn = player.CharacterAdded:Connect(function(character)
				character:WaitForChild("Humanoid", 5)
				applySpecCamera()
			end)
		end
		updateSpecLabels()
		applySpecCamera()
	end

	local specSwitch = nil
	local function setSpectate(on: boolean)
		spectating = on
		specPanel.Visible = on
		if specSwitch and specSwitch.value ~= on then
			specSwitch.set(on, true)
		end
		setSpecTarget(if on then specTargets()[1] else nil)
	end
	specSwitch = plainToggle(miscPage, "Spectate", "แถบควบคุมจะอยู่ด้านล่างจอ", setSpectate)

	local function stepSpec(direction: number)
		if not spectating then
			return
		end
		local list = specTargets()
		if #list == 0 then
			setSpecTarget(nil)
			return
		end
		local index = (specTarget and table.find(list, specTarget)) or (if direction > 0 then 0 else 1)
		setSpecTarget(list[(index - 1 + direction) % #list + 1])
	end

	local function teleportToSpec()
		if not (spectating and specTarget) then
			return
		end
		local targetCharacter = specTarget.Character
		local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
		if not (getRoot() and targetRoot) then
			specSub.Text = "วาปไม่ได้: ไม่พบตัวละคร"
			return
		end
		moveTo((targetRoot :: BasePart).CFrame * CFrame.new(0, 0, 3))
		setSpectate(false)
	end

	connect(prevButton.Activated, function()
		stepSpec(-1)
	end)
	connect(nextButton.Activated, function()
		stepSpec(1)
	end)
	connect(tpButton.Activated, teleportToSpec)
	connect(specClose.Activated, function()
		setSpectate(false)
	end)
	connect(Players.PlayerRemoving, function(player)
		if player == specTarget then
			task.defer(stepSpec, 1)
		elseif spectating then
			task.defer(updateSpecLabels)
		end
	end)
	connect(localPlayer.CharacterAdded, function(character)
		character:WaitForChild("Humanoid", 5)
		task.wait(0.1)
		if spectating then
			applySpecCamera()
		end
	end)
	connect(UserInputService.InputBegan, function(input, gameProcessed)
		if gameProcessed or not spectating then
			return
		end
		if input.KeyCode == Enum.KeyCode.Q then
			stepSpec(-1)
		elseif input.KeyCode == Enum.KeyCode.E then
			stepSpec(1)
		elseif input.KeyCode == Enum.KeyCode.T then
			teleportToSpec()
		end
	end)

	-- Anti-AFK: จำลองการกดเมาส์ตอนเกมจะเตะเพราะไม่ขยับ (ไม่นับเป็นการใช้งานของจอ AFK)
	local virtualUser = nil
	pcall(function()
		virtualUser = game:GetService("VirtualUser")
	end)
	local ignoreInputUntil = 0
	connect(localPlayer.Idled, function()
		if not config.antiAfk or not virtualUser then
			return
		end
		ignoreInputUntil = os.clock() + 2
		pcall(function()
			virtualUser:CaptureController()
			virtualUser:ClickButton2(Vector2.new())
		end)
		log("info", "Anti-AFK: กันโดนเตะเพราะไม่ขยับ")
		afkRow.setStatus("ทำงานล่าสุด " .. os.date("%H:%M:%S"), Theme.good)
	end)

	-- Auto Rejoin: เกมขึ้นข้อความ error (หลุด/โดนเตะ) → เข้าเกมใหม่
	local queueTeleport = (typeof(queue_on_teleport) == "function" and queue_on_teleport)
		or (typeof(queueonteleport) == "function" and queueonteleport)
		or nil
	local rejoining = false
	local function rejoin(reason: string)
		if rejoining or not running then
			return
		end
		rejoining = true
		log("warn", "หลุดจากเกม (" .. reason .. ") กำลังเข้าใหม่...")
		run.rejoins += 1
		run.save()
		if queueTeleport and canFile then
			-- ไฟล์ชื่อใหม่ก่อน ถ้ายังไม่ได้เซฟชื่อใหม่ใช้ไฟล์ชื่อเดิม
			for _, fileName in { SCRIPT_FILE, LEGACY_SCRIPT_FILE } do
				if isfile(fileName) then
					pcall(queueTeleport, 'loadstring(readfile("' .. fileName .. '"))()')
					break
				end
			end
		end
		task.spawn(function()
			while running do
				pcall(function()
					TeleportService:Teleport(game.PlaceId, localPlayer)
				end)
				task.wait(15)
			end
		end)
	end
	connect(GuiService.ErrorMessageChanged, function(message)
		if config.autoRejoin and type(message) == "string" and message ~= "" then
			rejoinRow.setStatus("หลุด: " .. message, Theme.bad)
			alert("🔌 หลุดจากเกม", message .. " · กำลังเข้าใหม่ให้เอง", Theme.bad)
			task.delay(3, rejoin, message)
		end
	end)

	-- ระบบดูแลตัวเอง: เงินไม่เข้านานผิดปกติ → วาปกลับบ้านก่อน ถ้ายังไม่เข้า → เข้าเซิร์ฟใหม่
	-- (ระบบดูแล / จอ AFK อยู่ในฟังก์ชันของตัวเอง เพราะตัวแปรในบล็อกนี้ชนขีดจำกัด 200 ตัวของ Luau)
	local function setupWatchdog()
		local lastEarned, lastEarnAt, softFixed, hardFixed = session.earned, os.clock(), false, false
		startLoop("Watchdog", "watchdog", 15, watchdogRow, function()
			-- กล้องค้างแบบ Scriptable ทั้งที่ไม่ได้วาปอยู่ (เช่น error กลางทาง) → คืนกล้องให้
			local camera = workspace.CurrentCamera
			if camera and camera.CameraType == Enum.CameraType.Scriptable and not hopBusy then
				camera.CameraType = Enum.CameraType.Custom
				log("warn", "ระบบดูแล: กล้องค้าง คืนกล้องให้แล้ว")
			end
			if session.earned > lastEarned then
				lastEarned, lastEarnAt, softFixed = session.earned, os.clock(), false
			end
			if not config.autoStock or paused or not alive() then
				lastEarnAt = os.clock()
				watchdogRow.setStatus("ไม่ได้เฝ้า (Auto Farm ปิด / หยุดอยู่ / รอตัวละครเกิด)", Theme.sub)
				return
			end
			-- ขายห่าง ๆ เงินก็เข้าห่าง: เผื่อเวลาตามรอบขาย
			local limit = math.max(20 * 60, config.sellEvery * 2 + 300)
			local idle = os.clock() - lastEarnAt
			if idle > limit and not hardFixed then
				hardFixed = true
				alert("🛠 เงินไม่เข้า " .. fmtTime(idle), "ระบบดูแลกำลังเข้าเซิร์ฟใหม่เพื่อแก้อาการค้าง", Theme.bad)
				rejoinRow.setStatus("ระบบดูแล: เงินไม่เข้านานเกินไป กำลังเข้าเซิร์ฟใหม่", Theme.bad)
				task.delay(3, rejoin, "เงินไม่เข้า " .. math.floor(idle / 60) .. " นาที")
			elseif idle > limit / 2 and not softFixed then
				softFixed = true
				fire("WarpRequest", "home")
				log("warn", "ระบบดูแล: เงินไม่เข้า " .. fmtTime(idle) .. " ลองวาปกลับบ้านก่อน")
			end
			watchdogRow.setStatus(
				string.format("เงินเข้าล่าสุด %s ที่แล้ว · ถ้าเกิน %s จะเข้าเซิร์ฟใหม่ให้เอง", fmtTime(idle), fmtTime(limit)),
				Theme.sub
			)
		end)
	end
	setupWatchdog()

