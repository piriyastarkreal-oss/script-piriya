-- ถ้ายังไม่เคยเหยียบ ลองเดาจากชื่อ part ที่มีคำว่า "sell"
local function guessSellPad(): CFrame?
	local root = getRoot()
	if not root then
		return nil
	end
	local best, bestDist = nil, math.huge
	for _, obj in workspace:GetDescendants() do
		if obj:IsA("BasePart") and obj.Name:lower():find("sell", 1, true) then
			local dist = (obj.Position - root.Position).Magnitude
			if dist < bestDist then
				best, bestDist = obj, dist
			end
		end
	end
	return best and CFrame.new(best.Position + Vector3.new(0, best.Size.Y / 2 + 3, 0))
end

local function buttonText(button: GuiButton): string
	local parts = {}
	if button:IsA("TextButton") then
		table.insert(parts, button.Text)
	end
	for _, d in button:GetDescendants() do
		if d:IsA("TextLabel") then
