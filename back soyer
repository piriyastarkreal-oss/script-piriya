local canFile = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
local config = table.clone(DEFAULTS)

do
	local savedRev = 0
	local function applySaved(data)
		if type(data) ~= "table" then
			return
		end
		savedRev = math.max(savedRev, tonumber(data.configRev) or 0)
		for key, value in data do
			if DEFAULTS[key] ~= nil and type(value) == type(DEFAULTS[key]) then
				config[key] = value
			elseif key == "sellPadRel" and type(value) == "table" and #value == 3 then
				config.sellPadRel = value
			end
		end
	end

	applySaved(env.MineHub_Config)
	applySaved(env.BackSoyer_Config)
	if canFile then
		-- ไฟล์ชื่อใหม่ก่อน ถ้ายังไม่มีใช้ค่าจากไฟล์ของ Mine Hub (ตำแหน่งแท่นขายไม่หาย)
		local ok, data = pcall(function()
			for _, fileName in { CONFIG_FILE, LEGACY_CONFIG_FILE } do
				if isfile(fileName) then
					return HttpService:JSONDecode(readfile(fileName))
				end
			end
			return nil
		end)
		if ok then
			applySaved(data)
		end
	end
	-- ค่าจากรุ่นก่อน v2.4 ที่ยังเป็นค่าเริ่มต้นเดิม (เก็บเงินขยายก่อน) ย้ายไปโหมดคุ้มสุดครั้งเดียว
