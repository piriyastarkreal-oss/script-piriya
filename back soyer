-- (ไฟล์ล่าสุดเก่ากว่า 30 นาที = เริ่มรอบใหม่) · away = ภาพรวมตอนเริ่มไม่ได้แตะเครื่อง ไว้ทำสรุปตอนกลับมา
local run = { file = "BackSoyer_run.json", startedAt = os.time(), rejoins = 0, base = { earned = 0, spent = 0 }, baseCounters = {}, away = nil :: any }
do
	if canFile then
		local ok, data = pcall(function()
			return if isfile(run.file) then HttpService:JSONDecode(readfile(run.file)) else nil
		end)
		if ok and type(data) == "table" and os.time() - num(data.savedAt) <= 30 * 60 then
			run.startedAt = num(data.startedAt, os.time())
			run.rejoins = num(data.rejoins)
			run.base.earned = num(data.earned)
			run.base.spent = num(data.spent)
