-- ปุ่ม SAFE / GAMBLE ในหน้าต่าง SMELTED CRATES ที่โผล่ตอนยืนบนแท่นขาย
local function findSellButton(mode: string): GuiButton?
	for _, obj in playerGui:GetDescendants() do
		if obj:IsA("GuiButton") and obj.Visible and buttonText(obj):find(mode:lower(), 1, true) then
			local screen = obj:FindFirstAncestorWhichIsA("ScreenGui")
			if screen and screen.Enabled and screen ~= gui then
				return obj
			end
		end
	end
	return nil
end

local stockOn = false
local lastSell = 0

local function stockCycle()
	local done = {}

	withHops(function(hop)
		for i, step in STEPS do
			local prompt = locked[i]
			if not (prompt and prompt.Parent) then
				prompt = findNearestPrompt(step)
				locked[i] = prompt
			end
			if not prompt then
				table.insert(done, step.name .. " ✗")
			elseif not prompt.Enabled then
				table.insert(done, step.name .. " –")
			else
				local root = getRoot()
				local pos = getPosition(prompt.Parent)
				if root and pos and (pos - root.Position).Magnitude > 8 then
					hop(CFrame.new(pos + Vector3.new(0, 3, 0)))
				end
				firePrompt(prompt)
				table.insert(done, step.name .. " ✓")
				task.wait(STEP_DELAY)
			end
		end

		-- ขาย: ต้องยืนบนแท่นขาย แล้วกดปุ่ม SAFE / GAMBLE
		if os.clock() - lastSell < SELL_EVERY then
			return
		end
		lastSell = os.clock()
		local pad = sellPadCFrame or guessSellPad()
		if not localPlayer:GetAttribute("OnSellPad") and pad then
			hop(pad)
			local t = os.clock()
			while not localPlayer:GetAttribute("OnSellPad") and os.clock() - t < 1 do
				task.wait(0.05)
			end
		end
		if not localPlayer:GetAttribute("OnSellPad") then
			table.insert(done, if pad then "Sell ✗ ไปแท่นไม่ติด" else "Sell ✗ หาแท่นไม่เจอ")
			return
		end

		local cashBefore = getCash()
		local button = nil
		local t = os.clock()
		repeat
			button = findSellButton(SELL_MODE)
			if not button then
				task.wait(0.05)
			end
		until button or os.clock() - t > 1
		if not (button and clickGuiButton(button)) then
			fireRemote("SellSmelted", SELL_MODE)
		end
		task.wait(0.6)
		local gained = getCash() - cashBefore
		table.insert(done, if gained > 0 then string.format("Sell +$%d", gained) else "Sell –")
	end)

	if CLAIM_AWAY and (tonumber(localPlayer:GetAttribute("AwayCash")) or 0) > 0 then
		if fireRemote("AwayClaim", "claim") then
			table.insert(done, "Away ✓")
		end
	end

	stockRow.status.Text = table.concat(done, " · ")
end

local function setStock(on: boolean)
	stockOn = on
	if on then
		for i, step in STEPS do
			locked[i] = findNearestPrompt(step) -- ล็อกปุ่มที่ใกล้ที่สุดตอนเปิด
		end
	end
	stockRow.paint(on)
end

startLoop(STOCK_INTERVAL, function()
	return stockOn
end, stockCycle, stockRow.status)

