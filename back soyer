local allPrompts: { [ProximityPrompt]: boolean } = {}
for _, descendant in workspace:GetDescendants() do
	if descendant:IsA("ProximityPrompt") then
		allPrompts[descendant] = true
	end
end
connect(workspace.DescendantAdded, function(descendant)
	if descendant:IsA("ProximityPrompt") then
		allPrompts[descendant] = true
	end
end)
connect(workspace.DescendantRemoving, function(descendant)
	allPrompts[descendant] = nil
end)

local function promptMatches(prompt: ProximityPrompt, action: string?, object: string?): boolean
	return (action == nil or prompt.ActionText:lower():find(action, 1, true) ~= nil)
		and (object == nil or prompt.ObjectText:lower():find(object, 1, true) ~= nil)
end

local function findPromptIn(container: Instance?, action: string?, object: string?): ProximityPrompt?
	if not container then
		return nil
	end
	for _, descendant in container:GetDescendants() do
		if descendant:IsA("ProximityPrompt") and promptMatches(descendant, action, object) then
			return descendant
		end
	end
	return nil
end

local function nearestPrompt(action: string?, object: string?, origin: Vector3): ProximityPrompt?
	local best, bestDistance = nil, math.huge
	for prompt in allPrompts do
		if prompt.Parent and promptMatches(prompt, action, object) then
			local pos = posOf(prompt.Parent)
			if pos then
				local distance = (pos - origin).Magnitude
				if distance < bestDistance then
					best, bestDistance = prompt, distance
				end
			end
		end
	end
	return best
end

-- วาปไปใกล้ปุ่ม (ถ้ายังไม่ใกล้) แล้วกด
local function usePrompt(prompt: ProximityPrompt?, hopTo: (CFrame?) -> boolean): boolean
	if not (prompt and prompt.Parent) then
		return false
	end
	local pos = posOf(prompt.Parent)
	if pos and not nearPos(pos, 7) then
		hopTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
	end
	return firePrompt(prompt)
end

-- จุดยืนหน้าจอของป้าย/แท่น: ออกมาจากด้านที่ SurfaceGui แสดงอยู่ distance stud แล้วหาพื้นด้านล่าง
local function standAt(part: BasePart, face: Enum.NormalId, ignore: Instance?, distance: number): CFrame
	local normal = Vector3.FromNormalId(face)
	local worldNormal = part.CFrame:VectorToWorldSpace(normal)
	local flat = Vector3.new(worldNormal.X, 0, worldNormal.Z)
	flat = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, -1)
	local front = part.Position + flat * (math.abs(normal:Dot(part.Size)) / 2 + distance)
	local ignoreList: { Instance } = { ignore or part }
	if localPlayer.Character then
		table.insert(ignoreList, localPlayer.Character)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList
	pcall(function()
		params.RespectCanCollide = true
	end)
	local hit = workspace:Raycast(front + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), params)
	local y = if hit then hit.Position.Y + 3 else part.Position.Y - part.Size.Y / 2 + 3
	local pos = Vector3.new(front.X, y, front.Z)
	return CFrame.lookAt(pos, Vector3.new(part.Position.X, y, part.Position.Z))
end

-- ข้อความที่เกมเด้งบอก (BagNotice เช่น กระเป๋าเต็ม) + ข้อมูลกระเป๋า miner ที่เซิร์ฟเวอร์ส่งมา (BagSync)
local gameNotice = { text = "", at = 0 }
local bag: { cap: number?, count: number?, list: { any }?, at: number } = { cap = nil, count = nil, list = nil, at = 0 }
do
	local syncRemote = remoteFolder and remoteFolder:FindFirstChild("BagSync")
	if syncRemote and syncRemote:IsA("RemoteEvent") then
		connect(syncRemote.OnClientEvent, function(data)
			if type(data) ~= "table" then
				return
			end
			bag.list = if type(data.list) == "table" then data.list else bag.list
			bag.cap = tonumber(data.cap) or bag.cap
			bag.count = tonumber(data.count) or (if bag.list then #bag.list else bag.count)
			bag.at = os.clock()
		end)
	end
	local noticeRemote = remoteFolder and remoteFolder:FindFirstChild("BagNotice")
	if noticeRemote and noticeRemote:IsA("RemoteEvent") then
		connect(noticeRemote.OnClientEvent, function(message)
			if type(message) ~= "string" or message == "" then
				return
			end
			-- ข้อความเดิมซ้ำ ๆ ลง log ครั้งเดียว
			local repeated = message == gameNotice.text and os.clock() - gameNotice.at < 300
			gameNotice.text, gameNotice.at = message, os.clock()
			if not repeated then
				log("warn", "เกมแจ้ง: " .. message)
			end
		end)
	end
end

