-- ฟอนต์: ใช้ตัวที่มีใน Enum.Font ถ้าไม่มีใช้ Gotham แทน (ตัวอักษรไทยใช้ฟอนต์ไทยของ Roblox เสมอ)
local FONT, FONT_BOLD, FONT_MONO, FONT_MONO_BOLD, FONT_BRAND
do
	local function pickFont(names: { string }, weight: Enum.FontWeight): Font
		for _, name in names do
			local ok, face = pcall(function()
				return Font.fromEnum((Enum.Font :: any)[name])
			end)
			if ok and face then
				return Font.new(face.Family, weight)
			end
		end
		return Font.new("rbxasset://fonts/families/GothamSSm.json", weight)
	end
	FONT = pickFont({ "BuilderSans", "Gotham" }, Enum.FontWeight.Medium)
	FONT_BOLD = pickFont({ "BuilderSans", "Gotham" }, Enum.FontWeight.Bold)
	FONT_MONO = pickFont({ "RobotoMono", "Code" }, Enum.FontWeight.Medium)
	FONT_MONO_BOLD = pickFont({ "RobotoMono", "Code" }, Enum.FontWeight.Bold)
	FONT_BRAND = pickFont({ "Michroma", "Oswald" }, Enum.FontWeight.Regular)
end

