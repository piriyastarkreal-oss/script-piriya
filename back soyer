		Position = if value then UDim2.fromOffset(22, 2) else UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	}, { corner(9) })
	local api = { value = value }
	function api.set(newValue: boolean, silent: boolean?)
		api.value = newValue
		tween(track, { BackgroundColor3 = if newValue then Theme.good else Theme.off })
		tween(knob, { Position = if newValue then UDim2.fromOffset(22, 2) else UDim2.fromOffset(2, 2) })
		if not silent then
			onChange(newValue)
		end
	end
	connect(track.Activated, function()
		api.set(not api.value)
	end)
	return api
