local function card(page: Instance): Frame
	local group = groups[page]
	if not group then
		return new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.panel,
			LayoutOrder = nextOrder(),
			Parent = page,
		}, { corner(10), stroke(Theme.stroke, 1), padding(10, 12, 10, 12) })
	end
	group.count += 1
	group.frame.Visible = true
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		LayoutOrder = group.count,
		Parent = group.frame,
	}, { padding(10, 12, 10, 12) })
	if group.count > 1 then
		new("Frame", {
			Name = "Divider",
			Position = UDim2.fromOffset(0, -10),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Theme.stroke,
			BorderSizePixel = 0,
			Parent = row,
		})
	end
	connect(row.MouseEnter, function()
		tween(row, { BackgroundTransparency = 0.975 })
	end)
	connect(row.MouseLeave, function()
		tween(row, { BackgroundTransparency = 1 })
	end)
	return row
end

local function textColumn(parent: Instance, width: UDim, title: string, desc: string?): (Frame, TextLabel)
