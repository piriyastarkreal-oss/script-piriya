	local spectating = false
	local specTarget: Player? = nil
	local specCharConn: RBXScriptConnection? = nil

	local function specTargets(): { Player }
		local list = {}
		for _, player in Players:GetPlayers() do
			if player ~= localPlayer then
				table.insert(list, player)
			end
		end
		table.sort(list, function(a, b)
			return a.Name:lower() < b.Name:lower()
		end)
		return list
	end

	local function applySpecCamera()
		local camera = workspace.CurrentCamera
		local humanoid = getHumanoid(if spectating and specTarget then specTarget else localPlayer)
		if camera and humanoid then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
	end

	local function updateSpecLabels()
		if not specTarget then
			specName.Text = "ไม่มีผู้เล่นอื่น"
			specSub.Text = ""
			avatar.Image = ""
			return
		end
		local list = specTargets()
		specName.Text = specTarget.DisplayName
		specSub.Text = string.format("@%s  •  %d/%d", specTarget.Name, table.find(list, specTarget) or 0, #list)
		local watched = specTarget
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(watched.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if ok and specTarget == watched then
				avatar.Image = image
			end
		end)
	end

	local function setSpecTarget(player: Player?)
		if specCharConn then
			specCharConn:Disconnect()
			specCharConn = nil
		end
		specTarget = player
		if player then
			specCharConn = player.CharacterAdded:Connect(function(character)
				character:WaitForChild("Humanoid", 5)
				applySpecCamera()
			end)
		end
		updateSpecLabels()
		applySpecCamera()
	end

	local specSwitch = nil
	local function setSpectate(on: boolean)
		spectating = on
		specPanel.Visible = on
		if specSwitch and specSwitch.value ~= on then
			specSwitch.set(on, true)
		end
		setSpecTarget(if on then specTargets()[1] else nil)
	end
	specSwitch = plainToggle(miscPage, "Spectate", "แถบควบคุมจะอยู่ด้านล่างจอ", setSpectate)

	local function stepSpec(direction: number)
		if not spectating then
			return
		end
		local list = specTargets()
		if #list == 0 then
			setSpecTarget(nil)
			return
		end
		local index = (specTarget and table.find(list, specTarget)) or (if direction > 0 then 0 else 1)
		setSpecTarget(list[(index - 1 + direction) % #list + 1])
	end

	local function teleportToSpec()
		if not (spectating and specTarget) then
			return
		end
		local targetCharacter = specTarget.Character
		local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
		if not (getRoot() and targetRoot) then
			specSub.Text = "วาปไม่ได้: ไม่พบตัวละคร"
			return
		end
		moveTo((targetRoot :: BasePart).CFrame * CFrame.new(0, 0, 3))
		setSpectate(false)
	end

