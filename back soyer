		local function welcomeBack()
			local away = run.away
			if type(away) ~= "table" then
				return
			end
			run.away = nil
			run.save()
			local seconds = os.time() - num(away.at)
			if seconds < 20 * 60 then
				return
			end
			local totals = run.totals()
			local report = string.format(
				"ไม่อยู่ %s · ได้ %s · miner ใหม่ %d (เข้า Index %d) · อัพเกรด %d · ฟักไข่ %d · เข้าเซิร์ฟใหม่ %d ครั้ง",
				fmtTime(seconds),
				fmtCash(totals.earned - num(away.earned)),
				totals.miners - num(away.miners),
				totals.indexNew - num(away.indexNew),
				totals.upgrades - num(away.upgrades),
				totals.hatched - num(away.hatched),
				run.rejoins - num(away.rejoins)
			)
			log("good", "ยินดีต้อนรับกลับ: " .. report)
			toast("ยินดีต้อนรับกลับ · " .. report, Theme.good, 15)
			alert("🌅 สรุประหว่างไม่อยู่", report, Theme.good)
		end

		local function userActive()
			lastInputAt = os.clock()
			-- 15 วิแรกหลังเริ่มสคริปต์ไม่นับ กันอินพุตหลอกตอนเกมโหลดหลังเข้าเซิร์ฟใหม่
			if run.away and os.clock() - session.start > 15 then
				welcomeBack()
			end
		end

