				if paused then string.format("   ·   <font color=\"%s\">PAUSED</font>", colorHex(Theme.accent)) else ""
			)
			local values = sparkValues(#bars)
			for index, bar in bars do
				bar.Size = UDim2.new(1 / #bars, -3, math.max(values[index], 0.06), 0)
				bar.BackgroundTransparency = if index == #bars then 0 else 0.3
			end
			minersCaption.Text = string.format("MINERS   %d / %d", minersHave, minersTotal)
			minersFill.Size = UDim2.fromScale(if minersTotal > 0 then minersHave / minersTotal else 0, 1)
