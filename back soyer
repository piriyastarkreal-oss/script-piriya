-- 14) ROLL: ซื้อ miner จากแท่นสุ่มของเรา (RollArea_<plot>/PedestalN)
---------------------------------------------------------------------
do
	local rollPage = pages.Roll

	section(
		rollPage,
		"สุ่ม miner",
		"ซื้อตัวที่ rarity ถึงที่ตั้งไว้ (หรือยังไม่มีใน Index) และเงินพอ เกมให้ซื้อเฉพาะตอนอยู่ใกล้แท่น สคริปต์จะวาปไปซื้อให้ · ตัวที่ไม่เอา / แพงเกินจะรอ จะสุ่มต่อให้เอง"
	)
	local pedestalCard = liveCard(rollPage)
	local rollRow = toggleRow(rollPage, "autoRoll", "Auto Roll", "ซื้อ miner ที่ต้องการให้เอง + สุ่มต่อให้")
	cycleRow(rollPage, "rollMinRarity", "Rarity ขั้นต่ำที่จะซื้อ", "ต่ำกว่านี้ไม่ซื้อ (กันกระเป๋าเต็ม)", RARITY_NAMES, rarityColor)
	stepperRow(rollPage, "rollMaxSpendPct", "ใช้เงินได้ไม่เกิน", "ต่อ miner 1 ตัว เทียบกับเงินที่มี", 10, 100, 10, function(value)
		return value .. "%"
	end)
	toggleRow(
		rollPage,
		"useGameAutoRoll",
		"ใช้ Auto Roll ของเกม (ถ้ามีสิทธิ์)",
		"ได้สิทธิ์จาก Game Pass หรือช่วงทดลองฟรีจากการเข้ากลุ่ม เกมจะสุ่มเองจนเจอ miner ที่เลือก แล้วสคริปต์ซื้อให้"
	)
	toggleRow(rollPage, "pullLever", "ดึงคันโยกเอง (ตอนไม่มีสิทธิ์ Auto Roll)", "วาปไปดึงคันโยกที่เครื่องสุ่มให้ ถ้าหาคันโยกไม่เจอ สถานะจะบอก")
	toggleRow(rollPage, "equipBest", "Equip Best (miner)", "ใส่ miner ที่ดีที่สุดให้หลังซื้อ และทุก 1 นาที")
	toggleRow(
		rollPage,
		"bagAutoDelete",
		"ลบ miner ที่แย่สุดเมื่อกระเป๋าเต็ม",
		"ปิดไว้ก่อน (ลบแล้วเอาคืนไม่ได้) · ลบเฉพาะตัวที่ rarity ต่ำกว่าขั้นต่ำด้านบน ไม่ลบตัวโปรด ⭐ / ตัวบน hotbar / ตัวที่ทำงานที่ประตู และเหลือไว้อย่างน้อยชนิดละ 1 ตัว"
	)

	local function myPedestals(): ({ Instance }, Instance?)
		local area = myBuilding("RollArea")
		local list = {}
		if area then
			for _, child in area:GetChildren() do
				if child.Name:match("^Pedestal%d") then
					table.insert(list, child)
				end
			end
		end
		table.sort(list, function(a, b)
			return num(a.Name:match("%d+")) < num(b.Name:match("%d+"))
		end)
		return list, area
	end

	-- miner ที่แท่นโชว์อยู่: ชื่อ, rarity, ราคา (สูตรเดียวกับป้ายของเกม)
	local function pedestalResult(pedestal: Instance): MinerInfo?
		local key = pedestal:GetAttribute("Result") or ""
		if key == "" then
			return nil
		end
		local folder = getMinerModels()
		local model = folder and folder:FindFirstChild(key)
		local rarity = (model and model:GetAttribute("Rarity")) or "?"
		local def = MinerCatalog and MinerCatalog.BY_NAME and MinerCatalog.BY_NAME[rarity]
		local price = (def and def.price) or 0
		if def and Economy and Economy.minerPrice then
			local ok, value = pcall(Economy.minerPrice, def, pedestal:GetAttribute("ResultSize"), pedestal:GetAttribute("ResultMut"), pedestal:GetAttribute("ResultQ"))
			if ok and type(value) == "number" then
				price = value
			end
		end
		return {
			key = key,
			name = (model and model:GetAttribute("DisplayName")) or key,
			rarity = rarity,
			tier = rarityTier(rarity),
			price = price,
			mut = pedestal:GetAttribute("ResultMut"),
			revealAt = num(pedestal:GetAttribute("RevealAt")),
			rollId = pedestal:GetAttribute("RollId"),
		}
	end

	local function hasAutoRollAccess(): boolean
		return pAttr("Pass_AutoRoll") == true or pAttr("AutoRollAccess") == true
	end

	-- miner ที่ต้องการ: ยังไม่มีใน Index (Auto Index) หรือ rarity ถึงขั้นต่ำ (Auto Roll)
	local function isWanted(info: MinerInfo, indexed: { [string]: boolean }, minTier: number): boolean
		return (config.autoIndex and not indexed[info.key]) or (config.autoRoll and info.tier >= minTier)
	end

	-- รายชื่อที่ส่งให้ Auto Roll ของเกม: ตัวที่ขาดใน Index + ตัวที่ rarity ถึงขั้นต่ำ
	-- (ไม่ใส่ตัวที่โชว์อยู่บนแท่นแต่เราข้ามไป ไม่งั้นเกมเจอตัวเดิมแล้วหยุดสุ่มทันที)
	local function wantedMinerNames(exclude: { [string]: boolean }?): ({ string }, number)
		local names = {}
		local missing = 0
		local indexed = indexSets()
		local minTier = rarityTier(config.rollMinRarity)
		for rarityName, list in minerPool() do
			local byRarity = config.autoRoll and rarityTier(rarityName) >= minTier
			for _, name in list do
				local isMissing = config.autoIndex and not indexed[name]
				if isMissing then
					missing += 1
				end
				if (byRarity or isMissing) and not (exclude and exclude[name]) then
					table.insert(names, name)
				end
			end
		end
		return names, missing
	end

	-- ซื้อได้แท่นละ 2 ครั้งต่อผลสุ่ม 1 ครั้ง (กันวนซื้อตัวที่เกมไม่ยอมขาย)
	local buyTries: { [Instance]: { rollId: any, tries: number } } = {}
	local function triesFor(pedestal: Instance, rollId: any): number
		local entry = buyTries[pedestal]
		return if entry and entry.rollId == rollId then entry.tries else 0
	end

	-- จุดยืนหน้าจอของแท่น: ปุ่ม BUY อยู่บนจอ InfoGui ของ DisplayPanel (เกมให้กดได้ในระยะ 45 stud)
	local function pedestalSpot(pedestal: Instance): CFrame?
		local panel = pedestal:FindFirstChild("DisplayPanel", true)
		if panel and panel:IsA("BasePart") then
			local surface = panel:FindFirstChildOfClass("SurfaceGui")
			return standAt(panel, if surface then surface.Face else Enum.NormalId.Front, pedestal, 5)
		end
		local pos = posOf(pedestal)
		return if pos then CFrame.new(pos + Vector3.new(0, 4, 0)) else nil
	end

	local function buyMiner(pedestal: Instance, info: MinerInfo, areaName: string, isNew: boolean): (boolean, string?)
		local entry = buyTries[pedestal]
		if entry and entry.rollId == info.rollId then
			if entry.tries >= 2 then
				return false, nil
			end
			entry.tries += 1
		else
			entry = { rollId = info.rollId, tries = 1 }
			buyTries[pedestal] = entry
		end

		-- ซื้อสำเร็จ = จอแท่นว่าง (ผลเดิมหายแต่ยังเป็นรอบสุ่มเดิม) หรือจำนวน miner เพิ่ม
		local ownedBefore = num(pAttr("MinersOwned"), -1)
		local function done(): boolean
			if (pedestal:GetAttribute("Result") or "") == "" and pedestal:GetAttribute("RollId") == info.rollId then
				return true
			end
			return ownedBefore >= 0 and num(pAttr("MinersOwned"), -1) > ownedBefore
		end
		local function changed(): boolean
			return done() or (pedestal:GetAttribute("Result") or "") ~= info.key or pedestal:GetAttribute("RollId") ~= info.rollId
		end

		-- ต้องอยู่ใกล้แท่นถึงจะซื้อได้: ไกลเกิน 30 stud (หรือครั้งแรกซื้อไม่ติด) วาปไปหน้าจอของแท่นก่อน
		local since = os.clock()
		local spot = pedestalSpot(pedestal)
		if spot and (entry.tries >= 2 or not nearPos(spot.Position, 30)) then
			withHops("Roll: ซื้อ " .. info.name, function(hopTo)
				hopTo(spot)
				fire("RollBuy", areaName, pedestal.Name)
				if not waitFor(changed, 1.2) then
					task.wait(0.3)
					fire("RollBuy", areaName, pedestal.Name)
					waitFor(changed, 1.2)
				end
			end)
		else
			fire("RollBuy", areaName, pedestal.Name)
			waitFor(changed, 1.5)
		end

		if done() then
			counters.miners += 1
			if isNew then
				counters.indexNew += 1
			end
			local mutText = if info.mut and info.mut ~= "" then " · " .. tostring(info.mut) else ""
			local newText = if isNew then "  📖 ใหม่ใน Index" else ""
			log("buy", string.format("ซื้อ miner %s (%s%s) %s%s", info.name, info.rarity, mutText, fmtCash(info.price), newText))
			toast(string.format("🎲 ได้ %s  [%s%s]%s", info.name, info.rarity, mutText, newText), rarityColor(info.rarity))
			if isNew or info.tier >= rarityTier(config.alertMinRarity) then
				alert(
					if isNew then "📖 ได้ miner ใหม่เข้า Index" else "🎲 ได้ miner หายาก",
					string.format("%s  [%s%s]  ราคา %s", info.name, info.rarity, mutText, fmtCash(info.price)),
					rarityColor(info.rarity)
				)
			end
			if config.equipBest then
				task.delay(1, function()
					fire("BagAction", "equipBest")
				end)
			end
			return true, nil
		end
		return false, noticeSince(since)
	end

	-- คันโยกสุ่ม: ProximityPrompt / ClickDetector ในพื้นที่สุ่มของเรา (ไม่นับปุ่ม AutoRollPrompt ที่เปิดหน้าต่าง Auto Roll)
	-- ถ้าในพื้นที่ไม่มี ใช้ปุ่มใกล้ ๆ ที่เขียนว่า roll / pull / lever
	local function findLevers(area: Instance): { Instance }
		local found = {}
		for _, descendant in area:GetDescendants() do
			if (descendant:IsA("ProximityPrompt") and descendant.Name ~= "AutoRollPrompt") or descendant:IsA("ClickDetector") then
				table.insert(found, descendant)
			end
		end
		if #found == 0 then
			local center = posOf(area)
			for prompt in allPrompts do
				local pos = prompt.Parent and posOf(prompt.Parent)
				if center and pos and prompt.Name ~= "AutoRollPrompt" and (pos - center).Magnitude < 80 then
					local words = (prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name):lower()
					if words:find("roll", 1, true) or words:find("pull", 1, true) or words:find("lever", 1, true) then
						table.insert(found, prompt)
					end
				end
			end
		end
		return found
	end

	-- คันโยกของแท่นนี้: อยู่ในแท่น หรือใกล้แท่นที่สุด (เครื่องที่มีคันโยกเดียวจะได้คันเดียวกันทุกแท่น)
	local function leverFor(pedestal: Instance, levers: { Instance }): Instance?
		local pedestalPos = posOf(pedestal)
		local best, bestDistance = nil, math.huge
		for _, lever in levers do
			if lever:IsDescendantOf(pedestal) then
				return lever
			end
			local pos = lever.Parent and posOf(lever.Parent)
			if pedestalPos and pos and (pos - pedestalPos).Magnitude < bestDistance then
				best, bestDistance = lever, (pos - pedestalPos).Magnitude
			end
		end
		return best
	end

	local leverPauseUntil = 0

	-- ดึงคันโยกให้แท่นที่ต้องสุ่มใหม่ (แท่นว่าง / ได้ตัวที่ไม่เอา)
	local function pullLevers(area: Instance, targets: { Instance }): (boolean, string?)
		if os.clock() < leverPauseUntil then
			return false, string.format("ดึงคันโยกแล้วแท่นไม่สุ่ม จะลองใหม่ใน %d วิ", math.ceil(leverPauseUntil - os.clock()))
		end
		local levers = findLevers(area)
		if #levers == 0 then
			return false, "หาคันโยกที่เครื่องสุ่มไม่เจอ: ต้องดึงเอง หรือใช้ Auto Roll ของเกม"
		end
		local plan: { { lever: Instance, pedestals: { Instance } } } = {}
		for _, pedestal in targets do
			local lever = leverFor(pedestal, levers)
			if lever then
				local entry = nil
				for _, existing in plan do
					if existing.lever == lever then
						entry = existing
						break
					end
				end
				if not entry then
					entry = { lever = lever, pedestals = {} }
					table.insert(plan, entry)
				end
				table.insert(entry.pedestals, pedestal)
			end
		end
		local pulled, since = 0, os.clock()
		withHops("Roll: ดึงคันโยก", function(hopTo)
			for _, entry in plan do
				local lever = entry.lever
				local enabled = not lever:IsA("ProximityPrompt") or (lever :: ProximityPrompt).Enabled
				if lever.Parent and enabled then
					local before = {}
					for _, pedestal in entry.pedestals do
						before[pedestal] = pedestal:GetAttribute("RollId")
					end
					local pos = posOf(lever.Parent)
					if pos and not nearPos(pos, 6) then
						hopTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
					end
					if lever:IsA("ProximityPrompt") then
						firePrompt(lever)
					elseif lever:IsA("ClickDetector") then
						fireClick(lever)
					end
					if waitFor(function()
						for _, pedestal in entry.pedestals do
							if pedestal:GetAttribute("RollId") ~= before[pedestal] then
								return true
							end
						end
						return false
					end, 1.5) then
						pulled += 1
					end
				end
			end
		end)
		if pulled > 0 then
			counters.rolls += pulled
			return true, nil
		end
		leverPauseUntil = os.clock() + 20
		local notice = noticeSince(since)
		return false, "ดึงคันโยกแล้วแท่นไม่สุ่ม" .. (if notice then " (เกมแจ้ง: " .. notice .. ")" else "")
	end

	-- สั่ง Auto Roll ของเกม: ยิงจากที่ยืนอยู่ก่อน ถ้าเกมไม่เริ่ม วาปไปที่แท่นแล้วลองอีกครั้ง (แล้วจำไว้ว่าต้องวาป)
	local autoRollNeedsHop = false
	local function startGameAutoRoll(names: { string }, pedestals: { Instance }): (boolean, string?)
		local since = os.clock()
		local statusBefore = pAttr("AutoRollStatus")
		local function started(): boolean
			return pAttr("AutoRolling") == true or pAttr("AutoRollStatus") ~= statusBefore
		end
		if not autoRollNeedsHop then
			fire("AutoRoll", "start", names)
			if waitFor(started, 1.5) then
				return true, nil
			end
		end
		local spot = pedestals[1] and pedestalSpot(pedestals[1])
		local ok = false
		withHops("Roll: เริ่ม Auto Roll ของเกม", function(hopTo)
			if spot and not nearPos(spot.Position, 30) then
				hopTo(spot)
			end
			fire("AutoRoll", "start", names)
			ok = waitFor(started, 1.5)
		end)
		if ok then
			autoRollNeedsHop = true
		end
		return ok, noticeSince(since)
	end

	-- กระเป๋าเต็ม: ลบ miner ที่แย่ที่สุด (เฉพาะ rarity ต่ำกว่าขั้นต่ำ ไม่ใช่ตัวโปรด / บน hotbar / ทำงานที่ประตู และเหลือชนิดละอย่างน้อย 1 ตัว)
	local lastDeleteAt = 0
	local function freeBagSpace(need: number, minTier: number): number
		local list = bag.list
		if os.clock() - lastDeleteAt < 8 or type(list) ~= "table" then
			return 0
		end
		local folder = getMinerModels()
		local copies: { [any]: number } = {}
		for _, item in list do
			if type(item) == "table" and item.id ~= nil then
				copies[item.id] = (copies[item.id] or 0) + 1
			end
		end
		local pool = {}
		for _, item in list do
			if type(item) == "table" and item.uid ~= nil and item.id ~= nil and not item.fav and item.slot == nil and item.door == nil then
				local model = folder and folder:FindFirstChild(tostring(item.id))
				local tier = rarityTier(model and model:GetAttribute("Rarity"))
				if tier > 0 and tier < minTier then
					table.insert(pool, { uid = item.uid, id = item.id, tier = tier, power = num(item.power, num(item.kg)) })
				end
			end
		end
		table.sort(pool, function(a, b)
			if a.tier ~= b.tier then
				return a.tier < b.tier
			end
			return a.power < b.power
		end)
		local picked, names = {}, {}
		for _, candidate in pool do
			if #picked >= need then
				break
			end
			if (copies[candidate.id] or 0) > 1 then
				copies[candidate.id] -= 1
				table.insert(picked, candidate.uid)
				table.insert(names, minerDisplayName(tostring(candidate.id)))
			end
		end
		if #picked == 0 then
			return 0
		end
		lastDeleteAt = os.clock()
		fire("BagAction", "delete", picked)
		log("warn", string.format("กระเป๋าเต็ม: ลบ miner %d ตัว (%s)", #picked, table.concat(names, ", ")))
		task.delay(1, fire, "BagAction", "sync")
		return #picked
	end

	local autoRollStartedAt = 0
	local autoRollFails = 0
	local autoRollOffUntil = 0
	local lastAutoRollLog = 0
	local lastBagSync = 0
	local lastBagAlert = -math.huge
	local waitingKey: string? = nil
	local waitingSince = 0

	local function rollCycle()
		if not (config.autoRoll or config.autoIndex) then
			return
		end
		if not alive() then
			rollRow.setStatus("รอตัวละครเกิด...", Theme.sub)
			return
		end
		local pedestals, area = myPedestals()
		if not area then
			rollRow.setStatus("ยังไม่พบแท่นสุ่มของคุณ (RollArea_" .. tostring(plotId()) .. ")", Theme.bad)
			return
		end
		-- ขอข้อมูลกระเป๋าจากเซิร์ฟเวอร์เป็นระยะ (แบบเดียวกับตอนเปิดกระเป๋าในเกม) ไว้เช็คว่าเต็มไหม
		if os.clock() - lastBagSync > 30 then
			lastBagSync = os.clock()
			fire("BagAction", "sync")
		end
		local areaName = area.Name:match("^RollArea_(.+)$") or tostring(plotId())
		local minTier = rarityTier(config.rollMinRarity)
		local now = workspace:GetServerTimeNow()
		local money = cash()
		local income = math.max(num(pAttr("IncomePerMin")), ratePerMinute())
		local indexed = indexSets()
		local full = bagFull()

		local skipped: { [string]: boolean } = {} -- ตัวที่โชว์อยู่แต่ไม่ซื้อ (ไม่ส่งให้ Auto Roll ของเกมหา)
		local needRoll: { Instance } = {} -- แท่นที่ต้องสุ่มใหม่: ว่าง / ตัวที่ไม่เอา / แพงเกินรอ
		local rollingCount = 0
		local waitingFor: MinerInfo? = nil
		local waitingPedestal: Instance? = nil
		local waitMinutes, waitEta = 0, 0

		for _, pedestal in pedestals do
			local info = pedestalResult(pedestal)
			if info == nil then
				table.insert(needRoll, pedestal)
			elseif now < info.revealAt then
				rollingCount += 1
			elseif not isWanted(info, indexed, minTier) then
				skipped[info.key] = true
				table.insert(needRoll, pedestal)
			elseif full then
				skipped[info.key] = true
			else
				-- ตัวที่ยังไม่มีใน Index ใช้เพดานเงินของแท็บ Index (ถ้าเข้าเงื่อนไข rarity ด้วย ใช้เพดานที่สูงกว่า)
				local isNew = config.autoIndex and not indexed[info.key]
				local byRarity = config.autoRoll and info.tier >= minTier
				local pct = config.rollMaxSpendPct
				if isNew then
					pct = if byRarity then math.max(pct, config.indexMaxSpendPct) else config.indexMaxSpendPct
				end
				if info.price <= money * pct / 100 then
					if triesFor(pedestal, info.rollId) >= 2 then
						-- ลองซื้อครบ 2 ครั้งแล้วไม่ได้: ข้ามไปสุ่มใหม่
						skipped[info.key] = true
						table.insert(needRoll, pedestal)
					else
						local ok, why = buyMiner(pedestal, info, areaName, isNew)
						if ok then
							waitingKey = nil
							return
						end
						rollRow.setStatus(
							string.format(
								"ซื้อ %s ไม่สำเร็จ%s · %s",
								info.name,
								if why then " (เกมแจ้ง: " .. why .. ")" else "",
								if triesFor(pedestal, info.rollId) >= 2 then "ข้ามไปสุ่มใหม่" else "จะวาปไปที่แท่นแล้วลองอีกครั้ง"
							),
							Theme.bad
						)
						return
					end
				else
					-- เงินไม่พอ: รอเฉพาะตัวที่เก็บเงินทันในไม่กี่นาที (ตัวที่ขาดใน Index รอได้ 10 นาที ตัวอื่น 2 นาที) ไม่งั้นสุ่มต่อเลย
					local minutes = if isNew then 10 else 2
					local eta = if income > 0 then (info.price * 100 / pct - money) / income else math.huge
					if eta <= minutes then
						if waitingFor == nil or info.price < waitingFor.price then
							waitingFor, waitingPedestal, waitMinutes, waitEta = info, pedestal, minutes, eta
						end
					else
						skipped[info.key] = true
						table.insert(needRoll, pedestal)
					end
				end
			end
		end

		-- กระเป๋าเต็ม: ซื้อไม่ได้ สุ่มต่อก็เปล่าประโยชน์
		if full then
			local count, cap = bag.count or 0, bag.cap or 0
			if os.clock() - lastBagAlert > 1800 then
				lastBagAlert = os.clock()
				alert("🎒 กระเป๋า miner เต็ม", string.format("%d/%d ซื้อ miner เพิ่มไม่ได้", count, cap), Theme.bad)
			end
			if config.bagAutoDelete then
				local freed = freeBagSpace(math.clamp(count - cap + 1, 1, 5), minTier)
				if freed > 0 then
					rollRow.setStatus(string.format("กระเป๋าเต็ม (%d/%d): ลบ miner ที่แย่สุด %d ตัวแล้ว", count, cap, freed), Theme.accent)
					return
				end
			end
			rollRow.setStatus(
				string.format(
					"กระเป๋า miner เต็ม (%d/%d) ซื้อเพิ่มไม่ได้: เปิด Bigger Bag ในแท็บ Upgrades / เปิด 'ลบ miner ที่แย่สุด' ด้านล่าง / หรือลบเองในเกม",
					count,
					cap
				),
				Theme.bad
			)
			return
		end

		-- รอเงินซื้อตัวที่ใกล้จะมีเงินพอ
		if waitingFor then
			local key = waitingFor.key .. "#" .. tostring(waitingFor.rollId)
			if waitingKey ~= key then
				waitingKey, waitingSince = key, os.clock()
			end
			local waited = os.clock() - waitingSince
			if waited < waitMinutes * 60 then
				-- ตัวที่ขาดใน Index: กันเงินไว้ไม่ให้ Auto Upgrade ใช้
				if config.autoIndex and not indexed[waitingFor.key] then
					moneyHold.amount = waitingFor.price
					moneyHold.label = waitingFor.name .. " (" .. waitingFor.rarity .. ")"
					moneyHold.expires = os.clock() + 15
				end
				rollRow.setStatus(
					string.format(
						"เจอ %s (%s) ราคา %s · รอเงินอีกราว %s (ถ้าเกิน %s จะสุ่มต่อ)",
						waitingFor.name,
						waitingFor.rarity,
						fmtCash(waitingFor.price),
						fmtTime(waitEta * 60),
						fmtTime(waitMinutes * 60 - waited)
					),
					Theme.info
				)
				return
			end
			skipped[waitingFor.key] = true
			if waitingPedestal then
				table.insert(needRoll, waitingPedestal)
			end
		else
			waitingKey = nil
		end

		local useGame = config.useGameAutoRoll and hasAutoRollAccess() and os.clock() >= autoRollOffUntil
		if useGame and pAttr("Pass_AutoBuy") == true and pAttr("AutoBuyOn") == false then
			fire("AutoRoll", "autobuy", true)
		end
		if useGame and pAttr("AutoRolling") == true then
			local status = tostring(pAttr("AutoRollStatus") or "")
			local trialLeft = num(pAttr("AutoRollTrialEnd")) - now
			local trialText = if pAttr("Pass_AutoRoll") ~= true and trialLeft > 0 then " · ทดลองฟรีเหลือ " .. fmtTime(trialLeft) else ""
			rollRow.setStatus("Auto Roll ของเกม: " .. (if status ~= "" then status else "กำลังสุ่ม...") .. trialText)
			return
		end
		if rollingCount > 0 then
			rollRow.setStatus("กำลังสุ่ม / รอผล...", Theme.sub)
			return
		end
		if #needRoll == 0 then
			rollRow.setStatus("ไม่มีแท่นที่ต้องสุ่มใหม่", Theme.sub)
			return
		end

		-- สุ่มต่อ: ใช้ Auto Roll ของเกมถ้ามีสิทธิ์ (ทดลองฟรี / Game Pass) ไม่งั้นดึงคันโยกเอง
		local problem: string? = nil
		if useGame then
			if os.clock() - autoRollStartedAt < 4 then
				rollRow.setStatus("กำลังเริ่ม Auto Roll ของเกม...", Theme.sub)
				return
			end
			autoRollStartedAt = os.clock()
			local names, missing = wantedMinerNames(skipped)
			if #names > 0 then
				local ok, why = startGameAutoRoll(names, pedestals)
				if ok then
					autoRollFails = 0
					if os.clock() - lastAutoRollLog > 300 then
						lastAutoRollLog = os.clock()
						log("info", string.format("สั่ง Auto Roll ของเกม: หา %d แบบ (ยังไม่มีใน Index %d ตัว)", #names, missing))
					end
					local status = tostring(pAttr("AutoRollStatus") or "")
					rollRow.setStatus(string.format("สั่ง Auto Roll ของเกมแล้ว: หา %d แบบ%s", #names, if status ~= "" then " · " .. status else ""))
					return
				end
				autoRollFails += 1
				problem = "สั่ง Auto Roll ของเกมแล้วไม่เริ่ม" .. (if why then " (เกมแจ้ง: " .. why .. ")" else "")
				if autoRollFails >= 3 then
					autoRollFails = 0
					autoRollOffUntil = os.clock() + 120
					log("warn", problem .. " 3 ครั้งติด: เปลี่ยนไปดึงคันโยกเอง 2 นาที")
				end
			end
		end

		if config.pullLever then
			local ok, why = pullLevers(area, needRoll)
			if ok then
				rollRow.setStatus(string.format("ดึงคันโยกสุ่มใหม่ %d แท่น · สุ่มไปแล้ว %d ครั้ง", #needRoll, counters.rolls))
			else
				rollRow.setStatus(if problem then problem .. " · " .. tostring(why) else tostring(why), Theme.bad)
			end
		else
			rollRow.setStatus(problem or "ไม่มีตัวที่ต้องการบนแท่น แต่ 'ดึงคันโยกเอง' ปิดอยู่", if problem then Theme.bad else Theme.sub)
		end
	end
	startLoop("Auto Roll", nil, 1, rollRow, rollCycle)

	refreshers.Roll = function()
		local pedestals = myPedestals()
		if #pedestals == 0 then
			pedestalCard.Text = "ไม่พบแท่นสุ่มของแปลงนี้"
			return
		end
		local now = workspace:GetServerTimeNow()
		local minTier = rarityTier(config.rollMinRarity)
		local indexed = indexSets()
		local lines = {}
		for _, pedestal in pedestals do
			local info = pedestalResult(pedestal)
			local line
			if not info then
				line = "พร้อมสุ่ม"
			elseif now < info.revealAt then
				line = "กำลังสุ่ม..."
			else
				line = string.format(
					"<font color=\"%s\"><b>%s</b></font> %s · %s%s%s",
					colorHex(rarityColor(info.rarity)),
					info.rarity,
					info.name,
					fmtCash(info.price),
					if info.mut and info.mut ~= "" then " · " .. tostring(info.mut) else "",
					if not indexed[info.key] then "  📖 ยังไม่มีใน Index" elseif info.tier >= minTier then "  ✅" else ""
				)
			end
			table.insert(lines, pedestal.Name .. ": " .. line)
		end
		local accessText = if hasAutoRollAccess() then "มีสิทธิ์ Auto Roll ของเกม" else "ไม่มีสิทธิ์ Auto Roll ของเกม (ใช้คันโยก)"
		local bagText = "กระเป๋า miner: กำลังโหลด..."
		if bag.count and bag.cap then
			bagText = string.format("กระเป๋า miner %d/%d", bag.count, bag.cap)
			if bagFull() then
				bagText = "<font color=\"#F05A5A\">" .. bagText .. " เต็ม!</font>"
			end
		end
		pedestalCard.Text = table.concat(lines, "\n")
			.. string.format(
				"\n<font color=\"#949CAE\">%s · %s · ซื้อในรอบนี้ %d ตัว · สุ่ม %d ครั้ง</font>",
				accessText,
				bagText,
				counters.miners,
				counters.rolls
			)
	end
end

