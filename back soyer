-- ปุ่ม +/- ที่ก้าวใหญ่ขึ้นตามค่า (เช่น 1 วิ → 5 วิ → 15 วิ → 1 นาที)
type StepLadder = { { upTo: number, step: number } }
local function ladderStep(ladder: StepLadder, value: number, direction: number): number
	for _, rung in ladder do
		if (direction > 0 and value < rung.upTo) or (direction < 0 and value <= rung.upTo) then
			return rung.step
		end
	end
	return ladder[#ladder].step
end

