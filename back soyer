-- Auto Roll: ซื้อ miner จากตู้สุ่ม
-- ตู้อยู่ที่ workspace.BaseMap.MineBuildings.RollArea_<พื้นที่>.<ตู้>
-- ตู้มี attribute: Result (ชื่อ miner, "" = ว่าง), RevealAt, RollId
-- เกมซื้อด้วย RollBuy:FireServer(<พื้นที่>, <ชื่อตู้>)
---------------------------------------------------------------------
local rollOn = false
local MinerCatalog = nil
local minerModels: Instance? = nil
pcall(function()
	MinerCatalog = require(ReplicatedStorage:WaitForChild("Shared", 5):WaitForChild("MinerCatalog", 5))
	minerModels = ReplicatedStorage:FindFirstChild(MinerCatalog.MODELS_FOLDER)
end)

local function rarityIndex(name: string?): number?
	if not (MinerCatalog and name) then
		return nil
	end
	for i, r in ipairs(MinerCatalog.RARITIES) do
		if r.name == name then
			return i
		end
	end
	return nil
end

local function rarityNames(): string
	local names = {}
	if MinerCatalog then
		for _, r in ipairs(MinerCatalog.RARITIES) do
			table.insert(names, r.name)
		end
	end
	return table.concat(names, ", ")
end

local function minerRarity(minerName: string): (string?, number?)
	local model = minerModels and minerModels:FindFirstChild(minerName)
	local rarity = model and model:GetAttribute("Rarity")
	return rarity, rarityIndex(rarity)
end

local function getRollDisplays()
	local list = {}
	local baseMap = workspace:FindFirstChild("BaseMap")
	local buildings = baseMap and baseMap:FindFirstChild("MineBuildings")
	if not buildings then
		return list
	end
	for _, area in buildings:GetChildren() do
		local areaName = area.Name:match("^RollArea_(.+)$")
		if areaName then
			for _, display in area:GetChildren() do
				table.insert(list, { area = areaName, display = display })
			end
		end
	end
	return list
end

local rollAttempts: { [string]: number } = {} -- กันวาปไปซื้อตัวเดิมซ้ำไม่จบ
local rollBought = 0

local function rollCycle()
	if not MinerCatalog then
		rollRow.status.Text = "โหลดข้อมูล miner ของเกมไม่ได้"
		return
	end
	local minIndex = rarityIndex(ROLL_MIN_RARITY)
	if not minIndex then
		rollRow.status.Text = "ROLL_MIN_RARITY ใช้ได้: " .. rarityNames()
		return
	end

	local now = workspace:GetServerTimeNow()
	local waiting = 0
	for _, entry in getRollDisplays() do
		local display = entry.display
		local result = display:GetAttribute("Result") or ""
		local revealAt = display:GetAttribute("RevealAt") or 0
		if result ~= "" and now >= revealAt then
			local rarity, index = minerRarity(result)
			local key = display:GetFullName() .. "#" .. tostring(display:GetAttribute("RollId"))
			if index and index >= minIndex and (rollAttempts[key] or 0) < 2 then
				rollAttempts[key] = (rollAttempts[key] or 0) + 1

				-- ลองยิงจากที่เดิมก่อน ถ้าไม่ติดค่อยวาปไปที่ตู้
				fireRemote("RollBuy", entry.area, display.Name)
				task.wait(0.4)
				if (display:GetAttribute("Result") or "") == result then
					local pos = getPosition(display)
					if pos then
						withHops(function(hop)
							hop(CFrame.new(pos + Vector3.new(0, 5, 0)))
							fireRemote("RollBuy", entry.area, display.Name)
							task.wait(0.4)
						end)
					end
				end

				if (display:GetAttribute("Result") or "") ~= result then
					rollBought += 1
					rollRow.status.Text = string.format("ซื้อ %s (%s) · รวม %d ตัว", result, rarity, rollBought)
					return
				end
			elseif index and index >= minIndex then
				waiting += 1
			end
		end
	end
	if waiting > 0 then
		rollRow.status.Text = string.format("ซื้อไม่ได้ (เงินไม่พอ?) $%d", getCash())
	else
		rollRow.status.Text = string.format("รอ %s ขึ้นไป · ซื้อแล้ว %d", ROLL_MIN_RARITY, rollBought)
	end
end

local function setRoll(on: boolean)
	rollOn = on
	rollAttempts = {}
	rollRow.paint(on)
end

startLoop(ROLL_INTERVAL, function()
	return rollOn
end, rollCycle, rollRow.status)

---------------------------------------------------------------------
-- Spectate
---------------------------------------------------------------------
local spectating = false
local target: Player? = nil
local targetCharConn: RBXScriptConnection? = nil

local function getTargets(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= localPlayer then
			table.insert(list, p)
		end
	end
	table.sort(list, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)
	return list
end

local function applyCamera()
	local camera = workspace.CurrentCamera
	local humanoid = getHumanoid(if spectating and target then target else localPlayer)
	if camera and humanoid then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	end
end

local function updateLabels()
	if not target then
		nameLabel.Text = "ไม่มีผู้เล่นอื่น"
		subLabel.Text = ""
		avatar.Image = ""
		return
	end
	local targets = getTargets()
	local index = table.find(targets, target) or 0
	nameLabel.Text = target.DisplayName
	subLabel.Text = string.format("@%s  •  %d/%d", target.Name, index, #targets)

	local watched = target
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(watched.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and target == watched then
			avatar.Image = image
		end
	end)
end

local function setTarget(player: Player?)
	if targetCharConn then
		targetCharConn:Disconnect()
		targetCharConn = nil
	end
	target = player
	if player then
		-- ตามต่อเมื่อคนที่ดูอยู่เกิดใหม่
		targetCharConn = player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 5)
			applyCamera()
		end)
	end
	updateLabels()
	applyCamera()
end

local function stepTarget(direction: number)
	if not spectating then
		return
	end
	local targets = getTargets()
	if #targets == 0 then
		setTarget(nil)
		return
	end
	local index = (target and table.find(targets, target)) or (if direction > 0 then 0 else 1)
	index = (index - 1 + direction) % #targets + 1
	setTarget(targets[index])
end

local function setSpectate(on: boolean)
	spectating = on
	specPanel.Visible = on
	spectateRow.paint(on)
	setTarget(if on then getTargets()[1] else nil)
end

local function teleportToTarget()
	if not (spectating and target) then
		return
	end
	local myChar = localPlayer.Character
	local targetChar = target.Character
	local myRoot = getRoot()
	local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not (myChar and myRoot and targetRoot) then
		subLabel.Text = "วาปไม่ได้: ไม่พบตัวละคร"
		return
	end
	local myHumanoid = getHumanoid(localPlayer)
	if myHumanoid and myHumanoid.Sit then
		myHumanoid.Sit = false -- ลุกก่อน ไม่งั้นจะลากเก้าอี้ไปด้วย
		task.wait()
	end
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myChar:PivotTo(targetRoot.CFrame * TP_OFFSET)
	setSpectate(false)
end

connect(prevButton.Activated, function()
	stepTarget(-1)
end)
connect(nextButton.Activated, function()
	stepTarget(1)
end)
connect(tpButton.Activated, teleportToTarget)
connect(closeButton.Activated, function()
	setSpectate(false)
end)

connect(Players.PlayerRemoving, function(player)
	if player == target then
		local targets = getTargets()
		local index = table.find(targets, player) or 1
		table.remove(targets, index)
		setTarget(if #targets == 0 then nil else targets[(index - 1) % #targets + 1])
	elseif spectating then
		task.defer(updateLabels)
	end
end)

connect(Players.PlayerAdded, function()
	if not spectating then
		return
	end
	if target then
		updateLabels()
	else
		setTarget(getTargets()[1])
	end
end)

-- ตัวเราเกิดใหม่: กล้องถูกรีเซ็ต จึงต้องตั้งใหม่
connect(localPlayer.CharacterAdded, function(character)
	character:WaitForChild("Humanoid", 5)
	task.wait(0.1)
	applyCamera()
end)

---------------------------------------------------------------------
-- ปุ่มและปุ่มลัด
---------------------------------------------------------------------
connect(stockRow.button.Activated, function()
	setStock(not stockOn)
end)
connect(upgradeRow.button.Activated, function()
	setUpgrade(not upgradeOn)
end)
connect(rollRow.button.Activated, function()
	setRoll(not rollOn)
end)
connect(spectateRow.button.Activated, function()
	setSpectate(not spectating)
end)

connect(UserInputService.InputBegan, function(input, gameProcessed)
	if gameProcessed then
		return
	end
	local key = input.KeyCode
	if key == KEY_STOCK then
		setStock(not stockOn)
	elseif key == KEY_UPGRADE then
		setUpgrade(not upgradeOn)
	elseif key == KEY_ROLL then
		setRoll(not rollOn)
	elseif spectating and key == KEY_PREV then
		stepTarget(-1)
	elseif spectating and key == KEY_NEXT then
		stepTarget(1)
	elseif spectating and key == KEY_TP then
		teleportToTarget()
	end
end)

-- ใช้ตอนรันซ้ำ: หยุดทุกอย่าง คืนกล้อง และลบ UI ตัวเก่า
env.AllInOne_Cleanup = function()
	running = false
	stockOn, upgradeOn, rollOn = false, false, false
	if spectating then
		setSpectate(false)
	end
	for _, conn in connections do
		conn:Disconnect()
	end
	gui:Destroy()
end
