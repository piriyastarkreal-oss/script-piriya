	local switch = makeSwitch(holder, config[key] == true, function(value)
		config[key] = value
		saveConfig()
		if not value then
			status.Visible = false
		end
		if onChange then
			onChange(value)
		end
	end)
	table.insert(binders, function()
		if switch.value ~= (config[key] == true) then
			switch.set(config[key] == true)
		end
	end)
	local row = {}
	function row.setStatus(message: string?, color: Color3?)
		status.Text = message or ""
		status.TextColor3 = color or Theme.accent
		status.Visible = message ~= nil and message ~= ""
	end
	function row.set(value: boolean)
		switch.set(value)
	end
	return row :: any
end

