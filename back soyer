-- แรงขุดของ miner + ทีมที่ทำงานที่ประตู (ใช้ทั้งระบบสุ่มซื้อ / อัพเกรดแบบคุ้มสุด / Auto Grade)
local team = { Traits = safeRequire("Traits"), Grades = safeRequire("Grades") }

-- แรงขุดโดยประมาณ (ore/นาที) ด้วยสูตรของเกมเอง: Traits.minerPower(tier, ตัวคูณเกรด, ขนาด, mutation, คุณภาพ)
function team.powerOf(tier: number, gradeMult: number, size: any, mut: any, q: any): number?
	local traits = team.Traits
	if not (traits and traits.minerPower) then
		return nil
	end
	local ok, value = pcall(traits.minerPower, tier, gradeMult, size, if mut == "" then nil else mut, q)
	return if ok and type(value) == "number" then value else nil
end

-- tier ของ miner: ตาม rarity ของโมเดล (หรือ tier ที่ติดมากับตัว เช่นจากกล่อง Robux)
function team.tierOf(item: any): number?
	if type(item.tier) == "number" and item.tier > 0 then
		return item.tier
	end
	local folder = getMinerModels()
	local model = folder and folder:FindFirstChild(tostring(item.id))
	local def = model and MinerCatalog and MinerCatalog.BY_NAME and MinerCatalog.BY_NAME[model:GetAttribute("Rarity")]
	return def and def.tier
end

function team.gradeMult(grade: any): number
	local grades = team.Grades
	if grades and grades.mult then
		local ok, value = pcall(grades.mult, grade)
		if ok and type(value) == "number" then
			return value
		end
	end
	return 1
end

-- แรงขุดของ miner ในกระเป๋า (ข้อมูลจาก BagSync: id / size / mut / q / grade / power)
function team.ownedPower(item: any): number?
	local tier = team.tierOf(item)
	local value = tier and team.powerOf(tier, team.gradeMult(item.grade), item.size, item.mut, item.q)
	return value or tonumber(item.power)
end

-- ช่องทำงาน = ประตูเหมืองของเราที่ปลดล็อกแล้ว (miner ที่วางที่ประตูเท่านั้นที่ขุดจริง ประตูละ 1 ตัว)
function team.slots(): number
	local plot = plotId()
	local ok, doors = pcall(CollectionService.GetTagged, CollectionService, "MineDoor")
	local count = 0
	if ok and plot ~= nil then
		for _, door in doors do
			if tostring(door:GetAttribute("Mine")) == tostring(plot) and door:GetAttribute("Locked") ~= true then
				count += 1
			end
		end
	end
	return count
end

-- สรุปทีม (N = จำนวนประตู): เกณฑ์ = แรงของตัวที่อ่อนสุดใน N ตัวแรก (0 = ประตูยังว่าง ตัวไหนก็ช่วย),
-- จำนวนช่อง, แรงรวมของทีม, แรงของตัวสำรองที่ดีที่สุด (นอนในกระเป๋า) · เกณฑ์เป็น nil = ยังไม่มีข้อมูลกระเป๋า
function team.summary(): (number?, number, number, number)
	local list = bag.list
	if type(list) ~= "table" then
		return nil, 0, 0, 0
	end
	local slots = team.slots()
	local working = 0
	local powers = {}
	for _, item in list do
		if type(item) == "table" and item.id ~= nil then
			if item.door ~= nil then
				working += 1
			end
			local value = team.ownedPower(item)
			if value then
				table.insert(powers, value)
			end
		end
	end
	slots = math.max(slots, working)
	if slots == 0 then
		return nil, 0, 0, 0
	end
	table.sort(powers, function(a, b)
		return a > b
	end)
	local total = 0
	for index = 1, math.min(slots, #powers) do
		total += powers[index]
	end
	return (if #powers >= slots then powers[slots] else 0), slots, total, powers[slots + 1] or 0
end

