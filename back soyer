-- เหตุการณ์สำคัญ (ได้ miner หายาก / เข้า Index ใหม่ / อัพเกรดใหญ่ / หลุดเกม): โชว์บนจอ AFK + ส่งเข้า Discord ถ้าตั้งไว้
type AlertItem = { title: string, text: string, color: Color3, at: number }
local recentEvents: { AlertItem } = {}
local alertQueue: { AlertItem } = {}
local function alert(title: string, textValue: string, color: Color3?)
	local item = { title = title, text = textValue, color = color or Theme.accent, at = os.time() }
	table.insert(recentEvents, 1, item)
	while #recentEvents > 6 do
		table.remove(recentEvents)
	end
	table.insert(alertQueue, item)
	while #alertQueue > 20 do
		table.remove(alertQueue, 1)
	end
end

