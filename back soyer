function setup.refresh()
	local function weatherText(): string
		local key = ReplicatedStorage:GetAttribute("Weather")
		local left = num(ReplicatedStorage:GetAttribute("WeatherEnds")) - workspace:GetServerTimeNow()
		if type(key) ~= "string" or key == "" or left <= 0 then
			return "อากาศปกติ"
		end
		local def = WeatherInfo and WeatherInfo.BY_KEY and WeatherInfo.BY_KEY[key]
		local mutation = def and def.mut
		return string.format(
			"%s %s%s",
			(def and def.name) or key,
			fmtTime(left),
			if mutation then string.format(" (mutation %s x%d)", mutation, (WeatherInfo and WeatherInfo.BOOST) or 10) else ""
		)
	end

	task.spawn(function()
		while running do
			pcall(function()
				stats.cash.Text = fmtCash(cash())
				stats.earned.Text = "+" .. fmtCash(session.earned)
				stats.rate.Text = fmtCash(ratePerMinute())
				stats.uptime.Text = fmtTime(os.clock() - session.start)
				infoLine.Text = string.format(
					"PLOT %s  ·  รายได้ตามเกม %s/นาที  ·  ใช้ไป %s  ·  %s%s",
					tostring(plotId() or "?"),
					fmtCash(pAttr("IncomePerMin") or 0),
					fmtCash(session.spent),
					weatherText(),
					if paused then "  ·  หยุดอยู่" else ""
				)
				-- กราฟแท่งในช่อง RATE + จุดสถานะ (เขียว = ทำงาน / ส้ม = หยุดอยู่) + ปุ่มลัดที่ท้ายแถบแท็บ
				local values = sparkValues(#stats.spark)
				for index, bar in stats.spark do
					bar.Size = UDim2.new(1 / #stats.spark, -1, math.max(values[index], 0.1), 0)
					bar.BackgroundTransparency = if index == #stats.spark then 0 else 0.35
				end
				stats.dot.BackgroundColor3 = if paused then Theme.accent else Theme.good
				stats.hint.Text = config.uiKey .. "  ·  ซ่อน/แสดง"
			end)
			for name, refresh in refreshers do
				local page = pages[name]
				if page and page.Visible then
					pcall(refresh)
				end
			end
			task.wait(0.5)
		end
	end)
end
setup.refresh()

