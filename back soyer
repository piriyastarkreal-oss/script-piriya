-- ทำงานที่ต้องวาป: กล้องค้างไว้ที่เดิม เสร็จแล้ววาปกลับ (แม้ error ระหว่างทาง)
local function withHops(activity: string, fn: ((CFrame?) -> boolean) -> ()): boolean
	local waited = os.clock()
	while hopBusy and running do
		task.wait(0.05)
		if os.clock() - waited > 30 then
			return false
		end
	end
	hopBusy = true
	setActivity(activity)
	local camera = workspace.CurrentCamera
	local origin: CFrame? = nil
	local oldCameraType: Enum.CameraType? = nil

	local function hopTo(target: CFrame?): boolean
		if not (target and config.quickTp) then
			return false
		end
		local root = getRoot()
		if not root then
			return false
		end
		if not origin then
			origin = root.CFrame
			if camera then
				oldCameraType = camera.CameraType
				camera.CameraType = Enum.CameraType.Scriptable
			end
		end
		moveTo(target)
		task.wait(config.hopWait)
		return true
	end

	local ok, err = pcall(fn, hopTo)
	if origin then
		if config.returnHome then
			moveTo(origin)
		end
		if camera and oldCameraType then
			camera.CameraType = oldCameraType
		end
	end
	hopBusy = false
	setActivity(nil)
	if not ok then
		error(err, 0)
	end
	return true
end

local function firePrompt(prompt: ProximityPrompt): boolean
