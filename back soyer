		local function updateAfkScreen()
			local minersHave, minersTotal, petsHave, petsTotal, sets = indexProgress()
			local rate = ratePerMinute()
			afkCash.Text = fmtCash(cash())
			afkIncome.Text = string.format(
				"+%s ในรอบนี้  ·  %s/ชม.  ·  เปิดมา %s%s",
				fmtCash(session.earned),
				fmtCash(rate * 60),
