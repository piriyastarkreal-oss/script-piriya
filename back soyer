local upgradeOn = false
local mineValue, quarryValue = nil, nil

-- หา object ที่มี attribute นี้และอยู่ใกล้ตัวที่สุด (ป้ายของบ้านเรา)
local function findNearestAttribute(attr: string): any
	local root = getRoot()
	local best, bestDist = nil, math.huge
	for _, obj in workspace:GetDescendants() do
		local value = obj:GetAttribute(attr)
		if value ~= nil then
			local pos = getPosition(obj)
			local dist = if root and pos then (pos - root.Position).Magnitude else 1e9
			if dist < bestDist then
				best, bestDist = value, dist
			end
		end
	end
	return best
end

local function tryUpgrade(remoteName: string, arg: any, levelAttr: string): boolean
	local before = localPlayer:GetAttribute(levelAttr)
	fireRemote(remoteName, arg)
	task.wait(0.15)
	return localPlayer:GetAttribute(levelAttr) ~= before
end

local function upgradeCycle()
	local bought = {}
	local cashBefore = getCash()

	for _, stat in STAT_UPGRADES do
		if tryUpgrade("StatUpgradeRequest", stat, stat) then
			table.insert(bought, string.format("%s Lv.%s", (stat:gsub("^Up_", "")), tostring(localPlayer:GetAttribute(stat))))
		end
	end
	if UPGRADE_MINE then
		mineValue = if mineValue ~= nil then mineValue else findNearestAttribute("Mine")
		if mineValue ~= nil and tryUpgrade("MineUpgradeRequest", mineValue, "PyramidLevel") then
			table.insert(bought, "Mine")
		end
	end
	if UPGRADE_QUARRY then
		quarryValue = if quarryValue ~= nil then quarryValue else findNearestAttribute("Quarry")
		if quarryValue ~= nil and tryUpgrade("QuarryUpgradeRequest", quarryValue, "QuarryLevel") then
			table.insert(bought, "Quarry")
		end
	end

	upgradeRow.status.Text = if #bought > 0
		then string.format("ซื้อ %s ($%d → $%d)", table.concat(bought, ", "), cashBefore, getCash())
		else string.format("รอเงิน ($%d)", getCash())
end

local function setUpgrade(on: boolean)
	upgradeOn = on
	if on then
		mineValue = findNearestAttribute("Mine")
		quarryValue = findNearestAttribute("Quarry")
	end
	upgradeRow.paint(on)
end

startLoop(UPGRADE_INTERVAL, function()
	return upgradeOn
end, upgradeCycle, upgradeRow.status)

