	stepperRow(farmPage, "hopWait", "รอหลังวาป", "รอให้เซิร์ฟเวอร์เห็นตำแหน่งใหม่ก่อนกด ถ้ากดไม่ค่อยติดให้เพิ่ม", 0.1, 1.5, 0.05, function(value)
		return string.format("%.2f วิ", value)
	end)
