-- ความคืบหน้า Index: miner มี/ทั้งหมด, สัตว์ มี/ทั้งหมด, จำนวนชุดที่ครบ (ชุดละ +3%)
local function indexProgress(): (number, number, number, number, number)
	local indexed, indexedPets = indexSets()
	local pool = minerPool()
	local minersHave, minersTotal, petsHave, petsTotal, sets = 0, 0, 0, 0, 0
	for _, rarityName in RARITY_NAMES do
		local names = pool[rarityName]
		if names and #names > 0 then
			local have = 0
			for _, name in names do
				if indexed[name] then
					have += 1
				end
			end
			minersHave += have
			minersTotal += #names
			if have == #names then
				sets += 1
			end
		end
	end
	for _, block in (PetCatalog and PetCatalog.BLOCKS) or {} do
		local pets = block.pets or {}
		local have = 0
		for _, pet in pets do
			if indexedPets[pet.id] then
				have += 1
			end
		end
		petsHave += have
		petsTotal += #pets
		if #pets > 0 and have == #pets then
			sets += 1
		end
	end
	return minersHave, minersTotal, petsHave, petsTotal, sets
end

-- เวลาแบบสั้น: 45 วินาที / 2 นาที / 2:30 นาที
local function fmtDuration(seconds: number): string
	if seconds < 60 then
		return seconds .. " วินาที"
	end
	local minutes, rest = seconds // 60, seconds % 60
	return if rest == 0 then minutes .. " นาที" else string.format("%d:%02d นาที", minutes, rest)
end

