	-- ส่งเรื่องสำคัญทีละอัน (Discord จำกัดความถี่) + สรุปเป็นรอบ
	task.spawn(function()
		local lastReportAt = os.clock()
		while running do
			task.wait(2)
			if not (httpRequest and validWebhook(config.webhookUrl)) then
				table.clear(alertQueue)
				lastReportAt = os.clock()
				continue
			end
			local item = table.remove(alertQueue, 1)
			if item and config.webhookAlerts then
				local ok, err = postWebhook(embed(item.title, item.text, item.color))
				if not ok then
					webhookRow.setStatus("ส่งแจ้งเตือนไม่สำเร็จ: " .. tostring(err), Theme.bad)
				end
			elseif config.webhookEvery > 0 and os.clock() - lastReportAt >= config.webhookEvery * 60 then
				lastReportAt = os.clock()
				local ok, err = postWebhook(summaryPayload("📊 สรุปความคืบหน้า"))
				webhookRow.setStatus(if ok then "ส่งสรุปล่าสุด " .. os.date("%H:%M:%S") else "ส่งสรุปไม่สำเร็จ: " .. tostring(err), if ok then Theme.sub else Theme.bad)
			end
		end
	end)

