			setAfkScreen(false)
		end)
		connect(UserInputService.InputBegan, function()
			if os.clock() < ignoreInputUntil then
				return
			end
			userActive()
			if afkShown and os.clock() - afkShownAt > 0.5 then
				setAfkScreen(false)
			end
		end)
		connect(UserInputService.InputChanged, function(input)
			if os.clock() < ignoreInputUntil then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				userActive()
				-- จอที่ขึ้นเองปิดเมื่อขยับเมาส์ / จอที่กดเปิดเองปิดเมื่อกดปุ่มหรือคลิกเท่านั้น
				if afkShown and afkAuto and os.clock() - afkShownAt > 1.5 then
					setAfkScreen(false)
				end
			end
		end)
		task.spawn(function()
			while running do
				-- ไม่ได้แตะเครื่อง 10 นาที: จำภาพรวมไว้ทำสรุปตอนกลับมา (บันทึกลงไฟล์ ไม่หายตอนเข้าเซิร์ฟใหม่)
				local idle = os.clock() - lastInputAt
				if idle > 600 and run.away == nil then
					local totals = run.totals()
					run.away = {
						at = os.time() - math.floor(idle),
						earned = totals.earned,
						miners = totals.miners,
						upgrades = totals.upgrades,
						indexNew = totals.indexNew,
						hatched = totals.hatched,
						rejoins = run.rejoins,
					}
					run.save()
				end
				if afkShown then
					pcall(updateAfkScreen)
				elseif config.afkScreenAuto and os.clock() - lastInputAt > config.afkScreenIdle * 60 then
					setAfkScreen(true, true)
					pcall(updateAfkScreen)
				end
				task.wait(0.5)
			end
		end)
	end
