-- 15) PETS: ฟักไข่ / วางไข่ / ซื้อไข่ / ปลดล็อกฟาร์ม
---------------------------------------------------------------------
function setup.pets()
	local petPage = pages.Pets

	section(petPage, "ฟาร์มสัตว์", "ฟาร์มเปิดที่ Quarry Lv2 ไข่ซื้อได้ที่ Pet Shop ในเมือง สัตว์ช่วยเพิ่มรายได้")
	local petCard = liveCard(petPage)
	local hatchRow = toggleRow(petPage, "autoHatch", "Auto Hatch", "ฟักไข่ที่ครบเวลา แล้ววางไข่ที่ดีที่สุดลงตู้ที่ว่างให้")
	local eggRow = toggleRow(petPage, "buyEggs", "ซื้อไข่อัตโนมัติ", "ซื้อไข่ระดับสูงสุดที่ปลดล็อกแล้วและมีของในร้าน")
	stepperRow(petPage, "eggMaxSpendPct", "ใช้เงินซื้อไข่ไม่เกิน", "ต่อฟอง เทียบกับเงินที่มี", 5, 100, 5, function(value)
		return value .. "%"
	end)
	toggleRow(petPage, "petEquipBest", "Equip Best (สัตว์)", "ใส่สัตว์ที่ดีที่สุดให้หลังฟัก และทุก 1 นาที")
	local farmUnlockRow = toggleRow(petPage, "unlockFarm", "ปลดล็อกฟาร์มให้เอง", "เมื่อ Quarry ถึง Lv2 และมีเงินพอ ($5K)")

	local function incubators(farm: Instance?)
		local list = {}
		local folder = farm and farm:FindFirstChild("Incubators")
		if folder then
			for _, model in folder:GetChildren() do
				local base = model:FindFirstChild("Incubator")
				if base and base:IsA("BasePart") then
					table.insert(list, {
						base = base,
						index = base:GetAttribute("Index"),
						egg = base:GetAttribute("Egg") or "",
						doneAt = num(base:GetAttribute("DoneAt")),
					})
				end
			end
		end
		return list
	end

	-- ไข่ชนิดนี้ยังมีสัตว์ที่ไม่มีใน Index ไหม
	local function eggHasMissingPet(eggKey: string, indexedPets: { [string]: boolean }): boolean
		local def = PetCatalog and PetCatalog.BY_KEY and PetCatalog.BY_KEY[eggKey]
		if not (def and def.pets) then
			return false
		end
		for _, pet in def.pets do
			if not indexedPets[pet.id] then
				return true
			end
		end
		return false
	end

	-- ไข่ที่มี: attribute Eggs = {ชื่อไข่: จำนวน} เลือกไข่ที่ยังมีสัตว์ขาดใน Index ก่อน แล้วค่อยระดับสูงสุด
	local function bestOwnedEgg(): string?
		local _, indexedPets = indexSets()
		local best, bestScore = nil, -1
		for key, value in decode(pAttr("Eggs")) do
			local eggKey, count = key, value
			if type(value) == "string" then
				eggKey, count = value, 1
			end
			if type(eggKey) == "string" and num(count) > 0 then
				local def = PetCatalog and PetCatalog.BY_KEY and PetCatalog.BY_KEY[eggKey]
				local score = (def and def.tier) or 0
				if config.indexPets and eggHasMissingPet(eggKey, indexedPets) then
					score += 100
				end
				if score > bestScore then
					best, bestScore = eggKey, score
				end
			end
		end
		return best
	end

	local function petName(id: any): string
		local def = PetCatalog and PetCatalog.BY_ID and PetCatalog.BY_ID[id]
		return (def and def.name) or tostring(id)
	end

	local function hatchCycle()
		local farm = myFarm()
		if not farm then
			hatchRow.setStatus("ยังไม่มีฟาร์ม (เปิดที่ Quarry Lv2)", Theme.sub)
			return
		end
		local now = workspace:GetServerTimeNow()
		local list = incubators(farm)
		if #list == 0 then
			hatchRow.setStatus("ยังไม่มีตู้ฟักไข่", Theme.sub)
			return
		end
		local _, indexedPets = indexSets()
		local busy, empty = 0, 0
		for _, incubator in list do
			if incubator.egg ~= "" and incubator.doneAt <= now then
				local ok, result = invoke("FarmHatch", 8, incubator.index)
				if not (ok and type(result) == "table" and result.ok) then
					withHops("Pets: ฟักไข่", function(hopTo)
						hopTo(CFrame.new(incubator.base.Position + Vector3.new(0, 4, 0)))
						ok, result = invoke("FarmHatch", 8, incubator.index)
					end)
				end
				if ok and type(result) == "table" and result.ok then
					counters.hatched += 1
					local isNew = not indexedPets[result.pet]
					if isNew then
						counters.indexNew += 1
					end
					local newText = if isNew then "  · ใหม่ใน Index" else ""
					log("good", "ฟักไข่ได้ " .. petName(result.pet) .. newText)
					toast("ฟักได้ " .. petName(result.pet) .. newText, Theme.good)
					if isNew then
						alert("🐣 ได้สัตว์ใหม่เข้า Index", petName(result.pet), Theme.good)
					end
					if config.petEquipBest then
						task.delay(1, function()
							fire("BagAction", "petEquipBest")
						end)
					end
				end
			elseif incubator.egg == "" then
				empty += 1
				local egg = bestOwnedEgg()
				local coolKey = "place" .. tostring(incubator.index)
				if egg and not cooling(coolKey) then
					fire("FarmAction", "place", incubator.index, egg)
					local placed = waitFor(function()
						return (incubator.base:GetAttribute("Egg") or "") ~= ""
					end, 1)
					if not placed then
						withHops("Pets: วางไข่", function(hopTo)
							hopTo(CFrame.new(incubator.base.Position + Vector3.new(0, 4, 0)))
							fire("FarmAction", "place", incubator.index, egg)
							placed = waitFor(function()
								return (incubator.base:GetAttribute("Egg") or "") ~= ""
							end, 1.2)
						end)
					end
					if placed then
						log("info", "วางไข่ " .. egg .. " ในตู้ " .. tostring(incubator.index))
					else
						cool(coolKey, 30)
					end
				end
			else
				busy += 1
			end
		end
		hatchRow.setStatus(string.format("ตู้ฟัก %d ตู้ · กำลังฟัก %d · ว่าง %d · ฟักไปแล้ว %d ตัว", #list, busy, empty, counters.hatched))
	end
	startLoop("Auto Hatch", "autoHatch", 3, hatchRow, hatchCycle)

	startLoop("Unlock Farm", "unlockFarm", 15, farmUnlockRow, function()
		local farm = myFarm()
		if not farm then
			return
		end
		-- ฟาร์มที่ยังไม่ได้ซื้อจะมีป้าย ForSale อยู่
		if farm:FindFirstChild("ForSale", true) == nil then
			farmUnlockRow.setStatus("ปลดล็อกฟาร์มแล้ว", Theme.good)
			return
		end
		local price = (PetFarm and PetFarm.UNLOCK_PRICE) or 5000
		if num(pAttr("QuarryLevel")) < 2 then
			farmUnlockRow.setStatus("ต้องการ Quarry Lv2 ก่อน", Theme.sub)
		elseif cash() < price then
			farmUnlockRow.setStatus("รอเงิน " .. fmtCash(price), Theme.sub)
		elseif not cooling("unlockFarm") then
			cool("unlockFarm", 60)
			fire("FarmAction", "unlock")
			if waitFor(function()
				return farm:FindFirstChild("ForSale", true) == nil
			end, 3) then
				log("buy", "ปลดล็อกฟาร์มสัตว์ (" .. fmtCash(price) .. ")")
				toast("ปลดล็อกฟาร์มสัตว์แล้ว", Theme.good)
			else
				farmUnlockRow.setStatus("ส่งคำขอปลดล็อกแล้วแต่ยังไม่เปลี่ยน จะลองใหม่ใน 1 นาที", Theme.bad)
			end
		end
	end)

	startLoop("Buy Eggs", "buyEggs", 12, eggRow, function()
		if not PetCatalog then
			eggRow.setStatus("โหลดข้อมูลไข่ของเกมไม่ได้", Theme.bad)
			return
		end
		local quarry = num(pAttr("QuarryLevel"))
		if quarry < 2 then
			eggRow.setStatus("Pet Shop เปิดที่ Quarry Lv2", Theme.sub)
			return
		end
		if num(pAttr("EggCount")) >= num(pAttr("EggCap"), PetCatalog.EGG_CAP or 50) then
			eggRow.setStatus("ช่องเก็บไข่เต็ม", Theme.sub)
			return
		end
		local shop = hubProp("PetShop")
		if not shop then
			return
		end
		local stock = decode(shop:GetAttribute("PetStock"))
		local money = cash()
		local _, indexedPets = indexSets()
		local best = nil
		for _, block in PetCatalog.BLOCKS or {} do
			local entry = stock[block.key]
			local left = if type(entry) == "table" then num(entry[1]) else 0
			if left > 0 and PetCatalog.unlocked(block.key, quarry) then
				local price = PetCatalog.price(block.key)
				-- ไข่ที่ยังมีสัตว์ขาดใน Index มาก่อน (เลือกถูกสุด จะได้ฟักได้หลายรอบ) ไม่งั้นเอาระดับสูงสุด
				local forIndex = config.indexPets and eggHasMissingPet(block.key, indexedPets)
				local score = if forIndex then 1000 - block.tier else block.tier
				if price <= money * config.eggMaxSpendPct / 100 and (not best or score > best.score) then
					best = { key = block.key, tier = block.tier, price = price, name = block.name, score = score, forIndex = forIndex }
				end
			end
		end
		if not best then
			eggRow.setStatus("ไม่มีไข่ที่ซื้อได้ตอนนี้ (หมด / แพงเกินที่ตั้งไว้)", Theme.sub)
			return
		end
		withHops("Pets: ซื้อ " .. best.name, function(hopTo)
			hopTo(hubSpot("PetShop", "OpenPetShop"))
			local ok, result = invoke("PetShopBuy", 8, best.key)
			if ok and type(result) == "table" and result.ok then
				counters.eggsBought += 1
				log("buy", string.format("ซื้อ %s (%s)%s", best.name, fmtCash(best.price), if best.forIndex then " เพื่อ Index" else ""))
				eggRow.setStatus("ซื้อ " .. best.name .. " · " .. os.date("%H:%M:%S"), Theme.good)
			end
		end)
	end)

	refreshers.Pets = function()
		local eggs = {}
		for key, value in decode(pAttr("Eggs")) do
			if type(key) == "string" and num(value) > 0 then
				table.insert(eggs, key .. " x" .. math.floor(num(value)))
			end
		end
		local lines = {
			kv(
				"EGGS ",
				string.format(
					"%s  <font face=\"RobotoMono\" color=\"%s\">%d/%d</font>",
					if #eggs > 0 then escapeRich(table.concat(eggs, ", ")) else "ไม่มี",
					colorHex(Theme.sub),
					num(pAttr("EggCount")),
					num(pAttr("EggCap"), 50)
				)
			),
			kv("PETS ", string.format("%d/%d · ตัวคูณสัตว์ x%s", num(pAttr("PetCount")), num(pAttr("PetCap"), 50), tostring(pAttr("PetMult") or 1))),
		}
		local farm = myFarm()
		if farm then
			local now = workspace:GetServerTimeNow()
			for _, incubator in incubators(farm) do
				local state
				if incubator.egg == "" then
					state = string.format("<font color=\"%s\">ว่าง</font>", colorHex(Theme.sub))
				elseif incubator.doneAt <= now then
					state = string.format("%s  <font color=\"%s\">ฟักได้แล้ว</font>", escapeRich(incubator.egg), colorHex(Theme.good))
				else
					state = string.format("%s  <font face=\"RobotoMono\" color=\"%s\">%s</font>", escapeRich(incubator.egg), colorHex(Theme.sub), fmtTime(incubator.doneAt - now))
				end
				table.insert(lines, kv(string.format("INC%-2s", tostring(incubator.index)), state))
			end
		else
			table.insert(lines, kv("FARM ", "ยังไม่มีฟาร์ม (เปิดที่ Quarry Lv2)"))
		end
		petCard.Text = table.concat(lines, "\n")
	end
end
setup.pets()

---------------------------------------------------------------------
-- 16) REWARDS: Daily / Quest / Spin / Group / ยา / ร้านทั่วไป / กล่อง Robux
---------------------------------------------------------------------
function setup.rewards()
	local rewardPage = pages.Rewards

	section(rewardPage, "รางวัล", "รับของฟรีทุกอย่างที่เกมให้ ร้านในเมืองต้องวาปไป สคริปต์จะไปแล้วกลับให้เอง")
	local questCard = liveCard(rewardPage)
	local dailyRow = toggleRow(rewardPage, "daily", "Daily Reward", "รับรางวัลรายวันเมื่อพร้อม")
	local questRow = toggleRow(rewardPage, "quests", "Quests", "รับรางวัลเควสที่ทำครบ + โบนัสเมื่อครบทุกเควส (วาปไป Quest Giver)")
	local spinRow = toggleRow(rewardPage, "spin", "Lucky Spin", "หมุนฟรีวันละครั้ง + ใช้ตั๋วหมุนที่มี (วาปไปวงล้อ)")
	local groupRow = toggleRow(rewardPage, "groupReward", "Group Reward", "กดรับรางวัลกลุ่ม (ต้องอยู่ในกลุ่มเกมแล้ว)")
	local rxRow = toggleRow(rewardPage, "openRx", "เปิดกล่อง/ไข่ Robux ที่มีอยู่", "ถ้ามี Robux Crate / Robux Egg ในกระเป๋า (เช่นจากรางวัล) จะเปิดให้")

	section(rewardPage, "ยา (Potions)")
	local drinkRow = toggleRow(rewardPage, "drinkPotions", "ดื่มยาอัตโนมัติ", "Money → Luck → Mining ดื่มต่อทันทีเมื่อหมดเวลา (ใช้ขวดใหญ่ก่อน)")
	toggleRow(rewardPage, "drinkSpeed", "ดื่มยา Speed ด้วย", "ไม่ช่วยตอน AFK")
	local potionBuyRow = toggleRow(
		rewardPage,
		"buyPotions",
		"ซื้อยาด้วยเงินในเกม",
		"ร้านยา (เปิดที่ Pyramid Lv3) ขายด้วยเงินในเกมเมื่อมีของ ยา Money x2 คุ้มเสมอ: จ่าย 2 นาทีของรายได้ ได้ x2 นาน 5 นาที"
	)
	stepperRow(rewardPage, "potionMaxSpendPct", "ใช้เงินซื้อยาไม่เกิน", "ต่อขวด เทียบกับเงินที่มี", 5, 100, 5, function(value)
		return value .. "%"
	end)
	local storeRow = toggleRow(rewardPage, "storePotions", "Mystery / Rare Potion (General Store)", "ร้านทั่วไปขายวันละ 3 ขวดต่ออย่าง ราคาถูก")
	toggleRow(rewardPage, "spinTickets", "ซื้อตั๋วหมุนด้วยเงินในเกม", "ราคาขึ้นตามรายได้ ปิดไว้เพื่อประหยัดเงิน")

	local groupDone = false
	local lastSpinAt = 0
	local lastRxAt = 0
	local lastStoreAt = 0

	local function questData()
		local data = decode(pAttr("Quests"))
		return data, (type(data.list) == "table" and data.list) or {}
	end

	local function potionTypes(): { string }
		local types = { "Money", "Luck", "Mining" }
		if config.drinkSpeed then
			table.insert(types, "Speed")
		end
		return types
	end

	local function claimDaily()
		if pAttr("DailyReady") ~= true then
			dailyRow.setStatus("รับแล้ววันนี้ · พรุ่งนี้มาใหม่", Theme.sub)
			return
		end
		if cooling("daily") then
			return
		end
		cool("daily", 20)
		local day = num(pAttr("DailyDay"), 1)
		local ok = invoke("DailyClaim", 10)
		if ok and pAttr("DailyReady") ~= true then
			log("good", "รับ Daily Reward วันที่ " .. day)
			toast("รับ Daily วันที่ " .. day, Theme.good)
			dailyRow.setStatus("รับวันที่ " .. day .. " แล้ว", Theme.good)
		end
	end

	local function claimGroup()
		groupDone = true
		if pAttr("InGroup") == true then
			fire("GroupReward", "check")
			task.wait(1.5)
			fire("GroupReward", "claim")
			groupRow.setStatus("ส่งคำขอรับรางวัลกลุ่มแล้ว", Theme.good)
		else
			groupRow.setStatus("ยังไม่ได้อยู่ในกลุ่มเกม", Theme.sub)
		end
	end

	local function claimQuests()
		local data, list = questData()
		local claimable, unclaimed = {}, 0
		for index, quest in ipairs(list) do
			if not quest.claimed then
				unclaimed += 1
				if num(quest.prog) >= num(quest.goal, math.huge) then
					table.insert(claimable, index)
				end
			end
		end
		local needBonus = #list > 0 and unclaimed == 0 and not data.bonus
		local bonusAfter = #claimable > 0 and #claimable == unclaimed and not data.bonus
		if #claimable == 0 and not needBonus then
			return
		end
		cool("quests", 15)
		withHops("Rewards: รับเควส", function(hopTo)
			hopTo(hubSpot("QuestShop", "OpenQuests"))
			for _, index in claimable do
				fire("QuestAction", "claim", index)
				task.wait(0.4)
			end
			if needBonus or bonusAfter then
				task.wait(0.5)
				fire("QuestAction", "bonus")
			end
			task.wait(0.4)
		end)
		local _, after = questData()
		local claimedNow = 0
		for _, index in claimable do
			if after[index] and after[index].claimed then
				claimedNow += 1
			end
		end
		if claimedNow > 0 then
			counters.quests += claimedNow
			log("good", "รับรางวัลเควส " .. claimedNow .. " อัน")
			toast("รับรางวัลเควส " .. claimedNow .. " อัน", Theme.good)
		end
		questRow.setStatus(string.format("รับไปแล้ว %d อันในรอบนี้", counters.quests), Theme.good)
	end

	-- Lucky Spin: ฟรีวันละครั้ง + ตั๋ว (เช็คว่าหมุนจริงจาก attribute ก่อนนับ)
	local function doSpin()
		local now = workspace:GetServerTimeNow()
		local freeDay = num(pAttr("SpinFreeDay"))
		local free = SpinWheel ~= nil and freeDay < SpinWheel.day(now)
		local tickets = num(pAttr("SpinTickets"))
		if not free and tickets <= 0 then
			spinRow.setStatus("หมุนฟรีวันนี้แล้ว · ไม่มีตั๋ว", Theme.sub)
			return
		end
		local useTen = not free and tickets >= 10
		local spun = false
		withHops("Rewards: หมุนวงล้อ", function(hopTo)
			hopTo(hubSpot("LuckySpin", "OpenSpin"))
			fire("SpinAction", if useTen then "spin10" else "spin")
			spun = waitFor(function()
				return num(pAttr("SpinFreeDay")) ~= freeDay or num(pAttr("SpinTickets")) ~= tickets
			end, 2.5)
		end)
		lastSpinAt = os.clock()
		if spun then
			local used = if useTen then 10 else 1
			counters.spins += if free then 1 else used
			log("good", if free then "หมุนวงล้อฟรีประจำวัน" else string.format("ใช้ตั๋วหมุน %d ใบ", used))
			spinRow.setStatus(string.format("หมุนไปแล้ว %d ครั้ง · ตั๋วเหลือ %d", counters.spins, num(pAttr("SpinTickets"))), Theme.good)
		else
			cool("spin", 60)
			spinRow.setStatus("หมุนไม่สำเร็จ จะลองใหม่ใน 1 นาที", Theme.bad)
		end
	end

	-- ดื่มยา: inv = {id: จำนวน}, active = {ชนิด: เวลาหมด (unix)}
	local function drinkPotions()
		local potionData = decode(pAttr("Potions"))
		local inv = (type(potionData.inv) == "table" and potionData.inv) or {}
		local active = (type(potionData.active) == "table" and potionData.active) or {}
		local nowUnix = os.time()
		local types = potionTypes()
		local activeText = {}
		for _, potionType in types do
			local left = num(active[potionType]) - nowUnix
			if left > 0 then
				table.insert(activeText, potionType .. " " .. fmtTime(left))
			end
		end
		for _, potionType in types do
			if num(active[potionType]) - nowUnix < 15 then
				local pick = nil
				for _, size in { "Mega", "Big", "Small" } do
					if num(inv[potionType .. "_" .. size]) > 0 then
						pick = potionType .. "_" .. size
						break
					end
				end
				if not pick and num(inv.Super) > 0 then
					pick = "Super"
				end
				if pick and not cooling("drink" .. pick) then
					cool("drink" .. pick, 10)
					fire("PotionAction", "drink", pick)
					counters.potions += 1
					local def = Potions.BY_ID and Potions.BY_ID[pick]
					log("good", "ดื่ม " .. ((def and def.name) or pick))
					return
				end
			end
		end
		drinkRow.setStatus(if #activeText > 0 then "ทำงานอยู่: " .. table.concat(activeText, " · ") else "ไม่มียาที่ทำงานอยู่ / ไม่มียาในกระเป๋า", Theme.sub)
	end

	-- ซื้อยาด้วยเงินในเกมที่ร้านยาในเมือง (มีไว้ไม่เกิน 2 ขวดต่อชนิด)
	local function buyPotions()
		local shop = hubProp("PotionShop")
		if num(pAttr("PyramidLevel")) < 3 then
			potionBuyRow.setStatus("ร้านยาเปิดที่ Pyramid Lv3 (Expand the Mine)", Theme.sub)
			return
		end
		if not shop then
			return
		end
		local stock = decode(shop:GetAttribute("PotionStock"))
		local inv = decode(pAttr("Potions")).inv or {}
		local income = num(pAttr("IncomePerMin"), 30)
		local budget = cash()
		local wanted = {}
		for _, potionType in potionTypes() do
			local owned = 0
			for _, size in { "Small", "Big", "Mega" } do
				owned += num(inv[potionType .. "_" .. size])
			end
			if owned < 2 then
				for _, size in { "Mega", "Big", "Small" } do
					local id = potionType .. "_" .. size
					local entry = stock[id]
					local left = if type(entry) == "table" then num(entry[1]) else 0
					local item = Potions.BY_ID[id]
					if left > 0 and item then
						local ok, price = pcall(Potions.price, item, income, false)
						if ok and type(price) == "number" and price <= budget * config.potionMaxSpendPct / 100 then
							table.insert(wanted, { id = id, price = price, name = item.name })
							budget -= price
							break
						end
					end
				end
			end
		end
		if #wanted == 0 then
			potionBuyRow.setStatus("ไม่มียาที่ต้องซื้อตอนนี้ (มีพอแล้ว / ร้านหมด)", Theme.sub)
			return
		end
		cool("buyPotions", 20)
		withHops("Rewards: ซื้อยา", function(hopTo)
			hopTo(hubSpot("PotionShop", "OpenPotions"))
			for _, potion in wanted do
				fire("PotionAction", "buy", potion.id)
				task.wait(0.4)
			end
			task.wait(0.6)
		end)
		local after = decode(pAttr("Potions")).inv or {}
		local bought = 0
		for _, potion in wanted do
			if num(after[potion.id]) > num(inv[potion.id]) then
				bought += 1
				log("buy", string.format("ซื้อ %s (%s)", potion.name, fmtCash(potion.price)))
			end
		end
		if bought > 0 then
			potionBuyRow.setStatus(string.format("ซื้อยา %d ขวด · %s", bought, os.date("%H:%M:%S")), Theme.good)
		else
			cool("buyPotions", 120)
			potionBuyRow.setStatus("ซื้อไม่สำเร็จ (ร้านอาจหมดก่อน) จะลองใหม่ใน 2 นาที", Theme.bad)
		end
	end

	-- General Store: Mystery / Rare Potion วันละ 3 + ตั๋วหมุน
	local function storeBuys()
		lastStoreAt = os.clock()
		local today = math.floor(os.time() / 86400)
		local function boughtToday(id: string): number
			local dayData = decode(pAttr("StoreDay"))
			return if dayData.day == today then num(dayData[id]) else 0
		end
		local income = num(pAttr("IncomePerMin"), 30)
		local budget = cash()
		local items = {}
		if config.storePotions and num(pAttr("PyramidLevel")) >= 3 then
			for _, id in { "MysteryPotion", "RarePotion" } do
				local item = GeneralStore.BY_ID[id]
				if item and boughtToday(id) < num(item.daily) then
					local ok, price = pcall(GeneralStore.price, item, 0, income)
					if ok and type(price) == "number" and price <= budget * 0.25 then
						table.insert(items, { id = id, name = item.name, price = price, before = boughtToday(id) })
						budget -= price
					end
				end
			end
		end
		if config.spinTickets then
			local item = GeneralStore.BY_ID.SpinTicket
			if item then
				local ok, price = pcall(GeneralStore.price, item, 0, income)
				if ok and type(price) == "number" and price <= budget * 0.15 then
					table.insert(items, { id = "SpinTicket", name = item.name, price = price, before = num(pAttr("SpinTickets")) })
				end
			end
		end
		if #items == 0 then
			return
		end
		withHops("Rewards: ร้านทั่วไป", function(hopTo)
			hopTo(hubSpot("GeneralShop", "OpenStore"))
			for _, item in items do
				fire("StoreAction", "buy", item.id)
				task.wait(0.4)
			end
			task.wait(0.6)
		end)
		local bought = 0
		for _, item in items do
			local now = if item.id == "SpinTicket" then num(pAttr("SpinTickets")) else boughtToday(item.id)
			if now > item.before then
				bought += 1
				log("buy", string.format("ซื้อ %s (%s)", item.name, fmtCash(item.price)))
			end
		end
		storeRow.setStatus(
			if bought > 0 then string.format("ซื้อ %d อย่าง · %s", bought, os.date("%H:%M:%S")) else "ส่งคำสั่งซื้อแล้วแต่ของไม่เพิ่ม",
			if bought > 0 then Theme.good else Theme.bad
		)
	end

	-- เปิดกล่อง / ไข่ Robux ที่มีอยู่
	local function openRx()
		lastRxAt = os.clock()
		for _, kind in { "crate", "egg" } do
			if (pAttr("HeldRx") or "") ~= kind then
				fire("BagAction", "holdRx", kind)
			end
			if waitFor(function()
				return pAttr("HeldRx") == kind
			end, 1.2) then
				task.wait(0.4)
				fire("BagAction", "openRx")
				log("good", "เปิด Robux " .. kind)
				rxRow.setStatus("เปิด Robux " .. kind .. " · " .. os.date("%H:%M:%S"), Theme.good)
				return
			end
		end
	end

	startLoop("Rewards", nil, 4, nil, function()
		if config.daily then
			claimDaily()
		end
		if config.groupReward and not groupDone then
			claimGroup()
		end
		if config.quests and not cooling("quests") then
			claimQuests()
		end
		if config.spin and os.clock() - lastSpinAt > SPIN_TIME + 2 and not cooling("spin") then
			doSpin()
		end
		if config.drinkPotions and Potions then
			drinkPotions()
		end
		if config.buyPotions and Potions and Potions.BY_ID and not cooling("buyPotions") then
			buyPotions()
		end
		if GeneralStore and GeneralStore.BY_ID and (config.storePotions or config.spinTickets) and os.clock() - lastStoreAt > 60 then
			storeBuys()
		end
		if config.openRx and os.clock() - lastRxAt > 20 then
			openRx()
		end
	end)

	refreshers.Rewards = function()
		local data, list = questData()
		local lines = {}
		for _, quest in ipairs(list) do
			-- ✓ รับแล้ว · ! รับได้ · • ยังทำอยู่
			local done = num(quest.prog) >= num(quest.goal, math.huge)
			local mark = if quest.claimed
				then string.format("<font color=\"%s\">✓</font>", colorHex(Theme.good))
				elseif done then string.format("<font color=\"%s\">!</font>", colorHex(Theme.accent))
				else string.format("<font color=\"%s\">•</font>", colorHex(Theme.dim))
			local progress = (fmtCash(quest.prog):gsub("^%$", ""))
			local goal = (fmtCash(quest.goal):gsub("^%$", ""))
			table.insert(
				lines,
				string.format(
					"%s  %s  <font face=\"RobotoMono\" color=\"%s\">%s/%s</font>",
					mark,
					escapeRich(tostring(quest.text or quest.key)),
					colorHex(Theme.sub),
					progress,
					goal
				)
			)
		end
		if #lines == 0 then
			table.insert(lines, "ยังไม่มีข้อมูลเควส")
		end
		if data.bonus then
			table.insert(lines, string.format("<font color=\"%s\">โบนัสเควสวันนี้รับแล้ว</font>", colorHex(Theme.sub)))
		end
		local free = SpinWheel ~= nil and num(pAttr("SpinFreeDay")) < SpinWheel.day(workspace:GetServerTimeNow())
		table.insert(lines, "")
		table.insert(lines, kv("SPIN ", string.format("%s · ตั๋ว %d", if free then "หมุนฟรีได้" else "หมุนฟรีแล้ว", num(pAttr("SpinTickets")))))
		table.insert(lines, kv("DAILY", if pAttr("DailyReady") == true then "รับได้" else "รับแล้ว"))
		questCard.Text = table.concat(lines, "\n")
	end
end
setup.rewards()

-- Equip Best ทุก 1 นาที (miner + สัตว์)
startLoop("Equip Best", nil, 60, nil, function()
	if config.equipBest then
		fire("BagAction", "equipBest")
	end
	if config.petEquipBest then
		task.wait(0.5)
		fire("BagAction", "petEquipBest")
	end
end)

---------------------------------------------------------------------
-- 17) AFK: โหมดสบายจัด / กันหลุด / ระบบดูแลตัวเอง / จอ AFK / Discord / วาป / Spectate
---------------------------------------------------------------------
function setup.afk()
	local miscPage = pages.Misc

	-- จอ AFK กับโหมดประหยัดเครื่องใช้สวิตช์ภาพ 3D ร่วมกัน: ปิด 3D ถ้าอย่างใดอย่างหนึ่งต้องการ
	local afkShown = false
	local function apply3d()
		local off = config.lowGfx or (afkShown and config.afkScreen3dOff)
		pcall(function()
			RunService:Set3dRenderingEnabled(not off)
		end)
	end
	local function applyLowGfx(on: boolean)
		apply3d()
		if typeof(setfpscap) == "function" then
			pcall(setfpscap, if on then 15 else 240)
		end
	end
	local setAfkScreen: (boolean, boolean?) -> ()

	-- ส่งเข้า Discord: executor ต้องมีฟังก์ชันส่งข้อมูลออกเน็ต (request) และส่งได้เฉพาะลิงก์ Webhook ของ Discord
	local httpRequest = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)
		or (typeof(http) == "table" and typeof(http.request) == "function" and http.request)
		or nil

	local function validWebhook(url: string): boolean
		return url:match("^https://[%w%.%-]*discord[%w]*%.com/api/webhooks/%d+/[%w%-_]+") ~= nil
	end

	local function postWebhook(payload: { [string]: any }): (boolean, string?)
		if not validWebhook(config.webhookUrl) then
			return false, "ยังไม่ได้ใส่ Webhook URL ของ Discord (หรือรูปแบบลิงก์ไม่ถูก)"
		end
		if not httpRequest then
			return false, "executor นี้ส่งข้อมูลออกเน็ตไม่ได้ (ไม่มีฟังก์ชัน request)"
		end
		local ok, response = pcall(httpRequest, {
			Url = config.webhookUrl,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
		if not ok then
			return false, tostring(response)
		end
		local code = if type(response) == "table" then tonumber(response.StatusCode) else nil
		if code and code >= 300 then
			return false, "Discord ตอบกลับรหัส " .. code
		end
		return true, nil
	end

	local function embed(title: string, description: string, color: Color3, fields: { any }?): { [string]: any }
		return {
			username = "Back Soyer",
			embeds = {
				{
					title = title,
					description = description,
					color = math.floor(color.R * 255) * 65536 + math.floor(color.G * 255) * 256 + math.floor(color.B * 255),
					fields = fields,
					footer = { text = "Back Soyer v" .. VERSION .. " · " .. localPlayer.Name },
					timestamp = DateTime.now():ToIsoDate(),
				},
			},
		}
	end

	local function bagText(): string
		if bag.count and bag.cap then
			return string.format("%d/%d%s", bag.count, bag.cap, if bagFull() then " (เต็ม!)" else "")
		end
		return "-"
	end

	-- ยอดทั้งรอบ AFK (นับรวมตอนหลุด/เข้าเซิร์ฟใหม่)
	local function runText(): string
		local totals = run.totals()
		return string.format(
			"%s ชม. · ได้ %s · miner %d (ใหม่ใน Index %d) · อัพเกรด %d · เข้าเซิร์ฟใหม่ %d ครั้ง",
			fmtTime(os.time() - run.startedAt),
			fmtCash(totals.earned),
			totals.miners,
			totals.indexNew,
			totals.upgrades,
			run.rejoins
		)
	end

	local function summaryPayload(title: string): { [string]: any }
		local minersHave, minersTotal, petsHave, petsTotal, sets = indexProgress()
		local rate = ratePerMinute()
		return embed(title, "Plot " .. tostring(plotId() or "?") .. (if paused then " · ⏸ หยุดอยู่" else ""), Theme.accent, {
			{ name = "💰 เงินตอนนี้", value = fmtCash(cash()), inline = true },
			{ name = "📈 ได้ในรอบนี้", value = "+" .. fmtCash(session.earned), inline = true },
			{ name = "⏱ รายได้", value = fmtCash(rate) .. "/นาที\n" .. fmtCash(rate * 60) .. "/ชม.", inline = true },
			{
				name = "📖 Index",
				value = string.format("Miners %d/%d · Pets %d/%d · โบนัส +%d%%", minersHave, minersTotal, petsHave, petsTotal, sets * 3),
				inline = false,
			},
