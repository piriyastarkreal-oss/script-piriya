local prompts: { [ProximityPrompt]: true } = {}
local locked: { [number]: ProximityPrompt? } = {}

local function matches(prompt: ProximityPrompt, step): boolean
	if prompt.ActionText:lower():find(step.action, 1, true) == nil then
		return false
	end
	return step.object == nil or prompt.ObjectText:lower():find(step.object, 1, true) ~= nil
end

local function trackPrompt(obj: Instance)
	if obj:IsA("ProximityPrompt") then
		prompts[obj] = true
	end
end

for _, obj in workspace:GetDescendants() do
	trackPrompt(obj)
end
connect(workspace.DescendantAdded, trackPrompt)
connect(workspace.DescendantRemoving, function(obj)
	prompts[obj] = nil
	for i, prompt in locked do
		if prompt == obj then
			locked[i] = nil
		end
	end
end)

-- เลือกปุ่มที่ใกล้ตัวที่สุด แล้วล็อกไว้ (กันไปกดของคนอื่น)
local function findNearestPrompt(step): ProximityPrompt?
	local root = getRoot()
	if not root then
		return nil
	end
	local best, bestDist = nil, math.huge
	for prompt in prompts do
		if prompt.Parent and matches(prompt, step) then
			local pos = getPosition(prompt.Parent)
			if pos then
				local dist = (pos - root.Position).Magnitude
				if dist < bestDist then
					best, bestDist = prompt, dist
				end
			end
		end
	end
	return best
end

local function firePrompt(prompt: ProximityPrompt)
	prompt.MaxActivationDistance = math.huge
	prompt.RequiresLineOfSight = false
	if typeof(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, prompt)
		return
	end
	prompt:InputHoldBegin()
	task.wait(prompt.HoldDuration + 0.05)
	prompt:InputHoldEnd()
end

