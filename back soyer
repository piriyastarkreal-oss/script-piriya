				minersHave,
				minersTotal,
				petsHave,
				petsTotal,
				sets * 3,
				bagText()
			)
			local chips = {}
			for _, entry in {
				{ "ฟาร์ม", config.autoStock },
				{ "อัพเกรด", config.autoUpgrade },
				{ "สุ่ม", config.autoRoll or config.autoIndex },
