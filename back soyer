local SHORT_SUFFIX = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local function fmtCash(value: any): string
	local n = math.floor(num(value))
	if Economy and Economy.formatCash and n >= 0 then
		local ok, textValue = pcall(Economy.formatCash, n)
		if ok and type(textValue) == "string" then
			return textValue
		end
	end
	local sign = if n < 0 then "-" else ""
	n = math.abs(n)
	if n < 10000 then
		return sign .. "$" .. tostring(n)
	end
	local index = math.min(math.floor(math.log10(n) / 3), #SHORT_SUFFIX)
	return sign .. "$" .. (string.format("%.1f", n / 10 ^ (index * 3)):gsub("%.0$", "")) .. SHORT_SUFFIX[index]
end

local function fmtTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h, m, s = seconds // 3600, (seconds % 3600) // 60, seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

local function colorHex(color: Color3): string
	return string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
end

local function waitFor(condition: () -> boolean, timeout: number): boolean
	local started = os.clock()
	while os.clock() - started < timeout do
		if condition() then
			return true
		end
		task.wait(0.05)
	end
	return condition()
end

