		{
			label = "ลืมตำแหน่งแท่นขาย",
			callback = function()
				config.sellPadRel = nil
				saveConfig()
				log("warn", "ลบตำแหน่งแท่นขายแล้ว เดินไปเหยียบใหม่ 1 ครั้ง")
			end,
		},
		{
			label = "ทดสอบวาปไปแท่นขาย",
			callback = function()
