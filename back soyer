		BackgroundColor3 = color or Theme.accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = frame,
	}, { corner(2) })
	local label = paragraph({ Text = stripIcon(message), TextSize = 13, TextTransparency = 1, Parent = frame })
	tween(frame, { BackgroundTransparency = 0.04 }, 0.2)
	tween(edge, { Transparency = 0 }, 0.2)
	tween(bar, { BackgroundTransparency = 0 }, 0.2)
	tween(label, { TextTransparency = 0 }, 0.2)
	local frames = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames > 4 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	task.delay(duration or 5, function()
		if not frame.Parent then
			return
		end
		tween(frame, { BackgroundTransparency = 1 }, 0.3)
		tween(edge, { Transparency = 1 }, 0.3)
		tween(bar, { BackgroundTransparency = 1 }, 0.3)
		tween(label, { TextTransparency = 1 }, 0.3)
		task.wait(0.35)
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

