	local indexCard = liveCard(indexPage)
	toggleRow(
		indexPage,
		"autoIndex",
		"Auto Index: miner",
		"miner ตัวไหนยังไม่มีใน Index ซื้อให้ทันทีที่ขึ้นบนแท่นสุ่ม (แม้ต่ำกว่า rarity ขั้นต่ำในแท็บ Roll) · ถ้ามีสิทธิ์ Auto Roll ของเกม จะสั่งให้เกมสุ่มหาตัวที่ขาดโดยตรง วนไปจนครบ"
	)
	stepperRow(indexPage, "indexMaxSpendPct", "ใช้เงินซื้อตัวที่ขาดได้ไม่เกิน", "ต่อตัว เทียบกับเงินที่มี", 10, 100, 10, function(value)
		return value .. "%"
	end)
	toggleRow(
		indexPage,
		"indexPets",
		"Auto Index: สัตว์",
		"วางไข่และซื้อไข่ชนิดที่ยังมีสัตว์ขาดก่อน (ต้องเปิด Auto Hatch และซื้อไข่อัตโนมัติในแท็บ Pets ด้วย)"
	)
	section(
		indexPage,
		"ข้อควรรู้",
		"miner แต่ละ rarity มี 5 ตัว ตัว rarity สูงสุ่มเจอยาก (Exotic ~1%, Celestial ~0.3%) อาจใช้เวลานาน · ตัวที่ขาดแต่เงินยังไม่พอ จะรอเงินได้ถึง 10 นาที (กันเงินไม่ให้ Auto Upgrade ใช้) ถ้านานกว่านั้นจะสุ่มต่อ · ถ้ากระเป๋าเต็มจะซื้อไม่ได้ ให้เปิด Bigger Bag ในแท็บ Upgrades หรือ 'ลบ miner ที่แย่สุด' ในแท็บ Roll · สัตว์ได้จากการฟักไข่เท่านั้น (Pet Shop เปิดที่ Quarry Lv2) ไข่แต่ละชนิดมีสัตว์ 3 ตัว ตัวหายากออก 10%"
	)

	refreshers.Index = function()
		local indexed, indexedPets = indexSets()
		local pool = minerPool()
		local lines = {}
		local minersHave, minersTotal, setsDone = 0, 0, 0
		for _, rarityName in RARITY_NAMES do
			local names = pool[rarityName]
			if names and #names > 0 then
				local have = 0
				local missingNames = {}
				for _, name in names do
					if indexed[name] then
						have += 1
					else
						table.insert(missingNames, minerDisplayName(name))
					end
				end
				minersHave += have
				minersTotal += #names
				if have == #names then
					setsDone += 1
				end
				table.insert(
					lines,
					string.format(
						"<font color=\"%s\"><b>%s</b></font> %d/%d%s",
						colorHex(rarityColor(rarityName)),
						rarityName,
						have,
						#names,
						if have == #names then "  ✅" else "  · ขาด: " .. table.concat(missingNames, ", ")
					)
				)
			end
		end

		local petLines = {}
		local petsHave, petsTotal = 0, 0
		for _, block in (PetCatalog and PetCatalog.BLOCKS) or {} do
			local pets = block.pets or {}
			local have = 0
			for _, pet in pets do
				if indexedPets[pet.id] then
					have += 1
				end
			end
			petsHave += have
			petsTotal += #pets
			if #pets > 0 and have == #pets then
				setsDone += 1
			end
			table.insert(petLines, string.format("%s %d/%d%s", block.oreName or block.key, have, #pets, if #pets > 0 and have == #pets then " ✅" else ""))
		end

		indexCard.Text = string.format(
			"<b>Miners %d/%d · Pets %d/%d · ครบ %d ชุด = โบนัส +%d%%</b>   (เข้า Index ใหม่ในรอบนี้ %d)\n%s\n\n🐾 <b>สัตว์ (ตามชนิดไข่)</b>\n%s",
			minersHave,
			minersTotal,
			petsHave,
			petsTotal,
			setsDone,
			setsDone * 3,
			counters.indexNew,
			if #lines > 0 then table.concat(lines, "\n") else "โหลดรายชื่อ miner ของเกมไม่ได้",
			if #petLines > 0 then table.concat(petLines, " · ") else "โหลดรายชื่อสัตว์ของเกมไม่ได้"
		)
	end
end

---------------------------------------------------------------------
-- 15) PETS: ฟักไข่ / วางไข่ / ซื้อไข่ / ปลดล็อกฟาร์ม
---------------------------------------------------------------------
do
	local petPage = pages.Pets

	section(petPage, "ฟาร์มสัตว์", "ฟาร์มเปิดที่ Quarry Lv2 ไข่ซื้อได้ที่ Pet Shop ในเมือง สัตว์ช่วยเพิ่มรายได้")
	local petCard = liveCard(petPage)
	local hatchRow = toggleRow(petPage, "autoHatch", "Auto Hatch", "ฟักไข่ที่ครบเวลา แล้ววางไข่ที่ดีที่สุดลงตู้ที่ว่างให้")
	local eggRow = toggleRow(petPage, "buyEggs", "ซื้อไข่อัตโนมัติ", "ซื้อไข่ระดับสูงสุดที่ปลดล็อกแล้วและมีของในร้าน")
	stepperRow(petPage, "eggMaxSpendPct", "ใช้เงินซื้อไข่ไม่เกิน", "ต่อฟอง เทียบกับเงินที่มี", 5, 100, 5, function(value)
		return value .. "%"
	end)
	toggleRow(petPage, "petEquipBest", "Equip Best (สัตว์)", "ใส่สัตว์ที่ดีที่สุดให้หลังฟัก และทุก 1 นาที")
	local farmUnlockRow = toggleRow(petPage, "unlockFarm", "ปลดล็อกฟาร์มให้เอง", "เมื่อ Quarry ถึง Lv2 และมีเงินพอ ($5K)")

	local function incubators(farm: Instance?)
		local list = {}
		local folder = farm and farm:FindFirstChild("Incubators")
		if folder then
			for _, model in folder:GetChildren() do
				local base = model:FindFirstChild("Incubator")
				if base and base:IsA("BasePart") then
					table.insert(list, {
						base = base,
						index = base:GetAttribute("Index"),
						egg = base:GetAttribute("Egg") or "",
						doneAt = num(base:GetAttribute("DoneAt")),
					})
				end
			end
		end
		return list
	end

	-- ไข่ชนิดนี้ยังมีสัตว์ที่ไม่มีใน Index ไหม
	local function eggHasMissingPet(eggKey: string, indexedPets: { [string]: boolean }): boolean
		local def = PetCatalog and PetCatalog.BY_KEY and PetCatalog.BY_KEY[eggKey]
		if not (def and def.pets) then
			return false
		end
		for _, pet in def.pets do
			if not indexedPets[pet.id] then
				return true
			end
		end
		return false
	end

	-- ไข่ที่มี: attribute Eggs = {ชื่อไข่: จำนวน} เลือกไข่ที่ยังมีสัตว์ขาดใน Index ก่อน แล้วค่อยระดับสูงสุด
	local function bestOwnedEgg(): string?
		local _, indexedPets = indexSets()
		local best, bestScore = nil, -1
		for key, value in decode(pAttr("Eggs")) do
			local eggKey, count = key, value
			if type(value) == "string" then
				eggKey, count = value, 1
			end
			if type(eggKey) == "string" and num(count) > 0 then
				local def = PetCatalog and PetCatalog.BY_KEY and PetCatalog.BY_KEY[eggKey]
				local score = (def and def.tier) or 0
				if config.indexPets and eggHasMissingPet(eggKey, indexedPets) then
					score += 100
				end
				if score > bestScore then
					best, bestScore = eggKey, score
				end
			end
		end
		return best
	end

	local function petName(id: any): string
		local def = PetCatalog and PetCatalog.BY_ID and PetCatalog.BY_ID[id]
		return (def and def.name) or tostring(id)
	end

	local function hatchCycle()
		local farm = myFarm()
		if not farm then
			hatchRow.setStatus("ยังไม่มีฟาร์ม (เปิดที่ Quarry Lv2)", Theme.sub)
			return
		end
		local now = workspace:GetServerTimeNow()
		local list = incubators(farm)
		if #list == 0 then
			hatchRow.setStatus("ยังไม่มีตู้ฟักไข่", Theme.sub)
			return
		end
		local _, indexedPets = indexSets()
		local busy, empty = 0, 0
		for _, incubator in list do
			if incubator.egg ~= "" and incubator.doneAt <= now then
				local ok, result = invoke("FarmHatch", 8, incubator.index)
				if not (ok and type(result) == "table" and result.ok) then
					withHops("Pets: ฟักไข่", function(hopTo)
						hopTo(CFrame.new(incubator.base.Position + Vector3.new(0, 4, 0)))
						ok, result = invoke("FarmHatch", 8, incubator.index)
					end)
				end
				if ok and type(result) == "table" and result.ok then
					counters.hatched += 1
					local isNew = not indexedPets[result.pet]
					if isNew then
						counters.indexNew += 1
					end
					local newText = if isNew then "  📖 ใหม่ใน Index" else ""
					log("good", "ฟักไข่ได้ " .. petName(result.pet) .. newText)
					toast("🐣 ฟักได้ " .. petName(result.pet) .. newText, Theme.good)
					if isNew then
						alert("🐣 ได้สัตว์ใหม่เข้า Index", petName(result.pet), Theme.good)
					end
					if config.petEquipBest then
						task.delay(1, function()
							fire("BagAction", "petEquipBest")
						end)
					end
				end
			elseif incubator.egg == "" then
				empty += 1
				local egg = bestOwnedEgg()
				local coolKey = "place" .. tostring(incubator.index)
				if egg and not cooling(coolKey) then
					fire("FarmAction", "place", incubator.index, egg)
					local placed = waitFor(function()
						return (incubator.base:GetAttribute("Egg") or "") ~= ""
					end, 1)
					if not placed then
						withHops("Pets: วางไข่", function(hopTo)
							hopTo(CFrame.new(incubator.base.Position + Vector3.new(0, 4, 0)))
							fire("FarmAction", "place", incubator.index, egg)
							placed = waitFor(function()
								return (incubator.base:GetAttribute("Egg") or "") ~= ""
							end, 1.2)
						end)
					end
					if placed then
						log("info", "วางไข่ " .. egg .. " ในตู้ " .. tostring(incubator.index))
					else
						cool(coolKey, 30)
					end
				end
			else
				busy += 1
			end
		end
		hatchRow.setStatus(string.format("ตู้ฟัก %d ตู้ · กำลังฟัก %d · ว่าง %d · ฟักไปแล้ว %d ตัว", #list, busy, empty, counters.hatched))
	end
	startLoop("Auto Hatch", "autoHatch", 3, hatchRow, hatchCycle)

	startLoop("Unlock Farm", "unlockFarm", 15, farmUnlockRow, function()
		local farm = myFarm()
		if not farm then
			return
		end
		-- ฟาร์มที่ยังไม่ได้ซื้อจะมีป้าย ForSale อยู่
		if farm:FindFirstChild("ForSale", true) == nil then
			farmUnlockRow.setStatus("ปลดล็อกฟาร์มแล้ว", Theme.good)
			return
		end
		local price = (PetFarm and PetFarm.UNLOCK_PRICE) or 5000
		if num(pAttr("QuarryLevel")) < 2 then
			farmUnlockRow.setStatus("ต้องการ Quarry Lv2 ก่อน", Theme.sub)
		elseif cash() < price then
			farmUnlockRow.setStatus("รอเงิน " .. fmtCash(price), Theme.sub)
		elseif not cooling("unlockFarm") then
			cool("unlockFarm", 60)
			fire("FarmAction", "unlock")
			if waitFor(function()
				return farm:FindFirstChild("ForSale", true) == nil
			end, 3) then
				log("buy", "ปลดล็อกฟาร์มสัตว์ (" .. fmtCash(price) .. ")")
				toast("🐾 ปลดล็อกฟาร์มสัตว์แล้ว", Theme.good)
			else
				farmUnlockRow.setStatus("ส่งคำขอปลดล็อกแล้วแต่ยังไม่เปลี่ยน จะลองใหม่ใน 1 นาที", Theme.bad)
			end
		end
	end)

	startLoop("Buy Eggs", "buyEggs", 12, eggRow, function()
		if not PetCatalog then
			eggRow.setStatus("โหลดข้อมูลไข่ของเกมไม่ได้", Theme.bad)
			return
		end
		local quarry = num(pAttr("QuarryLevel"))
		if quarry < 2 then
			eggRow.setStatus("Pet Shop เปิดที่ Quarry Lv2", Theme.sub)
			return
		end
		if num(pAttr("EggCount")) >= num(pAttr("EggCap"), PetCatalog.EGG_CAP or 50) then
			eggRow.setStatus("ช่องเก็บไข่เต็ม", Theme.sub)
			return
		end
		local shop = hubProp("PetShop")
		if not shop then
			return
		end
		local stock = decode(shop:GetAttribute("PetStock"))
		local money = cash()
		local _, indexedPets = indexSets()
		local best = nil
		for _, block in PetCatalog.BLOCKS or {} do
			local entry = stock[block.key]
			local left = if type(entry) == "table" then num(entry[1]) else 0
			if left > 0 and PetCatalog.unlocked(block.key, quarry) then
				local price = PetCatalog.price(block.key)
				-- ไข่ที่ยังมีสัตว์ขาดใน Index มาก่อน (เลือกถูกสุด จะได้ฟักได้หลายรอบ) ไม่งั้นเอาระดับสูงสุด
				local forIndex = config.indexPets and eggHasMissingPet(block.key, indexedPets)
				local score = if forIndex then 1000 - block.tier else block.tier
				if price <= money * config.eggMaxSpendPct / 100 and (not best or score > best.score) then
					best = { key = block.key, tier = block.tier, price = price, name = block.name, score = score, forIndex = forIndex }
				end
			end
		end
		if not best then
			eggRow.setStatus("ไม่มีไข่ที่ซื้อได้ตอนนี้ (หมด / แพงเกินที่ตั้งไว้)", Theme.sub)
			return
		end
		withHops("Pets: ซื้อ " .. best.name, function(hopTo)
			hopTo(hubSpot("PetShop", "OpenPetShop"))
			local ok, result = invoke("PetShopBuy", 8, best.key)
			if ok and type(result) == "table" and result.ok then
				counters.eggsBought += 1
				log("buy", string.format("ซื้อ %s (%s)%s", best.name, fmtCash(best.price), if best.forIndex then " เพื่อ Index" else ""))
				eggRow.setStatus("ซื้อ " .. best.name .. " · " .. os.date("%H:%M:%S"), Theme.good)
			end
		end)
	end)

	refreshers.Pets = function()
		local eggs = {}
		for key, value in decode(pAttr("Eggs")) do
			if type(key) == "string" and num(value) > 0 then
				table.insert(eggs, key .. " x" .. math.floor(num(value)))
			end
		end
		local lines = {
			string.format("🥚 ไข่ในกระเป๋า: %s (%d/%d)", if #eggs > 0 then table.concat(eggs, ", ") else "ไม่มี", num(pAttr("EggCount")), num(pAttr("EggCap"), 50)),
			string.format("🐾 สัตว์: %d/%d · ตัวคูณสัตว์ x%s", num(pAttr("PetCount")), num(pAttr("PetCap"), 50), tostring(pAttr("PetMult") or 1)),
		}
		local farm = myFarm()
		if farm then
			local now = workspace:GetServerTimeNow()
			for _, incubator in incubators(farm) do
				local state
				if incubator.egg == "" then
					state = "ว่าง"
				elseif incubator.doneAt <= now then
					state = incubator.egg .. " ฟักได้แล้ว"
				else
					state = incubator.egg .. " อีก " .. fmtTime(incubator.doneAt - now)
				end
				table.insert(lines, "ตู้ " .. tostring(incubator.index) .. ": " .. state)
			end
		else
			table.insert(lines, "ยังไม่มีฟาร์ม (Quarry Lv2)")
		end
		petCard.Text = table.concat(lines, "\n")
	end
end

