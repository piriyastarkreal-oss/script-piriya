	local afkShown = false
	local function apply3d()
		local off = config.lowGfx or (afkShown and config.afkScreen3dOff)
		pcall(function()
			RunService:Set3dRenderingEnabled(not off)
		end)
	end
	local function applyLowGfx(on: boolean)
		apply3d()
		if typeof(setfpscap) == "function" then
			pcall(setfpscap, if on then 15 else 240)
		end
	end
	local setAfkScreen: (boolean, boolean?) -> ()

	-- ส่งเข้า Discord: executor ต้องมีฟังก์ชันส่งข้อมูลออกเน็ต (request) และส่งได้เฉพาะลิงก์ Webhook ของ Discord
	local httpRequest = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)
		or (typeof(http) == "table" and typeof(http.request) == "function" and http.request)
		or nil

	local function validWebhook(url: string): boolean
		return url:match("^https://[%w%.%-]*discord[%w]*%.com/api/webhooks/%d+/[%w%-_]+") ~= nil
	end

	local function postWebhook(payload: { [string]: any }): (boolean, string?)
		if not validWebhook(config.webhookUrl) then
			return false, "ยังไม่ได้ใส่ Webhook URL ของ Discord (หรือรูปแบบลิงก์ไม่ถูก)"
		end
		if not httpRequest then
			return false, "executor นี้ส่งข้อมูลออกเน็ตไม่ได้ (ไม่มีฟังก์ชัน request)"
		end
		local ok, response = pcall(httpRequest, {
			Url = config.webhookUrl,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
		if not ok then
			return false, tostring(response)
		end
		local code = if type(response) == "table" then tonumber(response.StatusCode) else nil
		if code and code >= 300 then
			return false, "Discord ตอบกลับรหัส " .. code
		end
		return true, nil
	end

