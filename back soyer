local function stepperRow(
	page: Instance,
	key: string,
	title: string,
	desc: string?,
	minValue: number,
	maxValue: number,
	step: number | StepLadder,
	format: (number) -> string
)
	local holder = card(page)
	textColumn(holder, UDim.new(1, -138), title, desc)
	local box = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(128, 28),
		BackgroundColor3 = Theme.panel2,
		Parent = holder,
	}, { corner(8) })
	local minus = button({ Text = "−", TextSize = 16, Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Theme.off, Parent = box })
	local plus = button({ Text = "+", TextSize = 16, Position = UDim2.new(1, -28, 0, 0), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Theme.off, Parent = box })
	local valueLabel = text({ Text = "", Font = FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -56, 1, 0), Parent = box })
	local function paint()
		valueLabel.Text = format(config[key])
	end
	local function change(direction: number)
		local current = config[key]
		local stepSize: number = if type(step) == "table" then ladderStep(step, current, direction) else step :: number
		local value = math.floor((current + direction * stepSize) / stepSize + 0.5) * stepSize
		config[key] = math.clamp(value, minValue, maxValue)
		saveConfig()
		paint()
	end
	connect(minus.Activated, function()
		change(-1)
	end)
	connect(plus.Activated, function()
		change(1)
	end)
	paint()
	table.insert(binders, paint)
end

local function cycleRow(page: Instance, key: string, title: string, desc: string?, values: { string }, colorOf: ((string) -> Color3)?)
	local holder = card(page)
	textColumn(holder, UDim.new(1, -168), title, desc)
	local box = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(158, 28),
		BackgroundColor3 = Theme.panel2,
		Parent = holder,
	}, { corner(8) })
	local left = button({ Text = "<", TextSize = 15, Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Theme.off, Parent = box })
	local right = button({ Text = ">", TextSize = 15, Position = UDim2.new(1, -28, 0, 0), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Theme.off, Parent = box })
	local valueLabel = text({ Text = "", Font = FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -56, 1, 0), Parent = box })
	local function paint()
		valueLabel.Text = tostring(config[key])
		valueLabel.TextColor3 = if colorOf then colorOf(config[key]) else Theme.text
	end
	local function shift(delta: number)
		local index = table.find(values, config[key]) or 1
		index = (index - 1 + delta) % #values + 1
		config[key] = values[index]
		saveConfig()
		paint()
	end
	connect(left.Activated, function()
		shift(-1)
	end)
	connect(right.Activated, function()
		shift(1)
	end)
	paint()
	table.insert(binders, paint)
