local function posOf(obj: Instance?): Vector3?
	if not obj then
		return nil
	end
	if obj:IsA("Attachment") then
		return obj.WorldPosition
	elseif obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	return nil
end

