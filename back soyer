					hopTo(pad)
					local onPad = waitFor(function()
						return pAttr("OnSellPad") == true
					end, 1.5)
					log(if onPad then "good" else "bad", if onPad then "ยืนบนแท่นขายได้" else "ยังไม่ติดแท่นขาย ลองเดินไปเหยียบเองแล้วกดใหม่")
					task.wait(0.5)
				end)
			end,
		},
	})

	local lastSell = 0
	local failStreak = { take = 0, sell = 0 }

	local function doSell(hopTo: (CFrame?) -> boolean): string?
		if pAttr("OnSellPad") ~= true then
			local pad = sellPadCFrame()
			if not pad then
				return "หาแท่นขายไม่เจอ: เดินไปเหยียบแท่นขาย 1 ครั้ง"
			end
			hopTo(pad)
			waitFor(function()
				return pAttr("OnSellPad") == true
			end, 1.5)
		end
		if pAttr("OnSellPad") ~= true then
			failStreak.sell += 1
			if failStreak.sell >= 3 then
				cool("sell", 30)
			end
			return "ยืนบนแท่นขายไม่ติด (เดินไปเหยียบเอง 1 ครั้งให้สคริปต์จำ)"
		end
		failStreak.sell = 0
		local _, smelted, value = carryInfo()
		fire("SellSmelted", config.sellMode)
		lastSell = os.clock()
		local sold = waitFor(function()
			local _, left = carryInfo()
			return left < smelted
		end, 1.5)
		if sold then
			counters.sell += 1
			counters.sellCrates += smelted
			local mult = if config.sellMode == "safe" then SAFE_MULT else GAMBLE_EV
			log("good", string.format("ขาย %d กล่อง (%s) ประมาณ %s", smelted, config.sellMode, fmtCash(value * mult)))
			return nil
		end
		return "ส่งคำสั่งขายแล้วแต่ของยังไม่ลด"
	end

	local function farmCycle()
		if not alive() then
			stockRow.setStatus("รอตัวละครเกิด...")
			return
		end
		local smeltModel = myBuilding("Smeltery")
		local prompts = farmPrompts()
		local stockNow = stockAmount(myBuilding("Stock"))
		local outNow = smeltOut(smeltModel)
		local raw, smelted = carryInfo()

		local wantTake = prompts.take ~= nil and (stockNow == nil or stockNow > 0) and not cooling("take")
		local wantSmelt = prompts.smelt ~= nil and (raw > 0 or wantTake)
		local wantCollect = prompts.collect ~= nil and (outNow == nil or outNow > 0) and not cooling("collect")
		local sellDue = os.clock() - lastSell >= config.sellEvery
		local wantSell = sellDue and (smelted > 0 or wantCollect) and not cooling("sell")

		if not (wantTake or wantSmelt or wantCollect or wantSell) then
			stockRow.setStatus("ว่าง: ยังไม่มีของให้ทำ · " .. os.date("%H:%M:%S"), Theme.sub)
			return
		end

		local steps = {}
		local problem = nil
		withHops("Farm: กำลังทำรอบฟาร์ม", function(hopTo)
			if wantTake then
				local _, _, _, before = carryInfo()
				usePrompt(prompts.take, hopTo)
				local ok = waitFor(function()
					local _, _, _, after = carryInfo()
					return after > before
				end, 1)
				if ok then
					counters.take += 1
					failStreak.take = 0
					table.insert(steps, "เก็บ ✓")
				else
					failStreak.take += 1
					if failStreak.take >= 3 then
						cool("take", 10)
						problem = "กด Take All ไม่ติดหลายครั้ง (Stock อาจยังไม่ครบกล่อง หรือเพิ่ม 'รอหลังวาป')"
					end
				end
			end

			local rawNow = carryInfo()
			if rawNow > 0 and prompts.smelt then
				usePrompt(prompts.smelt, hopTo)
				if waitFor(function()
					return (carryInfo()) < rawNow
				end, 1) then
					counters.smelt += 1
					table.insert(steps, "หลอม ✓")
				end
			end

			if prompts.collect and (smeltOut(smeltModel) or 1) > 0 and not cooling("collect") then
				local _, before = carryInfo()
				usePrompt(prompts.collect, hopTo)
				if waitFor(function()
					local _, after = carryInfo()
					return after > before
				end, 1) then
					counters.collect += 1
					table.insert(steps, "เก็บของหลอม ✓")
				elseif smeltOut(smeltModel) == nil then
					cool("collect", 8)
				end
			end

			local _, smeltedNow = carryInfo()
			if smeltedNow > 0 and os.clock() - lastSell >= config.sellEvery and not cooling("sell") then
				local err = doSell(hopTo)
				if err then
					problem = err
				else
					table.insert(steps, "ขาย ✓")
				end
			end
		end)

		if problem then
			stockRow.setStatus("⚠ " .. problem, Theme.bad)
		else
			local summary = if #steps > 0 then table.concat(steps, " · ") else "ไม่มีอะไรเปลี่ยน"
			stockRow.setStatus(summary .. "  ·  " .. os.date("%H:%M:%S"))
		end
	end
	startLoop("Auto Farm", "autoStock", 1, stockRow, farmCycle)

	startLoop("Away Cash", "claimAway", 10, awayRow, function()
		local away = num(pAttr("AwayCash"))
		if away > 0 then
			fire("AwayClaim", "claim")
			log("good", "รับเงินตอนออฟไลน์ " .. fmtCash(away))
			awayRow.setStatus("รับล่าสุด " .. fmtCash(away) .. " · " .. os.date("%H:%M:%S"), Theme.good)
		end
	end)

	refreshers.Farm = function()
		local smeltModel = myBuilding("Smeltery")
		local stock = stockAmount(myBuilding("Stock"))
		local out = smeltOut(smeltModel)
		local raw, smelted, value = carryInfo()
		local queue = if smeltModel then num(smeltModel:GetAttribute("Queue")) else nil
		local busy = smeltModel ~= nil and smeltModel:GetAttribute("Busy") == true
		local padText = if pAttr("OnSellPad") == true
			then string.format("<font color=\"%s\">ยืนอยู่บนแท่น</font>", colorHex(Theme.good))
			elseif config.sellPadRel then "จำตำแหน่งไว้แล้ว"
			else string.format("<font color=\"%s\">ยังไม่รู้ตำแหน่ง (เดินไปเหยียบ 1 ครั้ง)</font>", colorHex(Theme.accent))
		farmOverview.Text = table.concat({
			kv("STOCK  ", if stock == nil then "ไม่พบ" elseif stock > 0 then "มีของ (" .. math.floor(stock) .. ")" else "ว่าง"),
			kv(
				"SMELTER",
				string.format(
					"%s · คิว %s · พร้อมเก็บ %s/%d",
					if smeltModel == nil then "ไม่พบ" elseif busy then "กำลังหลอม" else "ว่าง",
					if queue then tostring(queue) else "-",
					if out then tostring(out) else "-",
					SMELT_OUT_CAP
				)
			),
			kv("CARRY  ", string.format("ดิบ %d · หลอมแล้ว %d (≈ %s)", raw, smelted, fmtCash(value))),
			kv("PAD    ", padText),
			kv(
				"SESSION",
				string.format(
					"เก็บ %d · หลอม %d · เก็บของหลอม %d · ขาย %d ครั้ง (%d กล่อง)",
					counters.take,
					counters.smelt,
					counters.collect,
					counters.sell,
					counters.sellCrates
				)
			),
		}, "\n")
	end
end
