function setup.window()
	-- ปุ่มเปิดหน้าต่างที่ขอบจอซ้าย (ตอนซ่อนอยู่): โลโก้ BS + ชื่อ
	local opener = button({
		Text = "",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(148, 38),
		BackgroundColor3 = Theme.bg,
		Visible = false,
		Parent = gui,
	})
	stroke(Theme.stroke, 1).Parent = opener
	new("Frame", {
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = opener,
	}, {
		corner(7),
		gradient(EMBER, 45),
		text({ Text = "BS", Font = FONT_BRAND, TextSize = 9, TextColor3 = Theme.bg, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }),
	})
	text({ Text = "BACK SOYER", Font = FONT_BRAND, TextSize = 10, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -48, 1, 0), Parent = opener })

	local function setWindowOpen(open: boolean)
		window.Visible = open
		opener.Visible = not open
		config.uiOpen = open
		saveConfig()
	end

	local minimized = false
	connect(chrome.minimize.Activated, function()
		minimized = not minimized
		tween(window, { Size = UDim2.fromOffset(WIN_W, if minimized then 56 else WIN_H) }, 0.2)
	end)
	connect(chrome.close.Activated, function()
		setWindowOpen(false)
		toast("ซ่อนหน้าต่างแล้ว · กด " .. config.uiKey .. " หรือปุ่ม BACK SOYER ที่ขอบจอซ้ายเพื่อเปิด", Theme.info)
	end)
	connect(opener.Activated, function()
		setWindowOpen(true)
	end)
	connect(chrome.pause.Activated, function()
		paused = not paused
		chrome.pause.Text = if paused then "ทำงานต่อ" else "หยุดทั้งหมด"
		chrome.pause.BackgroundColor3 = if paused then Theme.accent else Theme.panel
		chrome.pause.TextColor3 = if paused then Theme.bg else Theme.text
		setActivity(nil)
		log("warn", if paused then "หยุดทุกระบบชั่วคราว" else "ทำงานต่อ")
	end)
	connect(UserInputService.InputBegan, function(input, gameProcessed)
		if not gameProcessed and input.KeyCode.Name == config.uiKey then
			setWindowOpen(not window.Visible)
		end
	end)

	if not config.uiOpen then
		setWindowOpen(false)
	end
end
setup.window()

