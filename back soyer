	local function upgradeBoards(): { Instance }
		local ok, list = pcall(CollectionService.GetTagged, CollectionService, "UpgradeBoard")
		return if ok then list else {}
	end

	-- attribute ที่ป้ายของเกมส่งไปกับ remote (บอกว่าเป็นป้ายของแปลงไหน)
	local BOARD_ID_ATTR: { [string]: string } = { Mine = "Mine", Roll = "Area", Quarry = "Quarry" }
	-- ค่าสเตตัสแต่ละตัวอยู่บนป้ายไหน (ตามโค้ดป้ายของเกม)
	local STAT_BOARD: { [string]: string } = {
		OreValue = "Mine",
		WalkSpeed = "Mine",
		MineSpeed = "Mine",
		RollLuck = "Roll",
		StockCap = "Stock",
		HaulSpeed = "Stock",
		HaulCarry = "Stock",
	}
	local BOARD_KINDS = { "Mine", "Roll", "Quarry", "Stock", "Farm" }

	-- ป้ายนี้ของเราไหม: true = ใช่, false = ของแปลงอื่น, nil = บอกไม่ได้ (ไปดูระยะจากสิ่งก่อสร้างของเราแทน)
	local function boardIsMine(board: Instance, kind: string, plot: string, farm: Instance?): boolean?
		local owner = board:GetAttribute("Owner")
		if type(owner) == "number" and owner > 0 then
			return owner == localPlayer.UserId
		end
		local idAttr = BOARD_ID_ATTR[kind]
		local id = (idAttr and board:GetAttribute(idAttr)) or board:GetAttribute("Plot")
		if id ~= nil and id ~= "" then
			return tostring(id) == plot
		end
		if farm and board:IsDescendantOf(farm) then
			return true
		end
		local parent = board.Parent
		while parent and parent ~= workspace do
			if parent.Name == plot or parent.Name:sub(-#plot - 1) == "_" .. plot then
				return true
			end
			parent = parent.Parent
		end
		return nil
	end

	local function boardAnchor(kind: string): Vector3?
		if kind == "Farm" then
			return posOf(myFarm())
		elseif kind == "Roll" then
			return posOf(myBuilding("RollArea")) or posOf(myBuilding("Stock"))
		end
		return posOf(myBuilding("Stock")) or posOf(myBuilding("Smeltery")) or posOf(myBuilding("Shop"))
	end

	-- ป้ายอัพเกรดของแปลงเรา (จำผลไว้ 5 วิ)
	local boardCache: { [string]: { board: Instance?, at: number } } = {}
	local function myBoard(kind: string): Instance?
		local cached = boardCache[kind]
		if cached and os.clock() - cached.at < 5 and (cached.board == nil or cached.board.Parent ~= nil) then
			return cached.board
		end
		local plotValue = plotId()
		if plotValue == nil then
			return nil
		end
		local plot = tostring(plotValue)
		local farm = if kind == "Farm" then myFarm() else nil
		local anchor = boardAnchor(kind)
		local found: Instance? = nil
		local nearest, nearestDistance = nil, 300
		for _, board in upgradeBoards() do
			if (board:GetAttribute("Kind") or "Mine") == kind then
				local mine = boardIsMine(board, kind, plot, farm)
				if mine == true then
					found = board
					break
				elseif mine == nil and anchor then
					local pos = posOf(board)
					if pos and (pos - anchor).Magnitude < nearestDistance then
						nearest, nearestDistance = board, (pos - anchor).Magnitude
					end
				end
			end
		end
		found = found or nearest
		boardCache[kind] = { board = found, at = os.clock() }
		return found
	end

	-- จุดยืนหน้าป้าย: หน้าจอของป้ายอยู่ด้าน Front ของ part "Face" (แบบเดียวกับที่เกมสร้างหน้าจอ)
	local function boardSpot(board: Instance): CFrame?
		local face = board:FindFirstChild("Face")
		if face and face:IsA("BasePart") then
			return standAt(face, Enum.NormalId.Front, board, 4)
		elseif board:IsA("BasePart") then
			return standAt(board, Enum.NormalId.Front, board, 4)
		end
		local pos = posOf(board)
		return if pos then CFrame.new(pos + Vector3.new(0, 3, 0)) else nil
	end

	-- ประตูในเหมือง: ปุ่ม UNLOCK อยู่ด้าน Front ของ Visual.TunnelBacking
	local function doorSpot(door: Instance): CFrame?
		local visual = door:FindFirstChild("Visual")
		local backing = visual and visual:FindFirstChild("TunnelBacking")
		if backing and backing:IsA("BasePart") then
			return standAt(backing, Enum.NormalId.Front, door, 4)
		end
		local pos = posOf(door)
		return if pos then CFrame.new(pos + Vector3.new(0, 3, 0)) else nil
	end

	-- เลเวลค่าสเตตัส: ป้ายของเกมโชว์ค่าจาก attribute บนป้าย ถ้าไม่มีใช้ของตัวผู้เล่น
	local function statLevel(stat: string, board: Instance?): number
		local value = board and board:GetAttribute("Up_" .. stat)
		if type(value) == "number" then
			return value
		end
		return num(pAttr("Up_" .. stat))
	end

	-- โหมดคุ้มสุด: ซื้อแต่ละอย่างแล้วรายได้เพิ่มกี่ % (ใช้สูตรจากโมดูล Upgrades / Economy / MinerWork ของเกม)
	-- คอขวด: กองแร่รอคนขน (Pile_*) ไม่เคยลดต่ำกว่า 2 รอบขนใน 2 นาที = คนขนไม่ทัน · Stock เกิน 85% = Stock เล็กไป
	local roi = { samples = {} :: { { pile: number, fill: number } }, pile = 0, fill = 0, pileStuck = false, stockFull = false, top = {} :: { any }, topAt = 0 }
	-- { ฟังก์ชันในโมดูล Upgrades, ส่วนที่มีผลกับรายได้จริง }: ขุดเร็วขึ้นช่วยแค่ช่วงขุด (~1/4 ของรอบเดิน-ขุด-เดินกลับ)
	roi.STAT = {
		OreValue = { fn = "oreMult", share = 1 },
		MineSpeed = { fn = "mineMult", share = 0.25 },
		WalkSpeed = { fn = "walkMult", share = 0.3 },
		RollLuck = { fn = "luck", share = 0.3 },
		StockCap = { fn = "stockCap", share = 0.5 },
		HaulSpeed = { fn = "haulMult", share = 0.8 },
		HaulCarry = { fn = "haulCarry", share = 0.8 },
	}

	-- ค่าเลเวลถัดไปเทียบเลเวลนี้ - 1 (Ore Value = 0.03 ทุกเลเวล)
	function roi.ratio(fnName: string, level: number): number
		local fn = Upgrades and Upgrades[fnName]
		if type(fn) ~= "function" then
			return 0.01
		end
		local ok, now, nextValue = pcall(function()
			return fn(level), fn(level + 1)
		end)
		if not ok or type(now) ~= "number" or type(nextValue) ~= "number" or now <= 0 then
			return 0.01
		end
		return math.max(nextValue / now - 1, 0)
	end

	-- เก็บตัวอย่างกองแร่ / Stock ทุก 30 วิ ย้อนหลัง 3 นาที
	function roi.sample()
		local pile = 0
		for name, amount in localPlayer:GetAttributes() do
			if type(amount) == "number" and string.sub(name, 1, 5) == "Pile_" then
				pile += amount
			end
		end
		local fill = 0
		local stockModel = myBuilding("Stock")
		if stockModel then
			local stored = 0
			for _, amount in decode(stockModel:GetAttribute("Stock")) do
				stored += num(amount)
			end
			local cap = num(stockModel:GetAttribute("CrateSize")) * ((Upgrades and Upgrades.STOCK_CRATES) or 54)
			if cap <= 0 and Upgrades and Upgrades.stockCap then
				local ok, result = pcall(Upgrades.stockCap, statLevel("StockCap", myBoard("Stock")))
				cap = if ok then num(result) else 0
			end
			fill = if cap > 0 then stored / cap else 0
		end
		roi.pile, roi.fill = pile, fill
		table.insert(roi.samples, { pile = pile, fill = fill })
		while #roi.samples > 6 do
			table.remove(roi.samples, 1)
		end
		local carry = 10
		if Upgrades and Upgrades.haulCarry then
			local ok, result = pcall(Upgrades.haulCarry, statLevel("HaulCarry", myBoard("Stock")))
			carry = if ok then num(result, carry) else carry
		end
		local lowest, fullest = math.huge, 0
		for _, sample in roi.samples do
			lowest = math.min(lowest, sample.pile)
			fullest = math.max(fullest, sample.fill)
		end
		roi.pileStuck = #roi.samples >= 4 and lowest >= carry * 2
		roi.stockFull = fullest >= 0.85
	end
	startLoop("Upgrade Flow", nil, 30, nil, roi.sample)

	function roi.statGain(stat: string, level: number): number
		local def = roi.STAT[stat]
		if not def then
			return 0
		elseif stat == "RollLuck" and not (config.autoRoll or config.autoIndex) then
			return 0
		elseif (stat == "HaulSpeed" or stat == "HaulCarry") and not roi.pileStuck then
			return 0.002
		elseif stat == "StockCap" and not roi.stockFull then
			return 0.002
		end
		local gain = roi.ratio(def.fn, level) * def.share
		-- คนขนไม่ทันอยู่แล้ว miner ขุดเร็วขึ้นก็แค่ทำให้กองแร่สูงขึ้น
		if roi.pileStuck and (stat == "MineSpeed" or stat == "WalkSpeed") then
			gain *= 0.1
		end
		return gain
	end

	-- ประตูใหม่ = ช่องทำงานเพิ่ม 1 ช่อง: ค่า = แรงตัวสำรองที่ดีสุด (ไม่มีตัวสำรอง = ครึ่งหนึ่งของตัวที่อ่อนสุด ต้องสุ่มซื้อเพิ่ม)
	-- เทียบแรงทั้งทีม · ยังมีประตูว่างอยู่ = ประตูใหม่ยังไม่ช่วย
	function roi.doorGain(): number
		local threshold, _, total, spare = team.summary()
		if threshold == nil or total <= 0 then
			return 0.1
		elseif threshold <= 0 then
			return 0
		end
		return (if spare > 0 then spare else threshold * 0.5) / total
	end

	-- ขยายเหมือง: ประตูปลดล็อกหมดแล้ว = ทางเดียวที่จะได้ประตูเพิ่ม · คนขนแร่ +1 ทุก 2 ชั้น (MinerWork.haulers)
	function roi.mineGain(board: Instance, lockedDoors: number): number
		local level = num(board:GetAttribute("Level"), 1)
		local gain = if lockedDoors == 0 then roi.doorGain() * 0.5 else 0.01
		if roi.pileStuck then
			gain += ((level // 2 + 1) / ((level - 1) // 2 + 1) - 1) * 0.8
		end
		return gain
	end

	-- Quarry: แร่ชนิดใหม่แพงกว่าเดิมกี่ % (คิดครึ่งเดียว เผื่อไม่ได้เปลี่ยนแร่ทุกประตู)
	function roi.quarryGain(board: Instance): number
		local ok, now, nextValue = pcall(function()
			return Economy.oreValue(board:GetAttribute("Ore")), Economy.oreValue(board:GetAttribute("NextOre"))
		end)
		if ok and type(now) == "number" and type(nextValue) == "number" and now > 0 and nextValue > now then
			return math.min(nextValue / now - 1, 1) * 0.5
		end
		return 0.25
	end

	function roi.income(): number
		return math.max(ratePerMinute(), num(pAttr("IncomePerMin")), 30) / 60
	end

	function roi.pct(gain: number?): string
		local value = (gain or 0) * 100
		return if value >= 10 then string.format("+%d%%", math.floor(value + 0.5)) else string.format("+%.1f%%", value)
	end

	function roi.span(seconds: number): string
		if seconds < 90 then
			return math.max(1, math.floor(seconds)) .. " วิ"
		elseif seconds < 90 * 60 then
			return math.floor(seconds / 60 + 0.5) .. " นาที"
		elseif seconds < 48 * 3600 then
			return string.format("%.1f ชม.", seconds / 3600)
		end
		return math.floor(seconds / 86400 + 0.5) .. " วัน"
	end

	-- ซื้อไม่สำเร็จ: พักของชิ้นนั้น 30 วิ ถ้าวาปไปยืนแล้วก็ยังไม่ได้ พักทั้งป้าย 30 วิ
	local failedUpgrades: { [string]: number } = {}
	local failedPlaces: { [any]: number } = {}

	local function usable(item: Candidate): boolean
		local now = os.clock()
		return (failedUpgrades[item.name] or 0) < now and (item.place == nil or (failedPlaces[item.place] or 0) < now)
	end

	-- ป้ายแบบเลเวล (Expand Mine / Upgrade Quarry / Pedestals)
	local function boardCandidate(
		list: { Candidate },
		kind: string,
		levelAttr: string,
		defaultMax: number,
		remoteName: string,
		label: (Instance, number) -> string,
		gainOf: (Instance) -> number
	)
		local board = myBoard(kind)
		local idAttr = BOARD_ID_ATTR[kind]
		if not board or not idAttr or board:GetAttribute("Busy") == true then
			return
		end
		local level = num(board:GetAttribute(levelAttr), 1)
		local max = num(board:GetAttribute("Max"), defaultMax)
		local cost = board:GetAttribute("Cost")
		if level >= max or type(cost) ~= "number" then
			return
		end
		local name = label(board, level)
		table.insert(list, {
			name = name,
			title = name,
			cost = cost,
			gain = gainOf(board),
			big = true,
			place = board,
			spot = function()
				return boardSpot(board)
			end,
			buy = function()
				fire(remoteName, board:GetAttribute(idAttr))
				return waitFor(function()
					return num(board:GetAttribute(levelAttr), 1) > level or board:GetAttribute("Busy") == true
				end, 2)
			end,
		})
	end

	local function upgradeCandidates(): { Candidate }
		local list: { Candidate } = {}

		-- ค่าสเตตัส: เลเวล/ราคาอ่านจากป้าย (ค่าเดียวกับที่ป้ายของเกมโชว์) ถ้าไม่มีใช้สูตรของเกม (Upgrades.cost)
		for _, stat in STAT_ORDER do
			if config["up_" .. stat] then
				local board = myBoard(STAT_BOARD[stat] or "Mine")
				local level = statLevel(stat, board)
				local cost = board and board:GetAttribute("UpCost_" .. stat)
				if type(cost) ~= "number" and Upgrades and Upgrades.cost then
					local ok, value = pcall(Upgrades.cost, stat, level)
					cost = if ok then value else nil
				end
				if type(cost) == "number" and cost < math.huge then
					local title = (STAT_INFO[stat] and STAT_INFO[stat].title) or stat
					table.insert(list, {
						name = string.format("%s Lv.%d", title, level + 1),
						title = title,
						cost = cost,
						gain = roi.statGain(stat, level),
						place = board,
						spot = function()
							return if board then boardSpot(board) else nil
						end,
						buy = function()
							local beforePlayer = num(pAttr("Up_" .. stat))
							local beforeBoard = num(board and board:GetAttribute("Up_" .. stat))
							fire("StatUpgradeRequest", stat)
							return waitFor(function()
								return num(pAttr("Up_" .. stat)) > beforePlayer or num(board and board:GetAttribute("Up_" .. stat)) > beforeBoard
							end, 1.5)
						end,
					})
				end
			end
		end

		-- ประตูในเหมือง: นับประตูที่ยังล็อกและซื้อได้ไว้ด้วย (ใช้ประเมินค่าการขยายเหมือง
		-- ประตูที่เพิ่งซื้อไม่สำเร็จไม่นับ เผื่อเป็นประตูของชั้นที่ยังไม่ได้ขยาย)
		local lockedDoors = 0
		local doorGain = roi.doorGain()
		local plot = plotId()
		local okDoors, doors = pcall(CollectionService.GetTagged, CollectionService, "MineDoor")
		if okDoors and plot ~= nil then
			for _, door in doors do
				if door:GetAttribute("Locked") == true and tostring(door:GetAttribute("Mine")) == tostring(plot) then
					local doorName = "ปลดล็อกประตู " .. tostring(door:GetAttribute("DoorKey"))
					if (failedUpgrades[doorName] or 0) < os.clock() then
						lockedDoors += 1
					end
					if config.upDoors then
						table.insert(list, {
							name = doorName,
							title = doorName,
							cost = num(door:GetAttribute("UnlockCost")),
							gain = doorGain,
							big = true,
							place = door,
							spot = function()
								return doorSpot(door)
							end,
							buy = function()
								fire("DoorUnlockRequest", door:GetAttribute("Mine"), door:GetAttribute("DoorKey"))
								return waitFor(function()
									return door:GetAttribute("Locked") ~= true
								end, 2)
							end,
						})
					end
				end
			end
		end

		if config.upMine then
			boardCandidate(list, "Mine", "Level", 10, "MineUpgradeRequest", function(_, level)
				return string.format("Expand Mine → Floor %d", level + 1)
			end, function(board)
				return roi.mineGain(board, lockedDoors)
			end)
		end
		if config.upQuarry then
			boardCandidate(list, "Quarry", "Level", 10, "QuarryUpgradeRequest", function(board, level)
				return "Upgrade Quarry → " .. tostring(board:GetAttribute("NextOre") or ("Lv." .. (level + 1)))
			end, roi.quarryGain)
		end
		if config.upPedestal then
			boardCandidate(list, "Roll", "Count", 6, "RollAreaRequest", function(_, count)
				return string.format("Pedestal %d → %d", count, count + 1)
			end, function()
				return if config.autoRoll then 0.03 else 0
			end)
		end

		-- อัพเกรดฟาร์ม
		if config.upFarm and PetFarm then
			local board = myBoard("Farm")
			if board then
				for _, key in PetFarm.ORDER or {} do
					local level = num(board:GetAttribute("Up_" .. key))
					local def = PetFarm.DEFS and PetFarm.DEFS[key]
					local max = num(board:GetAttribute("Max_" .. key), def and def.max or 0)
					local cost = board:GetAttribute("UpCost_" .. key)
					if type(cost) ~= "number" and PetFarm.cost then
						local ok, value = pcall(PetFarm.cost, key, level)
						cost = if ok then value else nil
					end
					if level < max and type(cost) == "number" and cost < math.huge then
						local title = "Farm " .. ((def and def.title) or key)
						table.insert(list, {
							name = string.format("%s Lv.%d", title, level + 1),
							title = title,
							cost = cost,
							gain = if config.autoHatch then 0.01 else 0.002,
							place = board,
							spot = function()
								return boardSpot(board)
							end,
							buy = function()
								fire("FarmAction", "upgrade", key)
								return waitFor(function()
									return num(board:GetAttribute("Up_" .. key)) > level
								end, 1.5)
							end,
						})
					end
				end
			end
		end

		-- ร้านทั่วไป (ต้องวาปไปร้าน)
		if GeneralStore and GeneralStore.BY_ID then
			local owned = decode(pAttr("Store"))
			local income = num(pAttr("IncomePerMin"), 30)
			-- กระเป๋า miner ใกล้เต็ม = สุ่มซื้อตัวใหม่ไม่ได้ ช่องเพิ่มมีค่ามาก · ที่เหลือซื้อตอนราคาถูกมากเท่านั้น
			local bagFill = if bag.count and bag.cap and bag.cap > 0 then bag.count / bag.cap else 0
			for _, id in { "BagSpace", "PetSpace", "EggSpace", "SpeedBoots" } do
				local item = GeneralStore.BY_ID[id]
				local have = num(owned[id])
				if config["store_" .. id] and item and (item.max == nil or have < item.max) then
					local ok, price = pcall(GeneralStore.price, item, have, income)
					if ok and type(price) == "number" and price < math.huge then
						table.insert(list, {
							name = string.format("%s %d/%s", item.name or id, have + 1, tostring(item.max or "?")),
							title = item.name or id,
							cost = price,
							gain = if id == "BagSpace" then (if bagFill >= 0.85 then 0.05 else 0.003) elseif id == "SpeedBoots" then 0 else 0.003,
							place = "GeneralStore",
							spot = function()
								return hubSpot("GeneralShop", "OpenStore")
							end,
							buy = function()
								fire("StoreAction", "buy", id)
								return waitFor(function()
									return num(decode(pAttr("Store"))[id]) > have
								end, 2)
							end,
						})
					end
				end
			end
		end

		return list
	end

	-- จัดอันดับโหมดคุ้มสุด: คะแนน = เวลารอเงิน + เวลาคืนทุน (วินาที) น้อยสุดคืออันดับ 1
	-- ของไกลแต่คุ้มมาก (เช่นประตู) ชนะของถูกที่คุ้มน้อยได้เอง และไม่โดนของถูกแย่งเงินไปตลอด
	function roi.rank(list: { Candidate }, spendable: number, income: number): { any }
		local ranked = {}
		for _, item in list do
			local gain = item.gain or 0
			if gain > 0 and usable(item) then
				local wait = math.max(0, item.cost - spendable) / income
				local payback = item.cost / (gain * income)
				table.insert(ranked, { item = item, score = wait + payback, payback = payback, wait = wait })
			end
		end
		table.sort(ranked, function(a, b)
			return a.score < b.score
		end)
		return ranked
	end

	-- เลือกของที่จะซื้อตามโหมด: คืน (ของที่จะซื้อ, ข้อความสถานะ, สี)
	local function pickUpgrade(): (Candidate?, string?, Color3?)
		local money = cash()
		local held = heldCash()
		local spendable = money * (1 - config.reservePct / 100) - held
		if held > 0 and spendable <= 0 then
			return nil, string.format("พักซื้อ: กันเงิน %s ไว้ซื้อ %s เข้า Index", fmtCash(held), moneyHold.label), Theme.info
		end
		local list = upgradeCandidates()
		if #list == 0 then
			return nil, "ไม่มีอะไรให้ซื้อ (ปิดไว้หมด หรือ MAX แล้ว)", Theme.sub
		end
		table.sort(list, function(a, b)
			return a.cost < b.cost
		end)
		if config.upgradeMode == "value" then
			local income = roi.income()
			-- ของราคาไม่ถึง 20 วิของรายได้ ซื้อเลย (ไม่ทำให้ของชิ้นใหญ่ช้าลงเท่าไหร่)
			for _, item in list do
				if item.cost <= income * 20 and item.cost <= spendable and usable(item) then
					return item
				end
			end
			local ranked = roi.rank(list, spendable, income)
			roi.top, roi.topAt = ranked, os.clock()
			local best = ranked[1]
			if not best then
				return nil, "ตอนนี้ไม่มีอะไรที่ซื้อแล้วเพิ่มรายได้ (ที่เหลือจะซื้อตอนราคาถูกมาก)", Theme.sub
			end
			if best.item.cost <= spendable then
				return best.item
			end
			return nil,
				string.format(
					"เก็บเงินรอ %s (%s รายได้ · คืนทุน ~%s) อีก ~%s · %s / %s",
					best.item.name,
					roi.pct(best.item.gain),
					roi.span(best.payback),
					roi.span(best.wait),
					fmtCash(money),
					fmtCash(best.item.cost)
				),
				Theme.info
		end
		if config.upgradeMode == "progress" then
			for _, item in list do
				if item.big and usable(item) then
					if item.cost <= spendable then
						return item
					elseif item.cost <= money * 4 then
						return nil,
							string.format("เก็บเงินรอ %s: %s / %s (%d%%)", item.name, fmtCash(money), fmtCash(item.cost), math.floor(money / math.max(item.cost, 1) * 100)),
							Theme.info
					end
					break
				end
			end
		end
		for _, item in list do
			if item.cost <= spendable and usable(item) then
				return item
			end
		end
		local nextItem = list[1]
		return nil, string.format("รอเงิน: ถัดไป %s (%s)", nextItem.name, fmtCash(nextItem.cost)), Theme.sub
	end

	local nextTripAt = 0

	local function upgradeCycle()
		if not alive() then
			upgradeRow.setStatus("รอตัวละครเกิด...", Theme.sub)
			return
		end
		local target, statusText, statusColor = pickUpgrade()
		if not target then
			upgradeRow.setStatus(statusText or "", statusColor)
			return
		end
		local waitLeft = nextTripAt - os.clock()
		if waitLeft > 0 then
			upgradeRow.setStatus(string.format("ถัดไป %s (%s) · วาปไปซื้อในอีก %d วิ", target.name, fmtCash(target.cost), math.ceil(waitLeft)), Theme.sub)
			return
		end

		-- วาปไปป้ายแล้วซื้อรวดเดียว: ซื้อของถัดไปต่อเลย ถ้าอยู่ป้ายอื่นก็วาปต่อ (ไม่เกิน 10 วิต่อรอบ)
		local bought, spent = 0, 0
		local summary: { [string]: { count: number, cost: number, gain: number, last: string, big: boolean? } } = {}
		local order: { string } = {}
		local problem: string? = nil
		local lastName = ""
		withHops("Upgrades: ซื้อ " .. target.name, function(hopTo)
			-- เลือกใหม่อีกครั้ง เผื่อเงินเปลี่ยนระหว่างรอคิววาปของระบบอื่น
			local current: Candidate? = pickUpgrade()
			local here: any = false
			local placeFails = 0
			local stopAt = os.clock() + 10
			while current and running and not paused and config.autoUpgrade and os.clock() < stopAt do
				local item: Candidate = current
				local justHopped = false
				local noSpot = false
				if item.place ~= here then
					here = item.place
					placeFails = 0
					local spot = item.spot and item.spot()
					if not spot then
						noSpot = true
					elseif not nearPos(spot.Position, 6) then
						justHopped = hopTo(spot)
						if not justHopped then
							problem = "ต้องยืนที่ป้ายถึงจะอัพได้: เปิด 'วาปไปกดแป๊บเดียว' ในแท็บ Farm หรือไปยืนที่ป้ายเอง"
						end
					end
				end
				setActivity("Upgrades: ซื้อ " .. item.name)
				local since = os.clock()
				local ok = item.buy()
				if not ok and justHopped then
					-- เพิ่งวาปมา เซิร์ฟเวอร์อาจยังไม่เห็นตำแหน่งใหม่: รอแป๊บแล้วลองอีกครั้ง
					task.wait(0.4)
					ok = item.buy()
				end
				if ok then
					placeFails = 0
					bought += 1
					spent += item.cost
					counters.upgrades += 1
					local key = item.title or item.name
					local entry = summary[key]
					if not entry then
						entry = { count = 0, cost = 0, gain = 0, last = item.name, big = item.big }
						summary[key] = entry
						table.insert(order, key)
					end
					entry.count += 1
					entry.cost += item.cost
					entry.gain += item.gain or 0
					entry.last = item.name
					lastName = item.name
				else
					failedUpgrades[item.name] = os.clock() + 30
					placeFails += 1
					if item.place ~= nil and (justHopped or placeFails >= 2) then
						failedPlaces[item.place] = os.clock() + 30
					end
					local notice = noticeSince(since)
					problem = string.format(
						"ซื้อ %s ไม่สำเร็จ%s จะลองใหม่ใน 30 วิ",
						item.name,
						if notice then " (เกมแจ้ง: " .. notice .. ")" elseif noSpot then " (หาป้ายไม่เจอ)" else ""
					)
				end
				current = pickUpgrade()
			end
		end)
		nextTripAt = os.clock() + config.upgradeEvery

		for _, key in order do
			local entry = summary[key]
			local gainText = if entry.gain >= 0.001 then " · รายได้ ~" .. roi.pct(entry.gain) else ""
			if entry.count == 1 then
				log("buy", string.format("ซื้อ %s (%s)%s", entry.last, fmtCash(entry.cost), gainText))
			else
				log("buy", string.format("ซื้อ %s %d ครั้ง ถึง %s (รวม %s)%s", key, entry.count, entry.last, fmtCash(entry.cost), gainText))
			end
			if entry.big then
				toast("อัพเกรด " .. entry.last, Theme.info)
				alert("⬆ อัพเกรดใหญ่", entry.last .. " (" .. fmtCash(entry.cost) .. ")" .. gainText, Theme.info)
			end
		end
		if bought > 0 then
			upgradeRow.setStatus(
				string.format("ซื้อ %d อย่าง (รวม %s) ล่าสุด %s · %s%s", bought, fmtCash(spent), lastName, os.date("%H:%M:%S"), if problem then "\n⚠ " .. problem else ""),
				if problem then Theme.accent else Theme.good
			)
		elseif problem then
			upgradeRow.setStatus(problem, Theme.bad)
		end
	end
	startLoop("Auto Upgrade", "autoUpgrade", 1.2, upgradeRow, upgradeCycle)

	setup.grade(upgradePage)

	section(upgradePage, "ตรวจสอบ", "ถ้าอัพไม่ติด กดปุ่มนี้ดูว่าสคริปต์หาป้ายเจอ และยืนถูกที่ไหม (ผลอยู่ในแท็บ Log)")
	buttonRow(upgradePage, {
		{
			label = "ทดสอบวาปไปทุกป้าย",
			callback = function()
				withHops("ทดสอบ: วาปไปป้ายอัพเกรด", function(hopTo)
					for _, kind in BOARD_KINDS do
						boardCache[kind] = nil
						local board = myBoard(kind)
						local spot = board and boardSpot(board)
						if board and spot then
							hopTo(spot)
							log("info", "ป้าย " .. kind .. ": เจอแล้ว (" .. board:GetFullName() .. ")")
							task.wait(1)
						else
							log("warn", "ป้าย " .. kind .. ": หาไม่เจอ" .. (if kind == "Farm" then " (ยังไม่มีฟาร์ม?)" else ""))
						end
					end
				end)
			end,
		},
	})

	refreshers.Upgrades = function()
		local parts = {}
		for _, kind in BOARD_KINDS do
			local found = myBoard(kind) ~= nil
			table.insert(parts, string.format("<font color=\"%s\">●</font> %s", colorHex(if found then Theme.good else Theme.bad), kind))
		end
		local lines = { kv("BOARDS ", table.concat(parts, "   ")) }
		-- 3 อันดับที่คุ้มสุดตอนนี้ (คำนวณใหม่ทุก 3 วิ)
		if config.upgradeMode == "value" then
			if os.clock() - roi.topAt > 3 then
				local spendable = cash() * (1 - config.reservePct / 100) - heldCash()
				roi.top, roi.topAt = roi.rank(upgradeCandidates(), spendable, roi.income()), os.clock()
			end
			for index = 1, 3 do
				local entry = roi.top[index]
				if entry then
					table.insert(
						lines,
						kv(
							"TOP " .. index .. "  ",
							string.format(
								"%s   <font color=\"%s\">%s</font>   คืนทุน %s   <font color=\"%s\">%s</font>",
								escapeRich(entry.item.name),
								colorHex(Theme.good),
								roi.pct(entry.item.gain),
								roi.span(entry.payback),
								colorHex(if entry.wait <= 0 then Theme.good else Theme.dim),
								if entry.wait <= 0 then "ซื้อได้" else "รอเงิน " .. roi.span(entry.wait)
							)
						)
					)
				end
			end
		end
		table.insert(
			lines,
			kv(
				"FLOW   ",
				string.format(
					"กองแร่รอขน %d%s · Stock %d%%%s",
					math.floor(roi.pile),
					if roi.pileStuck then string.format(" <font color=\"%s\">คนขนไม่ทัน</font>", colorHex(Theme.accent)) else "",
					math.floor(roi.fill * 100 + 0.5),
					if roi.stockFull then string.format(" <font color=\"%s\">เกือบเต็ม</font>", colorHex(Theme.accent)) else ""
				)
			)
		)
		table.insert(
			lines,
			kv(
				"SESSION",
				string.format(
					"อัพไปแล้ว %d ครั้ง · สุ่มเกรด %d ครั้ง · วาปไปซื้อ%s",
					counters.upgrades,
					counters.gradeRolls,
					if config.upgradeEvery == 0 then "ทันทีที่มีเงิน" else "ทุก " .. config.upgradeEvery .. " วิ"
				)
			)
		)
		boardCard.Text = table.concat(lines, "\n")
	end
end

-- Auto Grade (อยู่ในแท็บ Upgrades): สุ่มเกรดให้ miner ที่ทำงานอยู่ที่ประตู ด้วยเงินในเกม (ไม่ใช้ Shards)
-- เกมแจ้งไว้ว่าสุ่มแต่ละครั้งเกรดถูกแทนที่และลดลงได้ จึงเริ่มเฉพาะตอนงบพอสุ่มจนได้เป้าหมาย ~95% และหยุดทันทีที่ได้
function setup.grade(page: Instance)
	local grades = team.Grades

	-- โอกาสได้เกรด key ขึ้นไปต่อการสุ่ม 1 ครั้ง (น้ำหนักของการสุ่มด้วยเงิน)
	local function chanceAtLeast(key: string): number
		if not (grades and grades.LIST and grades.RANK) then
			return 0
		end
		local total, hit = 0, 0
		for _, grade in grades.LIST do
			local weight = num(grade.cash)
			total += weight
			if (grades.RANK[grade.key] or 0) >= (grades.RANK[key] or math.huge) then
				hit += weight
			end
		end
		return if total > 0 then hit / total else 0
	end

	local function avgRolls(key: string): string
		local chance = chanceAtLeast(key)
		return if chance > 0 then tostring(math.floor(1 / chance + 0.5)) else "?"
	end

	local function minerName(item: any): string
		local folder = getMinerModels()
		local model = folder and folder:FindFirstChild(tostring(item.id))
		return tostring((model and model:GetAttribute("DisplayName")) or item.id)
	end

	section(
		page,
		"Auto Grade",
		"สุ่มเกรดให้ miner ที่ทำงานอยู่ที่ประตู (ตัวแรงสุดก่อน) ด้วยเงินในเกม · สุ่มแต่ละครั้งเกรดถูกแทนที่และลดลงได้ สคริปต์จึงเริ่มเฉพาะตอนงบพอสุ่มจนได้เป้าหมาย (โอกาส ~95%) และหยุดทันทีที่ได้"
	)
	local gradeRow = toggleRow(page, "autoGrade", "Auto Grade", "ปิดไว้เป็นค่าเริ่มต้น · วาปไปร้าน Worker Grading แป๊บเดียวแล้ววาปกลับ")
	local options = {}
	for _, key in { "B", "A", "S" } do
		table.insert(options, { value = key, label = string.format("%s  x%s", key, tostring(team.gradeMult(key))) })
	end
	choiceRow(
		page,
		"gradeTarget",
		"เกรดเป้าหมาย",
		string.format("ได้เกรดนี้หรือสูงกว่าแล้วหยุด · เฉลี่ยต้องสุ่ม B ~%s ครั้ง · A ~%s ครั้ง · S ~%s ครั้ง", avgRolls("B"), avgRolls("A"), avgRolls("S")),
		options
	)
	stepperRow(page, "gradeMaxSpendPct", "งบต่อรอบ", "ใช้ไม่เกินกี่ % ของเงินที่มี ถ้าไม่พอสุ่มจนได้เป้าหมายจะรอเงินก่อน", 5, 100, 5, function(value)
		return value .. "%"
	end)

	local lastGradeAt = 0

	local function gradeCycle()
		if not (grades and grades.RANK and grades.LIST) then
			gradeRow.setStatus("โหลดข้อมูลเกรดของเกมไม่ได้", Theme.bad)
			return
		elseif pAttr("GradeAuto") == true then
			gradeRow.setStatus("Auto Grade ของเกมกำลังทำงานอยู่ รอให้เสร็จก่อน", Theme.sub)
			return
		elseif not alive() then
			gradeRow.setStatus("รอตัวละครเกิด...", Theme.sub)
			return
		elseif type(bag.list) ~= "table" or bag.at < lastGradeAt then
			-- ต้องเห็นเกรดล่าสุดก่อน ไม่งั้นอาจสุ่มทับตัวที่เพิ่งได้เกรดดี
			fire("BagAction", "sync")
			gradeRow.setStatus("รอข้อมูลกระเป๋า miner...", Theme.sub)
			return
		end
		local target = config.gradeTarget
		local targetRank = grades.RANK[target] or 6

		-- miner ที่ทำงานอยู่ (วางที่ประตู) แรงสุด ที่เกรดยังต่ำกว่าเป้า
		local pick, pickPower = nil, -1
		for _, item in bag.list do
			if type(item) == "table" and item.door ~= nil and item.uid ~= nil and (grades.RANK[item.grade or ""] or 0) < targetRank then
				local power = team.ownedPower(item) or 0
				if power > pickPower then
					pick, pickPower = item, power
				end
			end
		end
		if not pick then
			gradeRow.setStatus(string.format("miner ที่ทำงานอยู่ได้เกรด %s ขึ้นไปครบแล้ว", target), Theme.good)
			return
		end

		-- ราคาสุ่มต่อครั้งตาม tier ของ miner (ค่าเดียวกับที่หน้าร้านโชว์)
		local cost = num(decode(pAttr("GradeCosts"))[team.tierOf(pick) or 1])
		local chance = chanceAtLeast(target)
		if cost <= 0 then
			gradeRow.setStatus("ยังไม่รู้ราคาสุ่มเกรด (เกมยังไม่ส่งราคามา)", Theme.sub)
			return
		elseif chance <= 0 then
			gradeRow.setStatus("เกรด " .. target .. " สุ่มด้วยเงินไม่ได้", Theme.bad)
			return
		end
		local name = minerName(pick)
		local needRolls = math.ceil(math.log(0.05) / math.log(1 - chance))
		local budget = cash() * config.gradeMaxSpendPct / 100 - heldCash()
		local maxRolls = math.floor(budget / cost)
		if maxRolls < needRolls then
			gradeRow.setStatus(
				string.format(
					"รอเงิน: %s → %s ต้องมีงบ ~%s (%d ครั้ง × %s) · งบตอนนี้ %s",
					name,
					target,
					fmtCash(needRolls * cost),
					needRolls,
					fmtCash(cost),
					fmtCash(math.max(budget, 0))
				),
				Theme.sub
			)
			return
		end
		local spot = hubSpot("WorkerShop", "OpenGrading")
		if not spot then
			gradeRow.setStatus("หาร้าน Worker Grading ไม่เจอ", Theme.bad)
			return
		end

		local uid = pick.uid
		local startGrade = pick.grade
		local stopSet = {}
		for _, key in grades.AUTO_STOP or {} do
			stopSet[key] = true
		end
		local rolls, spent = 0, 0
		local finalKey: string? = nil
		local problem: string? = nil
		withHops("Auto Grade: สุ่มเกรด " .. name, function(hopTo)
			local justHopped = false
			if not nearPos(spot.Position, 12) then
				justHopped = hopTo(spot)
				if not justHopped then
					problem = "ต้องยืนที่ร้านถึงจะสุ่มได้: เปิด 'วาปไปกดแป๊บเดียว' ในแท็บ Farm"
					return
				end
			end
			local lastN = decode(pAttr("GradeResult")).n
			local stopAt = os.clock() + 90
			while running and not paused and config.autoGrade and rolls < maxRolls and os.clock() < stopAt do
				if cash() - heldCash() < cost then
					problem = "เงินไม่พอสุ่มต่อ"
					break
				end
				local since = os.clock()
				fire("GradeAction", "grade", uid, false, stopSet)
				local got: string? = nil
				local answered = waitFor(function()
					local result = decode(pAttr("GradeResult"))
					if result.n ~= nil and result.n ~= lastN then
						lastN = result.n
						if tostring(result.uid) == tostring(uid) then
							got = result.key
						end
						return true
					end
					return false
				end, 3)
				if not (answered and got) then
					if justHopped and rolls == 0 then
						-- เพิ่งวาปมา เซิร์ฟเวอร์อาจยังไม่เห็นตำแหน่งใหม่: รอแป๊บแล้วลองอีกครั้ง
						justHopped = false
						task.wait(0.5)
						continue
					end
					local notice = noticeSince(since)
					problem = "เกมไม่ตอบรับการสุ่ม" .. (if notice then " (เกมแจ้ง: " .. notice .. ")" else "")
					break
				end
				rolls += 1
				spent += cost
				counters.gradeRolls += 1
				finalKey = got
				setActivity(string.format("Auto Grade: %s ได้ %s (ครั้งที่ %d)", name, tostring(got), rolls))
				if (grades.RANK[got or ""] or 0) >= targetRank then
					break
				end
				-- รอให้เกมหมุนเกรดเสร็จก่อนกดครั้งถัดไป
				task.wait(num(grades.ROLL_TIME, 0.6) + 0.1)
			end
		end)

		if rolls == 0 then
			if problem then
				gradeRow.setStatus(problem, Theme.bad)
			end
			return
		end
		lastGradeAt = os.clock()
		fire("BagAction", "sync")
		local finalRank = grades.RANK[finalKey or ""] or 0
		local report = string.format("%s: สุ่ม %d ครั้ง (%s) %s → %s", name, rolls, fmtCash(spent), tostring(startGrade or "-"), tostring(finalKey))
		if finalRank >= targetRank then
			log("good", "Auto Grade " .. report)
			toast("ได้เกรด " .. tostring(finalKey) .. " · " .. name, Theme.good)
			alert("⭐ ได้เกรด " .. tostring(finalKey), report, Theme.good)
		else
			log("warn", "Auto Grade " .. report .. " · ยังไม่ถึง " .. target .. " จะสุ่มต่อรอบหน้า")
		end
		gradeRow.setStatus(report .. (if problem then "\n⚠ " .. problem else ""), if finalRank >= targetRank then Theme.good else Theme.accent)
	end
	startLoop("Auto Grade", "autoGrade", 20, gradeRow, gradeCycle)
end
setup.upgrades()

