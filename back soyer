	local function upgradeBoards(): { Instance }
		local ok, list = pcall(CollectionService.GetTagged, CollectionService, "UpgradeBoard")
		return if ok then list else {}
	end

	-- attribute ที่ป้ายของเกมส่งไปกับ remote (บอกว่าเป็นป้ายของแปลงไหน)
	local BOARD_ID_ATTR: { [string]: string } = { Mine = "Mine", Roll = "Area", Quarry = "Quarry" }
	-- ค่าสเตตัสแต่ละตัวอยู่บนป้ายไหน (ตามโค้ดป้ายของเกม)
	local STAT_BOARD: { [string]: string } = {
		OreValue = "Mine",
		WalkSpeed = "Mine",
		MineSpeed = "Mine",
		RollLuck = "Roll",
		StockCap = "Stock",
		HaulSpeed = "Stock",
		HaulCarry = "Stock",
	}
	local BOARD_KINDS = { "Mine", "Roll", "Quarry", "Stock", "Farm" }

	-- ป้ายนี้ของเราไหม: true = ใช่, false = ของแปลงอื่น, nil = บอกไม่ได้ (ไปดูระยะจากสิ่งก่อสร้างของเราแทน)
	local function boardIsMine(board: Instance, kind: string, plot: string, farm: Instance?): boolean?
		local owner = board:GetAttribute("Owner")
		if type(owner) == "number" and owner > 0 then
			return owner == localPlayer.UserId
		end
		local idAttr = BOARD_ID_ATTR[kind]
		local id = (idAttr and board:GetAttribute(idAttr)) or board:GetAttribute("Plot")
		if id ~= nil and id ~= "" then
			return tostring(id) == plot
		end
		if farm and board:IsDescendantOf(farm) then
			return true
		end
		local parent = board.Parent
		while parent and parent ~= workspace do
			if parent.Name == plot or parent.Name:sub(-#plot - 1) == "_" .. plot then
				return true
			end
			parent = parent.Parent
		end
		return nil
	end

	local function boardAnchor(kind: string): Vector3?
		if kind == "Farm" then
			return posOf(myFarm())
		elseif kind == "Roll" then
			return posOf(myBuilding("RollArea")) or posOf(myBuilding("Stock"))
		end
		return posOf(myBuilding("Stock")) or posOf(myBuilding("Smeltery")) or posOf(myBuilding("Shop"))
	end

	-- ป้ายอัพเกรดของแปลงเรา (จำผลไว้ 5 วิ)
	local boardCache: { [string]: { board: Instance?, at: number } } = {}
	local function myBoard(kind: string): Instance?
		local cached = boardCache[kind]
		if cached and os.clock() - cached.at < 5 and (cached.board == nil or cached.board.Parent ~= nil) then
			return cached.board
		end
		local plotValue = plotId()
		if plotValue == nil then
			return nil
		end
		local plot = tostring(plotValue)
		local farm = if kind == "Farm" then myFarm() else nil
		local anchor = boardAnchor(kind)
		local found: Instance? = nil
		local nearest, nearestDistance = nil, 300
		for _, board in upgradeBoards() do
			if (board:GetAttribute("Kind") or "Mine") == kind then
				local mine = boardIsMine(board, kind, plot, farm)
				if mine == true then
					found = board
					break
				elseif mine == nil and anchor then
					local pos = posOf(board)
					if pos and (pos - anchor).Magnitude < nearestDistance then
						nearest, nearestDistance = board, (pos - anchor).Magnitude
					end
				end
			end
		end
		found = found or nearest
		boardCache[kind] = { board = found, at = os.clock() }
		return found
	end

	-- จุดยืนหน้าป้าย: หน้าจอของป้ายอยู่ด้าน Front ของ part "Face" (แบบเดียวกับที่เกมสร้างหน้าจอ)
	local function boardSpot(board: Instance): CFrame?
		local face = board:FindFirstChild("Face")
		if face and face:IsA("BasePart") then
			return standAt(face, Enum.NormalId.Front, board, 4)
		elseif board:IsA("BasePart") then
			return standAt(board, Enum.NormalId.Front, board, 4)
		end
		local pos = posOf(board)
		return if pos then CFrame.new(pos + Vector3.new(0, 3, 0)) else nil
	end

	-- ประตูในเหมือง: ปุ่ม UNLOCK อยู่ด้าน Front ของ Visual.TunnelBacking
	local function doorSpot(door: Instance): CFrame?
		local visual = door:FindFirstChild("Visual")
		local backing = visual and visual:FindFirstChild("TunnelBacking")
		if backing and backing:IsA("BasePart") then
			return standAt(backing, Enum.NormalId.Front, door, 4)
		end
		local pos = posOf(door)
		return if pos then CFrame.new(pos + Vector3.new(0, 3, 0)) else nil
	end

	-- เลเวลค่าสเตตัส: ป้ายของเกมโชว์ค่าจาก attribute บนป้าย ถ้าไม่มีใช้ของตัวผู้เล่น
	local function statLevel(stat: string, board: Instance?): number
		local value = board and board:GetAttribute("Up_" .. stat)
		if type(value) == "number" then
			return value
		end
		return num(pAttr("Up_" .. stat))
	end

	-- ป้ายแบบเลเวล (Expand Mine / Upgrade Quarry / Pedestals)
	local function boardCandidate(list: { Candidate }, kind: string, levelAttr: string, defaultMax: number, remoteName: string, label: (Instance, number) -> string)
		local board = myBoard(kind)
		local idAttr = BOARD_ID_ATTR[kind]
		if not board or not idAttr or board:GetAttribute("Busy") == true then
			return
		end
		local level = num(board:GetAttribute(levelAttr), 1)
		local max = num(board:GetAttribute("Max"), defaultMax)
		local cost = board:GetAttribute("Cost")
		if level >= max or type(cost) ~= "number" then
			return
		end
		local name = label(board, level)
		table.insert(list, {
			name = name,
			title = name,
			cost = cost,
			big = true,
			place = board,
			spot = function()
				return boardSpot(board)
			end,
			buy = function()
				fire(remoteName, board:GetAttribute(idAttr))
				return waitFor(function()
					return num(board:GetAttribute(levelAttr), 1) > level or board:GetAttribute("Busy") == true
				end, 2)
			end,
		})
	end

	local function upgradeCandidates(): { Candidate }
		local list: { Candidate } = {}

		-- ค่าสเตตัส: เลเวล/ราคาอ่านจากป้าย (ค่าเดียวกับที่ป้ายของเกมโชว์) ถ้าไม่มีใช้สูตรของเกม (Upgrades.cost)
		for _, stat in STAT_ORDER do
			if config["up_" .. stat] then
				local board = myBoard(STAT_BOARD[stat] or "Mine")
				local level = statLevel(stat, board)
				local cost = board and board:GetAttribute("UpCost_" .. stat)
				if type(cost) ~= "number" and Upgrades and Upgrades.cost then
					local ok, value = pcall(Upgrades.cost, stat, level)
					cost = if ok then value else nil
				end
				if type(cost) == "number" and cost < math.huge then
					local title = (STAT_INFO[stat] and STAT_INFO[stat].title) or stat
					table.insert(list, {
						name = string.format("%s Lv.%d", title, level + 1),
						title = title,
						cost = cost,
						place = board,
						spot = function()
							return if board then boardSpot(board) else nil
						end,
						buy = function()
							local beforePlayer = num(pAttr("Up_" .. stat))
							local beforeBoard = num(board and board:GetAttribute("Up_" .. stat))
							fire("StatUpgradeRequest", stat)
							return waitFor(function()
								return num(pAttr("Up_" .. stat)) > beforePlayer or num(board and board:GetAttribute("Up_" .. stat)) > beforeBoard
							end, 1.5)
						end,
					})
				end
			end
		end

		if config.upMine then
			boardCandidate(list, "Mine", "Level", 10, "MineUpgradeRequest", function(_, level)
				return string.format("Expand Mine → Floor %d", level + 1)
			end)
		end
		if config.upQuarry then
			boardCandidate(list, "Quarry", "Level", 10, "QuarryUpgradeRequest", function(board, level)
				return "Upgrade Quarry → " .. tostring(board:GetAttribute("NextOre") or ("Lv." .. (level + 1)))
			end)
		end
		if config.upPedestal then
			boardCandidate(list, "Roll", "Count", 6, "RollAreaRequest", function(_, count)
				return string.format("Pedestal %d → %d", count, count + 1)
			end)
		end

		-- ประตูในเหมือง
		if config.upDoors then
			local plot = plotId()
			local ok, doors = pcall(CollectionService.GetTagged, CollectionService, "MineDoor")
			if ok and plot ~= nil then
				for _, door in doors do
					if door:GetAttribute("Locked") == true and tostring(door:GetAttribute("Mine")) == tostring(plot) then
						local doorName = "ปลดล็อกประตู " .. tostring(door:GetAttribute("DoorKey"))
						table.insert(list, {
							name = doorName,
							title = doorName,
							cost = num(door:GetAttribute("UnlockCost")),
							big = true,
							place = door,
							spot = function()
								return doorSpot(door)
							end,
							buy = function()
								fire("DoorUnlockRequest", door:GetAttribute("Mine"), door:GetAttribute("DoorKey"))
								return waitFor(function()
									return door:GetAttribute("Locked") ~= true
								end, 2)
							end,
						})
					end
				end
			end
		end

		-- อัพเกรดฟาร์ม
		if config.upFarm and PetFarm then
			local board = myBoard("Farm")
			if board then
				for _, key in PetFarm.ORDER or {} do
					local level = num(board:GetAttribute("Up_" .. key))
					local def = PetFarm.DEFS and PetFarm.DEFS[key]
					local max = num(board:GetAttribute("Max_" .. key), def and def.max or 0)
					local cost = board:GetAttribute("UpCost_" .. key)
					if type(cost) ~= "number" and PetFarm.cost then
						local ok, value = pcall(PetFarm.cost, key, level)
						cost = if ok then value else nil
					end
					if level < max and type(cost) == "number" and cost < math.huge then
						local title = "Farm " .. ((def and def.title) or key)
						table.insert(list, {
							name = string.format("%s Lv.%d", title, level + 1),
							title = title,
							cost = cost,
							place = board,
							spot = function()
								return boardSpot(board)
							end,
							buy = function()
								fire("FarmAction", "upgrade", key)
								return waitFor(function()
									return num(board:GetAttribute("Up_" .. key)) > level
								end, 1.5)
							end,
						})
					end
				end
			end
		end

		-- ร้านทั่วไป (ต้องวาปไปร้าน)
		if GeneralStore and GeneralStore.BY_ID then
			local owned = decode(pAttr("Store"))
			local income = num(pAttr("IncomePerMin"), 30)
			for _, id in { "BagSpace", "PetSpace", "EggSpace", "SpeedBoots" } do
				local item = GeneralStore.BY_ID[id]
				local have = num(owned[id])
				if config["store_" .. id] and item and (item.max == nil or have < item.max) then
					local ok, price = pcall(GeneralStore.price, item, have, income)
					if ok and type(price) == "number" and price < math.huge then
						table.insert(list, {
							name = string.format("%s %d/%s", item.name or id, have + 1, tostring(item.max or "?")),
							title = item.name or id,
							cost = price,
							place = "GeneralStore",
							spot = function()
								return hubSpot("GeneralShop", "OpenStore")
							end,
							buy = function()
								fire("StoreAction", "buy", id)
								return waitFor(function()
									return num(decode(pAttr("Store"))[id]) > have
								end, 2)
							end,
						})
					end
				end
			end
		end

		return list
	end

	-- ซื้อไม่สำเร็จ: พักของชิ้นนั้น 30 วิ ถ้าวาปไปยืนแล้วก็ยังไม่ได้ พักทั้งป้าย 30 วิ
	local failedUpgrades: { [string]: number } = {}
	local failedPlaces: { [any]: number } = {}

	local function usable(item: Candidate): boolean
		local now = os.clock()
		return (failedUpgrades[item.name] or 0) < now and (item.place == nil or (failedPlaces[item.place] or 0) < now)
	end

	-- เลือกของที่จะซื้อตามโหมด: คืน (ของที่จะซื้อ, ข้อความสถานะ, สี)
	local function pickUpgrade(): (Candidate?, string?, Color3?)
		local money = cash()
		local held = heldCash()
		local spendable = money * (1 - config.reservePct / 100) - held
		if held > 0 and spendable <= 0 then
			return nil, string.format("พักซื้อ: กันเงิน %s ไว้ซื้อ %s เข้า Index", fmtCash(held), moneyHold.label), Theme.info
		end
		local list = upgradeCandidates()
		if #list == 0 then
			return nil, "ไม่มีอะไรให้ซื้อ (ปิดไว้หมด หรือ MAX แล้ว)", Theme.sub
		end
		table.sort(list, function(a, b)
			return a.cost < b.cost
		end)
		if config.upgradeMode == "progress" then
			for _, item in list do
				if item.big and usable(item) then
					if item.cost <= spendable then
						return item
					elseif item.cost <= money * 4 then
						return nil,
							string.format("เก็บเงินรอ %s: %s / %s (%d%%)", item.name, fmtCash(money), fmtCash(item.cost), math.floor(money / math.max(item.cost, 1) * 100)),
							Theme.info
					end
					break
				end
			end
		end
		for _, item in list do
			if item.cost <= spendable and usable(item) then
				return item
			end
		end
		local nextItem = list[1]
		return nil, string.format("รอเงิน: ถัดไป %s (%s)", nextItem.name, fmtCash(nextItem.cost)), Theme.sub
	end

	local nextTripAt = 0

	local function upgradeCycle()
		if not alive() then
			upgradeRow.setStatus("รอตัวละครเกิด...", Theme.sub)
			return
		end
		local target, statusText, statusColor = pickUpgrade()
		if not target then
			upgradeRow.setStatus(statusText or "", statusColor)
			return
		end
		local waitLeft = nextTripAt - os.clock()
		if waitLeft > 0 then
			upgradeRow.setStatus(string.format("ถัดไป %s (%s) · วาปไปซื้อในอีก %d วิ", target.name, fmtCash(target.cost), math.ceil(waitLeft)), Theme.sub)
			return
		end

		-- วาปไปป้ายแล้วซื้อรวดเดียว: ซื้อของถัดไปต่อเลย ถ้าอยู่ป้ายอื่นก็วาปต่อ (ไม่เกิน 10 วิต่อรอบ)
		local bought, spent = 0, 0
		local summary: { [string]: { count: number, cost: number, last: string, big: boolean? } } = {}
		local order: { string } = {}
		local problem: string? = nil
		local lastName = ""
		withHops("Upgrades: ซื้อ " .. target.name, function(hopTo)
			-- เลือกใหม่อีกครั้ง เผื่อเงินเปลี่ยนระหว่างรอคิววาปของระบบอื่น
			local current: Candidate? = pickUpgrade()
			local here: any = false
			local placeFails = 0
			local stopAt = os.clock() + 10
			while current and running and not paused and config.autoUpgrade and os.clock() < stopAt do
				local item: Candidate = current
				local justHopped = false
				local noSpot = false
				if item.place ~= here then
					here = item.place
					placeFails = 0
					local spot = item.spot and item.spot()
					if not spot then
						noSpot = true
					elseif not nearPos(spot.Position, 6) then
						justHopped = hopTo(spot)
						if not justHopped then
							problem = "ต้องยืนที่ป้ายถึงจะอัพได้: เปิด 'วาปไปกดแป๊บเดียว' ในแท็บ Farm หรือไปยืนที่ป้ายเอง"
						end
					end
				end
				setActivity("Upgrades: ซื้อ " .. item.name)
				local since = os.clock()
				local ok = item.buy()
				if not ok and justHopped then
					-- เพิ่งวาปมา เซิร์ฟเวอร์อาจยังไม่เห็นตำแหน่งใหม่: รอแป๊บแล้วลองอีกครั้ง
					task.wait(0.4)
					ok = item.buy()
				end
				if ok then
					placeFails = 0
					bought += 1
					spent += item.cost
					counters.upgrades += 1
					local key = item.title or item.name
					local entry = summary[key]
					if not entry then
						entry = { count = 0, cost = 0, last = item.name, big = item.big }
						summary[key] = entry
						table.insert(order, key)
					end
					entry.count += 1
					entry.cost += item.cost
					entry.last = item.name
					lastName = item.name
				else
					failedUpgrades[item.name] = os.clock() + 30
					placeFails += 1
					if item.place ~= nil and (justHopped or placeFails >= 2) then
						failedPlaces[item.place] = os.clock() + 30
					end
					local notice = noticeSince(since)
					problem = string.format(
						"ซื้อ %s ไม่สำเร็จ%s จะลองใหม่ใน 30 วิ",
						item.name,
						if notice then " (เกมแจ้ง: " .. notice .. ")" elseif noSpot then " (หาป้ายไม่เจอ)" else ""
					)
				end
				current = pickUpgrade()
			end
		end)
		nextTripAt = os.clock() + config.upgradeEvery

		for _, key in order do
			local entry = summary[key]
			if entry.count == 1 then
				log("buy", string.format("ซื้อ %s (%s)", entry.last, fmtCash(entry.cost)))
			else
				log("buy", string.format("ซื้อ %s %d ครั้ง ถึง %s (รวม %s)", key, entry.count, entry.last, fmtCash(entry.cost)))
			end
			if entry.big then
				toast("⬆ " .. entry.last, Theme.info)
				alert("⬆ อัพเกรดใหญ่", entry.last .. " (" .. fmtCash(entry.cost) .. ")", Theme.info)
			end
		end
		if bought > 0 then
			upgradeRow.setStatus(
				string.format("ซื้อ %d อย่าง (รวม %s) ล่าสุด %s · %s%s", bought, fmtCash(spent), lastName, os.date("%H:%M:%S"), if problem then "\n⚠ " .. problem else ""),
				if problem then Theme.accent else Theme.good
			)
		elseif problem then
			upgradeRow.setStatus(problem, Theme.bad)
		end
	end
	startLoop("Auto Upgrade", "autoUpgrade", 1.2, upgradeRow, upgradeCycle)

	section(upgradePage, "ตรวจสอบ", "ถ้าอัพไม่ติด กดปุ่มนี้ดูว่าสคริปต์หาป้ายเจอ และยืนถูกที่ไหม (ผลอยู่ในแท็บ Log)")
	buttonRow(upgradePage, {
		{
			label = "ทดสอบวาปไปทุกป้าย",
			callback = function()
				withHops("ทดสอบ: วาปไปป้ายอัพเกรด", function(hopTo)
					for _, kind in BOARD_KINDS do
						boardCache[kind] = nil
						local board = myBoard(kind)
						local spot = board and boardSpot(board)
						if board and spot then
							hopTo(spot)
							log("info", "ป้าย " .. kind .. ": เจอแล้ว (" .. board:GetFullName() .. ")")
							task.wait(1)
						else
							log("warn", "ป้าย " .. kind .. ": หาไม่เจอ" .. (if kind == "Farm" then " (ยังไม่มีฟาร์ม?)" else ""))
						end
					end
				end)
			end,
		},
	})

	refreshers.Upgrades = function()
		local parts = {}
		for _, kind in BOARD_KINDS do
			table.insert(parts, kind .. (if myBoard(kind) then " ✅" else " ❌"))
		end
		boardCard.Text = string.format(
			"ป้ายของคุณ: %s\nอัพไปแล้วในรอบนี้ %d ครั้ง · วาปไปซื้อ%s",
			table.concat(parts, " · "),
			counters.upgrades,
			if config.upgradeEvery == 0 then "ทันทีที่มีเงิน" else "ทุก " .. config.upgradeEvery .. " วิ"
		)
	end
end

