		BackgroundTransparency = 1,
		LayoutOrder = toastCount,
		Parent = toastHolder,
	}, { corner(10), padding(10, 14, 10, 18) })
	local edge = new("UIStroke", { Color = Theme.stroke, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame })
	local bar = new("Frame", {
		Position = UDim2.fromOffset(-10, 0),
