local remoteFolder = ReplicatedStorage:WaitForChild("RemoteEvents", 10)

local function fireRemote(name: string, ...): boolean
	local remote = remoteFolder and remoteFolder:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireServer(...)
		return true
	end
	return false
end

local function getCash(): number
	return math.floor(tonumber(localPlayer:GetAttribute("Cash")) or 0)
end

local function getRoot(): BasePart?
	local character = localPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getPosition(obj: Instance): Vector3?
	if obj:IsA("Attachment") then
		return obj.WorldPosition
	elseif obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	return nil
end

local function moveTo(cframe: CFrame)
	local root = getRoot()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.Parent:PivotTo(cframe)
	end
end

-- วาปไปทำอะไรแป๊บเดียวแล้ววาปกลับ (ใช้ร่วมกันทุกระบบ ทีละอย่าง กันวาปชนกัน)
local hopBusy = false
local function withHops(fn: ((CFrame) -> ()) -> ())
	while hopBusy do
		task.wait(0.05)
	end
	hopBusy = true
	local origin: CFrame? = nil
	local camera = workspace.CurrentCamera
	local oldCameraType = camera.CameraType

	local function hop(cframe: CFrame)
		local root = getRoot()
		if not (root and QUICK_TP) then
			return
		end
		if not origin then
			origin = root.CFrame
			camera.CameraType = Enum.CameraType.Scriptable -- ล็อกกล้องไว้ที่เดิม
		end
		moveTo(cframe)
		task.wait(HOP_WAIT)
	end

	local ok, err = pcall(fn, hop)
	-- กลับที่เดิมเสมอ แม้ระหว่างทางจะ error
	if origin then
		moveTo(origin)
		camera.CameraType = oldCameraType
	end
	hopBusy = false
	if not ok then
		error(err, 0)
	end
end

-- ยิง event ของปุ่ม GUI ตรง ๆ (getconnections / firesignal ของ executor)
local function clickGuiButton(button: GuiButton): boolean
	if typeof(getconnections) == "function" then
		for _, signal in { button.Activated, button.MouseButton1Click, button.MouseButton1Down, button.MouseButton1Up } do
			local ok, conns = pcall(getconnections, signal)
			if ok and conns and #conns > 0 then
				for _, conn in conns do
					pcall(function()
						conn:Fire()
					end)
				end
				return true
			end
		end
	end
	if typeof(firesignal) == "function" then
		pcall(firesignal, button.MouseButton1Click)
		pcall(firesignal, button.Activated)
		return true
	end
	return false
end

-- ลูปที่ทำงานเฉพาะตอนเปิด
local function startLoop(interval: number, isOn: () -> boolean, step: () -> (), status: TextLabel)
	task.spawn(function()
		while running do
			if isOn() then
				local ok, err = pcall(step)
				if not ok then
					status.Text = "Error: " .. tostring(err)
				end
			end
			task.wait(interval)
		end
	end)
end

