local function startLoop(name: string, key: string?, interval: number, row: Row?, step: () -> ())
	task.spawn(function()
		local lastError = nil
		while running do
			if not paused and (key == nil or config[key]) then
				local ok, err = pcall(step)
				if not ok then
					local message = tostring(err)
					if row then
						row.setStatus("⚠ " .. message, Theme.bad)
					end
					if message ~= lastError then
						log("bad", name .. ": " .. message)
						lastError = message
					end
				else
					lastError = nil
				end
			end
			task.wait(interval)
		end
	end)
end

