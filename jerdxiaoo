local function runAction(title, callback)
    local ok, err = pcall(callback)
    if not ok then
        warn("[JERDDXIAO] " .. tostring(err))
        notify(title, "เกิดข้อผิดพลาด ลองใหม่อีกครั้ง", Theme.Crimson, "!")
    end
end

