    -- เปิดลัคกี้บล็อกในบ้านทุกก้อนที่พร้อม: ไปยืนที่แท่น (เซิร์ฟเช็คระยะ) แล้วเรียก F:OpenLuckyBlock(เลขแท่น)
    local OPEN_ERRORS = { "เกิดข้อผิดพลาด", "ต้องถือไอเทมก่อน", "ไม่มีไอเทมนี้", "rebirth ไม่พอ", "กดเร็วเกินไป", "ยังไม่ถึงเวลาเปิด", "อยู่ไกลแท่นเกินไป" }
    local function openAllBlocks()
        local plot = getOwnPlot()
        if not plot then
            return "ไม่พบ plot ของคุณ"
        end
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        local utils = shared and shared:FindFirstChild("Utils")
        local network = utils and utils:FindFirstChild("Network")
        local remote = network and network:FindFirstChild("F:OpenLuckyBlock")
        if not remote then
            return "ไม่พบรีโมต OpenLuckyBlock ในเกม"
        end
        local blocks = placedLuckyBlocks(plot)
        if #blocks == 0 then
            return "ไม่มีลัคกี้บล็อกวางอยู่ในบ้าน"
        end
        -- เกมจะเปิดบล็อกเฉพาะตอนมือว่าง (ถือของอยู่ = สลับของแทน)
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:UnequipTools()
        end
        local opened, failed, notReady, soonest = 0, 0, 0, nil
        local lastError = nil
        for _, block in ipairs(blocks) do
            if not alive() then
                break
            end
            if block.remaining == nil or block.remaining > 0 then
                notReady = notReady + 1
                if block.remaining then
                    soonest = math.min(soonest or math.huge, block.remaining)
                end
            elseif block.promptPart then
                setStatus("กำลังเปิดบล็อกแท่น " .. block.number, Theme.Gold)
                tweenTo(block.promptPart.Position + Vector3.new(0, 3, 0))
                local ok, success, code = pcall(remote.InvokeServer, remote, tostring(block.number))
                if ok and success then
                    opened = opened + 1
                else
                    failed = failed + 1
                    lastError = ok and (OPEN_ERRORS[tonumber(code)] or "เกิดข้อผิดพลาด") or "เรียกเซิร์ฟไม่สำเร็จ"
                end
                task.wait(0.35)
            else
                failed = failed + 1
            end
        end
        local parts = { "เปิดแล้ว " .. opened .. " ก้อน" }
        if notReady > 0 then
            table.insert(parts, "ยังไม่พร้อม " .. notReady .. (soonest and (" (อีก " .. soonest .. " วิ)") or ""))
        end
        if failed > 0 then
            table.insert(parts, "พลาด " .. failed .. (lastError and (" • " .. lastError) or ""))
        end
        return table.concat(parts, "  •  "), opened > 0
    end

    createActionCard(LuckyGrid, {
        name = "OpenAllBlocksBtn",
        icon = "OP",
        title = "เปิดบล็อกทั้งหมด",
        desc = "เปิดลัคกี้บล็อกในบ้านทุกก้อนที่พร้อม",
        accent = Theme.Gold,
        order = 3,
        callback = function()
            runManual("เปิดบล็อกทั้งหมด", "OP", openAllBlocks)
        end,
    })

    -- ลูปเก็บอัตโนมัติ
    task.spawn(function()
        local lastResult = nil
        while alive() and ScreenGui.Parent do
            if getgenv().AutoHackerActive and not busy then
                busy = true
                local ok, result = pcall(collectOnce, function()
                    return getgenv().AutoHackerActive == true
                end)
                busy = false
                if not ok then
                    warn("[JERDDXIAO] " .. tostring(result))
                    result = "failed"
                end
                if result == "ok" then
                    notify("เก็บ Hacker อัตโนมัติ", RESULT_TEXT.ok, HACKER_COLOR, "LB")
                end
                if result ~= lastResult or result == "ok" then
                    setStatus(result == "none" and "รอ Hacker Lucky Block เกิด..." or RESULT_TEXT[result], result == "ok" and HACKER_COLOR or Theme.Muted)
                end
                lastResult = result
                task.wait(result == "none" and 0.5 or 0.2)
            else
                lastResult = nil
                task.wait(0.3)
            end
        end
    end)

    -- อัปเดตการ์ดจำนวนบล็อก
    task.spawn(function()
        while alive() and ScreenGui.Parent do
            task.wait(0.5)
            pcall(refreshLuckyInfo)
        end
    end)
end

-- ═════════════════════════ ระบบอัปเกรดแท่นใน plot อัตโนมัติ ═════════════════════════
-- แท่นอยู่ใน plot.Podiums (1-10) และ plot.Upgrades (11+) แต่ละแท่นมี NewLevelUp ที่เก็บ Cost / Level (Cost < 0 = ตันแล้ว)
-- อัปเกรดผ่าน Network["F:UpgradeFish"]:InvokeServer(ชื่อแท่น, "single") → (สำเร็จ, รหัสข้อผิดพลาด)
do
    local UP_COLOR = Theme.Gold
    local UPGRADE_DELAY = 0.3 -- เกมกันกดรัวไว้ 0.25 วิ
    local UPGRADE_ERRORS = { "เกิดข้อผิดพลาด", "แท่นนี้ยังไม่ได้วางตัว", "เลเวลตันแล้ว", "เงินไม่พอ" }
    local NOT_ENOUGH_MONEY = 4
    local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
    local busy = false
    local upgradeState = "off"
    local upgradesDone, moneySpent = 0, 0
    local upgradeRemote = nil

    local function money(n)
        if n < 1000 then
            return "$" .. math.floor(n)
        end
        local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
        return string.format("$%.2f%s", n / 10 ^ (tier * 3), SUFFIXES[tier + 1])
    end

    local function getRemote()
        if upgradeRemote and upgradeRemote.Parent then
            return upgradeRemote
        end
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        local utils = shared and shared:FindFirstChild("Utils")
        local network = utils and utils:FindFirstChild("Network")
        upgradeRemote = network and network:FindFirstChild("F:UpgradeFish")
        return upgradeRemote
    end

    local function getOwnPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then
            return nil
        end
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:IsA("Model") and plot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
                return plot
            end
        end
        return nil
    end

    local function listPodiums(plot)
        local list = {}
        local items = plot:FindFirstChild("Items")
        for _, folderName in ipairs({ "Podiums", "Upgrades" }) do
            local folder = plot:FindFirstChild(folderName)
            if folder then
                for _, podium in ipairs(folder:GetChildren()) do
                    local pad = podium:FindFirstChild("NewLevelUp")
                    local cost = pad and tonumber(pad:GetAttribute("Cost"))
                    if tonumber(podium.Name) and cost then
                        table.insert(list, {
                            podium = podium,
                            pad = pad,
                            cost = cost,
                            level = math.max(1, math.floor(tonumber(pad:GetAttribute("Level")) or 1)),
                            item = items and items:FindFirstChild(podium.Name),
                        })
                    end
                end
            end
        end
        return list
    end

    -- แท่นที่มีตัววางอยู่และยังไม่ตัน เรียงตามโหมด (UpgradeMode)
    --   balance = เลเวลต่ำสุดก่อน (ถ้าเท่ากันเอาตัวถูกกว่า) → ทุกตัวขึ้นพร้อมๆ กัน
    --   cheap   = ถูกสุดก่อน
    --   random  = สุ่มลำดับ
    local function upgradable(list)
        local out = {}
        for _, entry in ipairs(list) do
            if entry.item and entry.cost >= 0 then
                table.insert(out, entry)
            end
        end
        local mode = getgenv().UpgradeMode
        if mode == "random" then
            for i = #out, 2, -1 do
                local j = math.random(i)
                out[i], out[j] = out[j], out[i]
            end
        elseif mode == "cheap" then
            table.sort(out, function(a, b)
                return a.cost < b.cost
            end)
        else
            table.sort(out, function(a, b)
                if a.level ~= b.level then
                    return a.level < b.level
                end
                return a.cost < b.cost
            end)
        end
        return out
    end

    local function podiumLabel(entry)
        local name = entry.item and entry.item:GetAttribute("CardItemName")
        return "แท่น " .. entry.podium.Name .. (type(name) == "string" and (" • " .. name) or "")
    end

    local function cashText()
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        local cash = stats and stats:FindFirstChild("Cash")
        return cash and tostring(cash.Value) or "--"
    end

    -- ═════════════════════════ หน้า: อัปเกรด ═════════════════════════
