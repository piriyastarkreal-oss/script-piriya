        corner(button, 8)
        local buttonStroke = stroke(button, HACKER_COLOR:Lerp(WHITE, 0.3), 1, 0.6)
        button.MouseButton1Click:Connect(function()
            getgenv().HackerMinSize = option.rank
            renderSizeButtons()
            pcall(refreshLuckyInfo)
            notify("ขนาดที่จะเก็บ", option.label, HACKER_COLOR, "LB")
            setStatus("เก็บ Hacker: " .. option.label, HACKER_COLOR)
        end)
        table.insert(sizeButtons, { rank = option.rank, button = button, stroke = buttonStroke })
    end
    renderSizeButtons()
    refreshLuckyInfo()

    createSection(LuckyPage, "ระบบอัตโนมัติ", HACKER_COLOR, 4)
    createToggle(LuckyPage, {
        name = "AutoHackerBtn",
        icon = "LB",
        title = "เก็บ Hacker อัตโนมัติ",
        desc = "Tween ไปเก็บทุกก้อนที่ตรงขนาด วนต่อเนื่อง",
