local function studs(v) return string.format("%d สตั๊ด", math.floor(v + 0.5)) end

-- ═════════════════════════ ระบบลัคกี้บล็อก (Tween ไปเก็บ Hacker ด่านสุดท้าย) ═════════════════════════
-- บล็อกเกิดใน workspace.StageCards ชื่อ "Stage14_[Big |Massive ]Hacker Lucky Block" กดเก็บผ่าน PickUpPrompt (เซิร์ฟรับในระยะ 12 สตั๊ด)
do
    local HACKER_NAME = "Hacker Lucky Block"
    local HACKER_COLOR = Theme.Mint
    local SIZE_RANK = { Massive = 3, Big = 2 }
    -- เกมย่อ/ขยายบล็อกให้ด้านยาวสุด = 5.25 x2 (ด่าน 8+) = 10.5 สตั๊ด • Big x1.5 = 15.75 • Massive x2 = 21
    local BIG_MIN_EXTENT, MASSIVE_MIN_EXTENT = 13, 18.5
    local SIZE_LABEL = { "ปกติ", "Big", "Massive" }
    local busy = false

    -- ขนาดจากชื่อ ("Stage14_Big ...") และจากขนาดจริงของโมเดล เอาค่าที่ใหญ่กว่า
    local function blockRank(model)
        local rank = SIZE_RANK[string.match(model.Name, "^Stage%d+_(%a+) ")] or 1
        local ok, extents = pcall(model.GetExtentsSize, model)
        if ok and extents then
            local longest = math.max(extents.X, extents.Y, extents.Z)
            if longest >= MASSIVE_MIN_EXTENT then
                rank = math.max(rank, 3)
            elseif longest >= BIG_MIN_EXTENT then
                rank = math.max(rank, 2)
            end
        end
        return rank
    end

    local function getRoot()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function promptPosition(prompt)
        local holder = prompt.Parent
        if holder:IsA("Attachment") then
            return holder.WorldPosition
        end
        return holder:GetPivot().Position
    end

    local function findHackerBlocks()
        local found = {}
        local folder = workspace:FindFirstChild("StageCards")
        if not folder then
            return found
        end
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and string.find(model.Name, HACKER_NAME, 1, true) then
                local prompt = model:FindFirstChild("PickUpPrompt", true)
                -- บล็อกติวของคนอื่นเก็บไม่ได้
                local tutorialOwner = model:GetAttribute("TutorialLuckyBlock") == true and tonumber(model:GetAttribute("TutorialOwnerUserId"))
                if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled and (not tutorialOwner or tutorialOwner == LocalPlayer.UserId) then
                    table.insert(found, { model = model, prompt = prompt, rank = blockRank(model) })
                end
            end
        end
        return found
    end

    -- กรองเฉพาะขนาดที่เลือกไว้ (HackerMinSize)
    local function wantedBlocks(blocks)
        local minRank = getgenv().HackerMinSize or 1
        local out = {}
        for _, block in ipairs(blocks) do
            if block.rank >= minRank then
                table.insert(out, block)
            end
        end
        return out
    end

    -- เลือกก้อนใหญ่สุดก่อน (Massive > Big > ปกติ) แล้วค่อยดูว่าใกล้สุด
    local function pickBest(blocks, origin)
        local best, bestDist
        for _, block in ipairs(blocks) do
            local dist = (promptPosition(block.prompt) - origin).Magnitude
            if not best or block.rank > best.rank or (block.rank == best.rank and dist < bestDist) then
                best, bestDist = block, dist
            end
        end
        return best, bestDist
    end

    local function getOwnPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then
            return nil
        end
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:IsA("Model") and plot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
                return plot
            end
        end
        return nil
    end

    local function homePosition()
        local plot = getOwnPlot()
        if not plot then
            return nil
        end
        local spawnPart = plot:FindFirstChild("Spawn")
        if spawnPart and spawnPart:IsA("BasePart") then
            return spawnPart.Position + Vector3.new(0, spawnPart.Size.Y / 2 + 3, 0)
        end
        local base = plot:FindFirstChild("Base", true)
        if base and base:IsA("BasePart") then
            return base.Position + Vector3.new(0, base.Size.Y / 2 + 4, 0)
        end
        return plot:GetPivot().Position + Vector3.new(0, 5, 0)
    end

    -- ลัคกี้บล็อกที่วางบนแท่นในบ้าน: plot.Items[เลขแท่น] ที่มี LuckyBlock = true
    -- เปิดได้เมื่อถึงเวลา LuckyBlockOpenAt (เวลาเซิร์ฟ) • แท่น 1-10 อยู่ใน Podiums, 11+ อยู่ใน Upgrades
    local function placedLuckyBlocks(plot)
        local list = {}
        local items = plot:FindFirstChild("Items")
        if not items then
            return list
        end
        local now = workspace:GetServerTimeNow()
        for _, item in ipairs(items:GetChildren()) do
            local number = tonumber(item.Name)
            if number and item:GetAttribute("LuckyBlock") == true then
                local podium
                for _, folderName in ipairs({ number > 10 and "Upgrades" or "Podiums", "Podiums", "Upgrades" }) do
                    local folder = plot:FindFirstChild(folderName)
                    podium = folder and folder:FindFirstChild(item.Name)
                    if podium then
                        break
                    end
                end
                local promptPart = podium and podium:FindFirstChild("Prompt")
                local openAt = tonumber(item:GetAttribute("LuckyBlockOpenAt"))
                table.insert(list, {
                    number = number,
                    promptPart = promptPart and promptPart:IsA("BasePart") and promptPart or nil,
                    remaining = openAt and math.max(0, math.ceil(openAt - now)) or nil,
                })
            end
        end
        table.sort(list, function(a, b)
            return a.number < b.number
        end)
        return list
    end

    -- Tween ตัวละครแบบทะลุกำแพง ความเร็วคงที่ตาม LuckyTweenSpeed (สตั๊ด/วินาที)
    -- โหมดวาป (LuckyInstantWarp) = ย้ายทันที แล้วรอให้ตำแหน่งส่งถึงเซิร์ฟก่อนกดเก็บ
    local function tweenTo(targetPos, shouldContinue)
        local root = getRoot()
        if not root then
            return false
        end
        if getgenv().LuckyInstantWarp then
            if not alive() or (shouldContinue and not shouldContinue()) then
                return false
            end
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(targetPos) * root.CFrame.Rotation
            task.wait(0.15)
            return root.Parent ~= nil
        end
        local char = root.Parent
        local speed = math.max(getgenv().LuckyTweenSpeed or 350, 10)
        local duration = math.max((targetPos - root.Position).Magnitude / speed, 0.05)
        local noclip = RunService.Stepped:Connect(function()
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            root.AssemblyLinearVelocity = Vector3.zero
        end)
        local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            CFrame = CFrame.new(targetPos) * root.CFrame.Rotation,
        })
        tw:Play()
        while tw.PlaybackState == Enum.PlaybackState.Playing do
            if not alive() or not root.Parent or (shouldContinue and not shouldContinue()) then
                tw:Cancel()
                break
            end
            task.wait()
        end
        noclip:Disconnect()
        if root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
        end
        return tw.PlaybackState == Enum.PlaybackState.Completed
    end

    local function triggerPrompt(prompt)
        if fireproximityprompt then
            pcall(fireproximityprompt, prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + 0.1)
            prompt:InputHoldEnd()
        end
    end

    local function goHome()
        local home = homePosition()
        if not home then
            return false
        end
        return tweenTo(home)
    end

    -- คืนผล: "ok" | "none" | "noChar" | "cancel" | "taken" | "failed"
    local function collectOnce(shouldContinue)
        local root = getRoot()
        if not root then
            return "noChar"
        end
        local target = pickBest(wantedBlocks(findHackerBlocks()), root.Position)
        if not target then
            return "none"
        end
        setStatus("กำลังบินไปเก็บ Hacker [" .. SIZE_LABEL[target.rank] .. "]", HACKER_COLOR)
        if not tweenTo(promptPosition(target.prompt) + Vector3.new(0, 2, 0), shouldContinue) then
            return "cancel"
        end
        if not target.model.Parent then
            return "taken"
        end
        triggerPrompt(target.prompt)
        -- รอเซิร์ฟยืนยัน: บล็อกหายจาก StageCards หรือปุ่มเก็บถูกปิด
        local deadline = os.clock() + 2
        local function stillThere()
            return target.model.Parent ~= nil and target.prompt.Parent ~= nil and target.prompt.Enabled
        end
        while os.clock() < deadline and stillThere() do
            task.wait(0.1)
        end
        if stillThere() then
            return "failed"
        end
        if getgenv().HackerReturnHome then
            goHome()
        end
        return "ok"
    end

    local RESULT_TEXT = {
        none = "ยังไม่มี Hacker ขนาดที่เลือกในแมพ",
        noChar = "ไม่พบตัวละคร",
        cancel = "ยกเลิกการบินแล้ว",
        taken = "มีคนเก็บไปก่อนแล้ว",
        failed = "เก็บไม่สำเร็จ • เซิร์ฟไม่ตอบรับ",
        ok = "เก็บ Hacker Lucky Block แล้ว",
        home = "กลับถึงฐานแล้ว",
    }

    -- ═════════════════════════ หน้า: ลัคกี้บล็อก ═════════════════════════
    local LuckyPage = createPage("Lucky", HACKER_COLOR)
    createPageHeader(LuckyPage, "ลัคกี้บล็อก", "บินไปเก็บ Hacker Lucky Block ด่านสุดท้าย แล้วพากลับฐาน", HACKER_COLOR)
    createSection(LuckyPage, "Hacker Lucky Block  •  ด่าน 14", HACKER_COLOR, 1)

    local LuckyInfo = create("Frame", {
        BackgroundColor3 = WHITE,
        BackgroundTransparency = 0.08,
        Size = UDim2.new(1, -10, 0, 68),
        LayoutOrder = 2,
        Parent = LuckyPage,
    })
    corner(LuckyInfo, 12)
    gradient(LuckyInfo, { Theme.Card:Lerp(HACKER_COLOR, 0.12), Theme.Card }, 0)
    stroke(LuckyInfo, HACKER_COLOR, 1, 0.55)
    local luckyChip = iconChip(LuckyInfo, "14", HACKER_COLOR, 42)
    luckyChip.Position = UDim2.fromOffset(12, 13)
    text(LuckyInfo, {
        Position = UDim2.fromOffset(64, 14),
        Size = UDim2.new(1, -180, 0, 18),
        Text = "Hacker ในแมพ",
        TextSize = 13,
    })
    local LuckyDetail = text(LuckyInfo, {
        Position = UDim2.fromOffset(64, 34),
        Size = UDim2.new(1, -76, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = "",
        TextColor3 = Theme.SubText,
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local LuckyPill = text(LuckyInfo, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.fromOffset(0, 20),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 0.8,
        BackgroundColor3 = Theme.Off,
        Font = Enum.Font.GothamBlack,
        Text = "",
        TextSize = 9,
    })
    round(LuckyPill)
    create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = LuckyPill })

    local function refreshLuckyInfo()
        local all = findHackerBlocks()
        local blocks = wantedBlocks(all)
        local root = getRoot()
        local best, dist
        if root then
            best, dist = pickBest(blocks, root.Position)
        end
        if best then
            LuckyDetail.Text = string.format("ตรงเงื่อนไข %d / %d ก้อน   •   เป้าหมาย [%s] ห่าง %s", #blocks, #all, SIZE_LABEL[best.rank], studs(dist))
        elseif #all > 0 then
            LuckyDetail.Text = string.format("มี %d ก้อน แต่เป็นก้อนเล็ก — ข้าม รอก้อนใหญ่", #all)
        else
            LuckyDetail.Text = "ยังไม่เกิด — รอสักครู่ (เกิดใหม่ทุก ~8 วินาที)"
        end
        local pillColor = (busy and Theme.Gold) or (#blocks > 0 and HACKER_COLOR) or Theme.Muted
        LuckyPill.Text = busy and "กำลังเก็บ" or (#blocks > 0 and ("พบ " .. #blocks) or "ไม่พบ")
        LuckyPill.TextColor3 = pillColor:Lerp(WHITE, 0.3)
        LuckyPill.BackgroundColor3 = pillColor
    end
    -- ─────────── ตัวเลือกขนาดที่จะเก็บ ───────────
    local SIZE_OPTIONS = {
        { rank = 1, label = "ทุกขนาด" },
        { rank = 2, label = "Big ขึ้นไป" },
        { rank = 3, label = "Massive เท่านั้น" },
    }
    local SizeCard = create("Frame", {
        BackgroundColor3 = Theme.Card,
        BackgroundTransparency = 0.08,
        Size = UDim2.new(1, -10, 0, 86),
        LayoutOrder = 3,
        Parent = LuckyPage,
    })
    corner(SizeCard, 12)
    stroke(SizeCard, Theme.Stroke, 1, 0.35)
    text(SizeCard, {
        Position = UDim2.fromOffset(14, 9),
        Size = UDim2.new(1, -28, 0, 18),
        Text = "ขนาดที่จะเก็บ",
        TextSize = 13,
    })
    text(SizeCard, {
        Position = UDim2.fromOffset(14, 27),
        Size = UDim2.new(1, -28, 0, 14),
        Font = Enum.Font.Gotham,
        Text = "ก้อนใหญ่ได้ luck มากกว่า • Big x2  •  Massive x4",
        TextColor3 = Theme.SubText,
        TextSize = 10,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local sizeHolder = create("Frame", {
        Position = UDim2.fromOffset(14, 48),
        Size = UDim2.new(1, -28, 0, 28),
        BackgroundTransparency = 1,
        Parent = SizeCard,
    })
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = sizeHolder,
    })
    local sizeButtons = {}
    local function renderSizeButtons()
        local current = getgenv().HackerMinSize or 1
        for _, entry in ipairs(sizeButtons) do
            local on = entry.rank == current
            tween(entry.button, 0.2, {
                BackgroundColor3 = on and HACKER_COLOR or Theme.Off,
                TextColor3 = on and Theme.Bg or Theme.SubText,
            })
