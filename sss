local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- CONFIGURATION & SETTINGS
-- ==========================================
local TWEEN_SPEED = 80 -- ความเร็วในการ Tween (Studs/sec)

-- ลำดับความโหด/ความหายาก (โหดสุด -> รองลงมา)[cite: 1]
local CHARACTER_PRIORITY = {
	-- Tier 1: Zenith[cite: 1]
	["Satoru Gojo (Limitless Eyes)"] = 1,
	
	-- Tier 2: Absolute[cite: 1]
	["Yuuki Konno (Violet Duelist)"] = 2,
	["Monkey D. Luffy - Gear 5 (Luffo Ascended)"] = 3,
	["Yuta Okkotsu (Yutao)"] = 4,
	
	-- Tier 3: Infinite[cite: 1]
	["Yuno Grinberryall (Yunao)"] = 5,
	["Yuji Itadori (Yujo)"] = 6,
	["Yoruichi Shihoin (Yoru)"] = 7,
}

-- ==========================================
-- HELPER FUNCTIONS
-- ==========================================

-- ฟังก์ชันหา Plot ของตัวเองเพื่อใช้เป็นจุดกลับ
local function getOwnPlot()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:IsA("Model") and plot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
			return plot
		end
	end
	return nil
end

-- ฟังก์ชัน Tween แบบย้ายทั้ง Character อย่างปลอดภัย
local function safeTweenCharacter(targetCFrame)
	local character = LocalPlayer.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	
	local hrp = character.HumanoidRootPart
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	local startCFrame = hrp.CFrame
	local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
	local duration = math.max(0.05, distance / TWEEN_SPEED)
	
	if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Physics) end
	hrp.Anchored = true
	
	local cframeValue = Instance.new("CFrameValue")
	cframeValue.Value = startCFrame
	
	local connection
	connection = cframeValue.Changed:Connect(function(newCFrame)
		if character and character.Parent then
			character:PivotTo(newCFrame)
		end
	end)
	
	local tween = TweenService:Create(cframeValue, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Value = targetCFrame
	})
	
	tween:Play()
	tween.Completed:Wait()
	
	connection:Disconnect()
	cframeValue:Destroy()
	hrp.Anchored = false
	if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
end

-- ค้นหาเฉพาะ Hacker Lucky Block ที่อยู่นอก Plot (ในแมปด่าน 14)
local function getSortedHackerBlocksInStage14()
	local blocks = {}
	local ownPlot = getOwnPlot()
	
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("Model") and desc:GetAttribute("LuckyBlock") == true then
			local isInPlot = ownPlot and desc:IsDescendantOf(ownPlot)
			
			if not isInPlot then
				local cardName = desc:GetAttribute("CardItemName") 
					or desc:GetAttribute("CardName") 
					or desc:GetAttribute("ItemName") 
					or desc.Name
				
				local priority = CHARACTER_PRIORITY[cardName] or 999
				
				table.insert(blocks, {
					Model = desc,
					Priority = priority,
					Name = cardName
				})
			end
		end
	end
	
	-- เรียงลำดับจากความโหดสูงสุดไปหาต่ำสุด[cite: 1]
	table.sort(blocks, function(a, b)
		return a.Priority < b.Priority
	end)
	
	return blocks
end

-- ฟังก์ชันกด ProximityPrompt ของบล็อก
local function triggerPrompt(model)
	local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		local origDist = prompt.MaxActivationDistance
		prompt.MaxActivationDistance = 50
		
		task.wait(0.05)
		if typeof(fireproximityprompt) == "function" then
			fireproximityprompt(prompt)
		end
		
		task.wait(0.1)
		prompt.MaxActivationDistance = origDist
	end
end

-- ==========================================
-- MAIN EXECUTION
-- ==========================================
local function startFastFarmStage14()
	print("[Stage 14 Fast Farm] เริ่มต้นค้นหา Hacker Lucky Block ในแมป...")
	
	local ownPlot = getOwnPlot()
	if not ownPlot then
		warn("[Stage 14 Fast Farm] ไม่พบ Plot ของคุณ!")
		return
	end
	
	-- กำหนดจุดกลับ Plot
	local returnCFrame = ownPlot:GetPivot()
	local podiums = ownPlot:FindFirstChild("Podiums")
	if podiums and podiums:FindFirstChild("1") then
		returnCFrame = podiums["1"]:GetPivot() * CFrame.new(0, 3, 0)
	end
	
	local sortedBlocks = getSortedHackerBlocksInStage14()
	print(string.format("[Stage 14 Fast Farm] พบบล็อกในแมปทั้งหมด %d บล็อก", #sortedBlocks))
	
	if #sortedBlocks == 0 then
		warn("[Stage 14 Fast Farm] ไม่พบ Hacker Lucky Block ในด่านเลย!")
		return
	end
	
	-- วนลูป Tween ไปเก็บทีละบล็อกตามความโหด[cite: 1]
	for index, item in ipairs(sortedBlocks) do
		local blockModel = item.Model
		if blockModel and blockModel.Parent then
			print(string.format("[%d/%d] กำลังพุ่งไปเก็บ: %s (Priority: %d)", index, #sortedBlocks, item.Name, item.Priority))
			
			local targetCFrame = blockModel:GetPivot() * CFrame.new(0, 3, 0)
			safeTweenCharacter(targetCFrame)
			
			task.wait(0.1)
			triggerPrompt(blockModel)
			task.wait(0.2)
		end
	end
	
	-- เก็บครบแล้ว Tween วาร์ปกลับ Plot ทันที
	print("[Stage 14 Fast Farm] เก็บครบแล้ว! กำลังวาร์ปกลับ Plot ของคุณ...")
	safeTweenCharacter(returnCFrame)
	print("[Stage 14 Fast Farm] กลับถึง Plot เรียบร้อย!")
end

-- รันสคริปต์
task.spawn(startFastFarmStage14)
